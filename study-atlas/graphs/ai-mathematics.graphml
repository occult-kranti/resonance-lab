key="metadata">{"id": "ai-mathhelm", "title": "MathHelm claim-specific discussion", "parentId": "ai-institutions", "level": 3, "summary": "MathHelm claim-specific discussion is mapped as a distinct question or evidence channel; coverage is limited to the linked selected records.", "coverage": "mapped", "sourceIds": ["ai-src-tao-review"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "ai-mathematics"}</data></node><node id="ai-referee"><data key="title">Correctness/exposition/attribution separation</data><data key="kind">topic</data><data key="domain">ai-mathematics</data><data key="status">reviewed</data><data key="metadata">{"id": "ai-referee", "title": "Correctness/exposition/attribution separation", "parentId": "ai-institutions", "level": 3, "summary": "Correctness/exposition/attribution separation is mapped as a distinct question or evidence channel; coverage is limited to the linked selected records.", "coverage": "reviewed", "sourceIds": ["ai-src-third-pdf", "ai-src-firstproof"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "ai-mathematics"}</data></node><node id="ai-formula-kl"><data key="title">Scalar Gaussian forward-KL risk</data><data key="kind">formula</data><data key="domain">ai-mathematics</data><data key="status">theorem</data><data key="metadata">{"id": "ai-formula-kl", "topicId": "ai-mle-bound", "title": "Scalar Gaussian forward-KL risk", "latex": "E_n=\\frac12[\\psi(n/2)-\\log(n/2)+n/(n-2)-1],\\ n&gt;2", "plain": "The expected predictive log-loss penalty for estimating an unknown Gaussian variance has a finite closed form only above its inverse-moment threshold.", "variables": [{"symbol": "n", "meaning": "IID sample count", "unit": "dimensionless", "kind": "integer"}, {"symbol": "ψ", "meaning": "digamma, derivative of log Gamma", "unit": "dimensionless", "kind": "function"}, {"symbol": "E_n", "meaning": "expected forward Kullback–Leibler divergence in nats", "unit": "dimensionless", "kind": "scalar"}], "conditions": ["True observations IID N(0,v*),v*&gt;0; mean known.", "MLE uses divisor n; forward direction true distribution to fitted distribution; n&gt;2."], "derivation": ["Write X=n vhat/v* as chi-square(n).", "Use KL=.5[log(vhat/v*)+v*/vhat−1].", "E logX=ψ(n/2)+log2 and E(1/X)=1/(n−2)."], "workedExample": {"inputs": {"n": [4, 6]}, "steps": ["At4, ψ(2)=1−EulerGamma.", "At6, ψ(3)=1.5−EulerGamma."], "result": "E4≈0.3648185773; E6≈0.1620860232.", "units": "dimensionless mathematical convention"}, "limitingCases": ["n≤2 gives infinite forward risk.", "E_n→0 as n→∞ under correct specification."], "pitfalls": ["Reverse KL is a different expectation.", "A two-point calculation illustrates but does not prove all-n monotonicity."], "sourceIds": ["ai-src-mle-paper"], "status": "theorem", "kind": "formula", "domain": "ai-mathematics"}</data></node><node id="ai-formula-score"><data key="title">Finite benchmark scoring convention</data><data key="kind">formula</data><data key="domain">ai-mathematics</data><data key="status">established-model</data><data key="metadata">{"id": "ai-formula-score", "topicId": "ai-batch3", "title": "Finite benchmark scoring convention", "latex": "N_{\\mathrm{correct}}=\\sum_{j=1}^{10}{\\bf1}(\\bar C_j\\ge0.5)", "plain": "The reported count applies a threshold to averaged referee scores, not a trusted-kernel decision.", "variables": [{"symbol": "Cbar_j", "meaning": "mean correctness grade for submissionj", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "j", "meaning": "problem index", "unit": "dimensionless", "kind": "index"}, {"symbol": "1", "meaning": "indicator of a condition", "unit": "dimensionless", "kind": "function"}], "conditions": ["Use First ProofBatch3 rubric and ten tasks.", "Missing submissions countzero; threshold.5."], "derivation": ["Read each mean grade inTable2.", "Apply≥.5 and sum indicators."], "workedExample": {"inputs": {"Siege": [1, 0.5, 0, 0, 1, 0, 0, 0, 0, 0]}, "steps": ["Three values meet threshold.", "Two are1 and one is.5."], "result": "3/10 under the published threshold.", "units": "dimensionless mathematical convention"}, "limitingCases": ["All abstentions producezero.", "A score.5 is counted despite incomplete confidence."], "pitfalls": ["Do not read3/10 as three fully machine-certified proofs.", "These tasks are not a random sample of all mathematics.", "Under the stricter mean-grade-equals1 convention, Siege has2/10; that alternate count is not the report’s published total."], "sourceIds": ["ai-src-third-pdf"], "status": "established-model", "kind": "formula", "domain": "ai-mathematics"}</data></node><node id="ai-formula-permanent"><data key="title">Permanent definition</data><data key="kind">formula</data><data key="domain">ai-mathematics</data><data key="status">theorem</data><data key="metadata">{"id": "ai-formula-permanent", "topicId": "ai-permanent", "title": "Permanent definition", "latex": "\\operatorname{perm}(A)=\\sum_{\\sigma\\in S_n}\\prod_{i=1}^n a_{i,\\sigma(i)}", "plain": "Sum one product per permutation, without determinant signs.", "variables": [{"symbol": "A", "meaning": "square matrix over a commutative field", "unit": "algebraic convention", "kind": "matrix"}, {"symbol": "S_n", "meaning": "permutations of n indices", "unit": "dimensionless", "kind": "set"}, {"symbol": "a_ij", "meaning": "matrix entry", "unit": "algebraic convention", "kind": "scalar"}], "conditions": ["Square n×n matrix; a commutative coefficient field."], "derivation": ["Each permutation chooses one entry from every row and column.", "All chosen products are added with coefficient+1."], "workedExample": {"inputs": {"A": [[1, 2], [3, 4]]}, "steps": ["Identity permutation contributes4.", "Swap contributes6."], "result": "perm(A)=10, whereas det(A)=−2.", "units": "dimensionless mathematical convention"}, "limitingCases": ["For1×1, permanent equals its entry.", "Diagonal matrices give the product of diagonal entries."], "pitfalls": ["Definition does not establish any claimed circuit lower bound.", "Arithmetic model and coefficient field matter for complexity."], "sourceIds": ["ai-src-ten-paper"], "status": "theorem", "kind": "formula", "domain": "ai-mathematics"}</data></node><node id="ai-formula-light"><data key="title">ε-light set definition</data><data key="kind">formula</data><data key="domain">ai-mathematics</data><data key="status">theorem</data><data key="metadata">{"id": "ai-formula-light", "topicId": "ai-firstproof", "title": "ε-light set definition", "latex": "L_S\\preceq\\varepsilon L\\iff z^\\top(\\varepsilon L-L_S)z\\ge0\\ \\forall z", "plain": "Every quadratic energy of induced edges is bounded by ε times the original graph energy.", "variables": [{"symbol": "L", "meaning": "graph Laplacian", "unit": "dimensionless", "kind": "matrix"}, {"symbol": "L_S", "meaning": "Laplacian retaining only edges withinS", "unit": "dimensionless", "kind": "matrix"}, {"symbol": "ε", "meaning": "comparison parameter in(0,1)", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "z", "meaning": "real vertex potential vector", "unit": "dimensionless", "kind": "vector"}], "conditions": ["Finite undirected graph and compatible nonnegative edge weights.", "PSD order refers to all real vectors, not entrywise inequalities."], "derivation": ["Laplacian energy is sum over edges of w_uv(z_u−z_v)².", "Subtract induced-edge energy from ε times total."], "workedExample": {"inputs": {"graph": "one edge between2vertices", "ε": 0.5, "S": "one vertex"}, "steps": ["Induced graph has no edges, soL_S=0.", "εL is PSD."], "result": "SingletonS is ε-light; both vertices are not forε&lt;1.", "units": "dimensionless mathematical convention"}, "limitingCases": ["EmptyS always passes.", "Atε=1, allV passes."], "pitfalls": ["Checking one test vector is insufficient.", "This example does not prove the universal large-subset theorem."], "sourceIds": ["ai-src-first-comments"], "status": "theorem", "kind": "formula", "domain": "ai-mathematics"}</data></node><node id="ai-src-oa-discovery"><data key="title">How GPT-5 helped mathematician Ernest Ryu solve a 40-year-old open problem</data><data key="kind">source</data><data key="domain">ai-mathematics</data><data key="status">selected-text</data><data key="metadata">{"id": "ai-src-oa-discovery", "title": "How GPT-5 helped mathematician Ernest Ryu solve a 40-year-old open problem", "url": "https://openai.com/index/gpt-5-mathematical-discovery/", "authors": "OpenAI", "year": 2025, "version": "Captured current page; exact byte identity retained", "kind": "source", "status": "selected-text", "readDepth": "Selected sections read; no comprehensive proof audit.", "sectionsRead": ["Dated November 24 2025 article; problem, turning point, attribution and verification"], "claim": "Human-directed GPT-5 exploration helped Ryu develop a point-convergence proof; the article explicitly says a decisive model suggestion was incorrect as written.", "limitations": "Provider case study; research status and exact theorem must be checked in the paper.", "passageKind": "research-note", "note": "Human-directed GPT-5 exploration helped Ryu develop a point-convergence proof; the article explicitly says a decisive model suggestion was incorrect as written.", "capture": "docs/field-atlas/sources/ai-mathematics/oa-discovery.html", "sha256": "c65baf5c840aec47854d796b16bd3568aeaa9d9317bb03a6c2aa61e851d4c22f", "retrievedAt": "2026-11-25T06:25:36.626223+00:00", "domain": "ai-mathematics", "recordKind": "official-announcement", "sourceKind": "official-announcement"}</data></node><node id="ai-src-ryu-paper"><data key="title">Point convergence of Nesterov’s accelerated gradient method: an AI-assisted proof</data><data key="kind">source</data><data key="domain">ai-mathematics</data><data key="status">selected-text</data><data key="metadata">{"id": "ai-src-ryu-paper", "title": "Point convergence of Nesterov’s accelerated gradient method: an AI-assisted proof", "url": "https://arxiv.org/pdf/2510.23513", "authors": ["Uijeong Jang", "Ernest K. Ryu"], "year": 2026, "version": "arXiv:2510.23513v2, 19 January 2026", "kind": "source", "status": "selected-text", "readDepth": "Selected sections read; no comprehensive proof audit.", "sectionsRead": ["Abstract; introduction 1.1–1.4; continuous-time Lemma 2.1 and Theorem 2.2; point-convergence statement"], "claim": "Claims point convergence of classical accelerated gradient; identifies AI assistance and concurrent research.", "limitations": "Selected proof steps read, not the complete discrete proof; no independent formal certificate run.", "passageKind": "research-note", "note": "Claims point convergence of classical accelerated gradient; identifies AI assistance and concurrent research.", "capture": "docs/field-atlas/sources/ai-mathematics/ryu-paper.pdf", "sha256": "31dafeda57a8b0f933fbadefe20d32543ca36ea176292dfaf240d179f3b273f0", "retrievedAt": "2026-11-25T06:26:09.650027+00:00", "domain": "ai-mathematics", "recordKind": "preprint", "sourceKind": "preprint"}</data></node><node id="ai-src-oa-52"><data key="title">Advancing science and math with GPT-5.2</data><data key="kind">source</data><data key="domain">ai-mathematics</data><data key="status">selected-text</data><data key="metadata">{"id": "ai-src-oa-52", "title": "Advancing science and math with GPT-5.2", "url": "https://openai.com/index/gpt-5-2-for-science-and-math/", "authors": "OpenAI", "year": 2025, "version": "Captured current page; exact byte identity retained", "kind": "source", "status": "selected-text", "readDepth": "Selected sections read; no comprehensive proof audit.", "sectionsRead": ["December 11 2025 benchmark protocol and learning-curve case study"], "claim": "Reports 40.3% FrontierMath Tiers1–3 with Python and maximum effort, separately from a learning-curve result.", "limitations": "Company evaluation and contribution narrative; not an independent theorem verdict.", "passageKind": "research-note", "note": "Reports 40.3% FrontierMath Tiers1–3 with Python and maximum effort, separately from a learning-curve result.", "capture": "docs/field-atlas/sources/ai-mathematics/oa-52.html", "sha256": "b19cdc68a3c60e8b4456b93a988875ad60ce15522bcf92a67d0846ead1d42175", "retrievedAt": "2026-11-25T06:25:36.619321+00:00", "domain": "ai-mathematics", "recordKind": "official-announcement", "sourceKind": "official-announcement"}</data></node><node id="ai-src-mle-paper"><data key="title">On Learning-Curve Monotonicity for Maximum Likelihood Estimators</data><data key="kind">source</data><data key="domain">ai-mathematics</data><data key="status">selected-text</data><data key="metadata">{"id": "ai-src-mle-paper", "title": "On Learning-Curve Monotonicity for Maximum Likelihood Estimators", "url": "https://cdn.openai.com/pdf/a3f3f76c-98bd-47a5-888f-c52c932a8942/colt-monotonicity-problem.pdf", "authors": ["Mark Sellke", "Steven Yin"], "year": 2025, "version": "Unversioned provider-hosted manuscript linked December11 2025", "kind": "source", "status": "selected-text", "readDepth": "Selected sections read; no comprehensive proof audit.", "sectionsRead": ["Abstract; introduction; Statement on AI Assistance; Theorems1.1–1.2; scalar specialization of Section3"], "claim": "Forward KL risk decreases for well-specified Gaussian covariance MLE above its exact sample-size threshold; GPT-5.2 variants generated proofs subsequently checked/transcribed by humans.", "limitations": "No journal acceptance or Lean execution established; attribution is author testimony. PDF is unversioned, date anchored to official release.", "passageKind": "research-note", "note": "Forward KL risk decreases for well-specified Gaussian covariance MLE above its exact sample-size threshold; GPT-5.2 variants generated proofs subsequently checked/transcribed by humans.", "capture": "docs/field-atlas/sources/ai-mathematics/mle-paper.pdf", "sha256": "72dd996ecbb872343ac18f94da98a1cb63405daff6c4595112826343864e124d", "retrievedAt": "2026-11-25T06:26:10.164969+00:00", "domain": "ai-mathematics", "recordKind": "preprint", "sourceKind": "preprint"}</data></node><node id="ai-src-oa-firstproof"><data key="title">Our First Proof submissions</data><data key="kind">source</data><data key="domain">ai-mathematics</data><data key="status">selected-text</data><data key="metadata">{"id": "ai-src-oa-firstproof", "title": "Our First Proof submissions", "url": "https://openai.com/index/first-proof-submissions/", "authors": "OpenAI", "year": 2026, "version": "Captured current page; exact byte identity retained", "kind": "source", "status": "selected-text", "readDepth": "Selected sections read; no comprehensive proof audit.", "sectionsRead": ["February20 2026 article in full"], "claim": "Claims high confidence for attempts4,5,6,9,10; explicitly retracts confidence in attempt2; documents human selection and feedback.", "limitations": "A company’s provisional correctness estimate, not official grading of each internal-model proof.", "passageKind": "research-note", "note": "Claims high confidence for attempts4,5,6,9,10; explicitly retracts confidence in attempt2; documents human selection and feedback.", "capture": "docs/field-atlas/sources/ai-mathematics/oa-firstproof.html", "sha256": "02304d4bf20e6ce30d97691563f085bd6ed6537d40f67102b8aa522fd8b6779d", "retrievedAt": "2026-11-25T06:25:36.611887+00:00", "domain": "ai-mathematics", "recordKind": "official-announcement", "sourceKind": "official-announcement"}</data></node><node id="ai-src-first-submissions"><data key="title">First Proof?</data><data key="kind">source</data><data key="domain">ai-mathematics</data><data key="status">selected-text</data><data key="metadata">{"id": "ai-src-first-submissions", "title": "First Proof?", "url": "https://cdn.openai.com/pdf/26177a73-3b75-4828-8c91-e8f1cf27aaa0/oai_first_proof.pdf", "authors": "OpenAI", "year": 2026, "version": "February20 2026 PDF", "kind": "source", "status": "selected-text", "readDepth": "Selected sections read; no comprehensive proof audit.", "sectionsRead": ["February20 title/abstract; contents; problem statements1,2,4,6,9,10; prompting appendix headings"], "claim": "Ten internal-model proof attempts with limited human supervision and best-of selection.", "limitations": "Attempt does not mean proof; no full proof audit, no kernel run, some claims incorrect.", "passageKind": "research-note", "note": "Ten internal-model proof attempts with limited human supervision and best-of selection.", "capture": "docs/field-atlas/sources/ai-mathematics/first-submissions.pdf", "sha256": "27e97e4f61610cb31120c68bc8845b7a7b65bb2bfd044ffc4bb6f3b4d17f8102", "retrievedAt": "2026-11-25T06:26:10.466497+00:00", "domain": "ai-mathematics", "recordKind": "preprint", "sourceKind": "preprint"}</data></node><node id="ai-src-first-comments"><data key="title">First Proof: solutions and comments</data><data key="kind">source</data><data key="domain">ai-mathematics</data><data key="status">selected-text</data><data key="metadata">{"id": "ai-src-first-comments", "title": "First Proof: solutions and comments", "url": "https://1stproof.org/documents/FirstProofSolutionsComments.pdf", "authors": "First Proof problem authors", "year": 2026, "version": "Organizer-hosted current PDF", "kind": "source", "status": "selected-text", "readDepth": "Selected sections read; no comprehensive proof audit.", "sectionsRead": ["Problem statements2,4,5,6,9,10; Sections4.1–4.6 and4.10 assessment context"], "claim": "Supplies exact research problems and expert comments; the early baseline tests used GPT-5.2 Pro and are distinct from OpenAI’s later internal-model attempts.", "limitations": "Do not transfer a baseline verdict to a different model’s submission.", "passageKind": "research-note", "note": "Supplies exact research problems and expert comments; the early baseline tests used GPT-5.2 Pro and are distinct from OpenAI’s later internal-model attempts.", "capture": "docs/field-atlas/sources/ai-mathematics/first-comments.pdf", "sha256": "a46d478359e4038f7f83e83f8e2de423a6d713f3bc8c93859eab6540e0934631", "retrievedAt": "2026-11-25T06:26:10.066292+00:00", "domain": "ai-mathematics", "recordKind": "problem-record", "sourceKind": "problem-record"}</data></node><node id="ai-src-firstproof"><data key="title">First Proof Project mission and chronology</data><data key="kind">source</data><data key="domain">ai-mathematics</data><data key="status">selected-text</data><data key="metadata">{"id": "ai-src-firstproof", "title": "First Proof Project mission and chronology", "url": "https://www.1stproof.org/", "authors": "First Proof Foundation", "year": 2026, "version": "Captured current page; exact byte identity retained", "kind": "source", "status": "selected-text", "readDepth": "Selected sections read; no comprehensive proof audit.", "sectionsRead": ["Mission; three batch chronology; ethics/funding statement"], "claim": "Independent expert-engagement framework, with stated industry donations and governance restrictions.", "limitations": "Organizational independence is contextual evidence, not a proof of every submitted theorem.", "passageKind": "research-note", "note": "Independent expert-engagement framework, with stated industry donations and governance restrictions.", "capture": "docs/field-atlas/sources/ai-mathematics/firstproof.html", "sha256": "144ba7fb2e6b54d718c979e3c9037fa7deee2c26a05f9fd39b6425c140ac290d", "retrievedAt": "2026-11-25T06:25:04.736718+00:00", "domain": "ai-mathematics", "recordKind": "official-data", "sourceKind": "official-data"}</data></node><node id="ai-src-first-third"><data key="title">Third Batch benchmark protocol</data><data key="kind">source</data><data key="domain">ai-mathematics</data><data key="status">selected-text</data><data key="metadata">{"id": "ai-src-first-third", "title": "Third Batch benchmark protocol", "url": "https://1stproof.org/third-batch.html", "authors": "First Proof Foundation", "year": 2026, "version": "Captured current page; exact byte identity retained", "kind": "source", "status": "selected-text", "readDepth": "Selected sections read; no comprehensive proof audit.", "sectionsRead": ["Benchmark design; tested systems; links to reports/code/logs"], "claim": "Ten already-human-solved unpublished problems, one shot per system, public-model harnesses and double-blind grading.", "limitations": "Research-level benchmark does not mean ten globally open problems.", "passageKind": "research-note", "note": "Ten already-human-solved unpublished problems, one shot per system, public-model harnesses and double-blind grading.", "capture": "docs/field-atlas/sources/ai-mathematics/first-third.html", "sha256": "5814d3bd60577ca862239e4538d6934a65733d1b7dd35b2e63e195e149c3ca89", "retrievedAt": "2026-11-25T06:26:09.965835+00:00", "domain": "ai-mathematics", "recordKind": "official-data", "sourceKind": "official-data"}</data></node><node id="ai-src-third-pdf"><data key="title">First Proof Third Batch</data><data key="kind">source</data><data key="domain">ai-mathematics</data><data key="status">selected-text</data><data key="metadata">{"id": "ai-src-third-pdf", "title": "First Proof Third Batch", "url": "https://hexagonmath.org/pdf/2610.00244v1", "authors": ["Mohammed Abouzaid", "Nikhil Srivastava", "Rachel Ward", "Lauren Williams"], "year": 2026, "version": "Hexagon2610.00244v1; October14 2026;46pages", "kind": "source", "status": "selected-text", "readDepth": "Selected sections read; no comprehensive proof audit.", "sectionsRead": ["Abstract; Section1; Sections3.2/3.5 problem statements; Section4 system descriptions; Tables2–5; Sections5.1/5.2/5.5/5.7–5.9"], "claim": "At correctness threshold0.5: Astra7/10, Siege3/10, ProofCouncil9/10; exposition/attribution separately graded; several detailed reviews remain qualified.", "limitations": "Only selected report sections read. Human expert grading is not machine kernel verification or a population-wide capability estimate.", "passageKind": "research-note", "note": "At correctness threshold0.5: Astra7/10, Siege3/10, ProofCouncil9/10; exposition/attributi