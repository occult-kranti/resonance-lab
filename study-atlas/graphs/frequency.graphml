ey="kind">topic</data><data key="domain">frequency</data><data key="status">mapped</data><data key="metadata">{"id": "freq-nonstationary-claims-1", "title": "Multiple evolving body spectra", "parentId": "freq-nonstationary-claims", "level": 3, "summary": "Specialty focus: Multiple evolving body spectra. Check the exact mathematical object, units and hypotheses before interpreting a calculation.", "coverage": "mapped", "sourceIds": [], "prerequisites": ["freq-nonstationary-claims"], "formulaIds": [], "kind": "topic", "domain": "frequency"}</data></node><node id="freq-nonstationary-claims-2"><data key="title">Domain-qualified predictions</data><data key="kind">topic</data><data key="domain">frequency</data><data key="status">mapped</data><data key="metadata">{"id": "freq-nonstationary-claims-2", "title": "Domain-qualified predictions", "parentId": "freq-nonstationary-claims", "level": 3, "summary": "Specialty focus: Domain-qualified predictions. Check the exact mathematical object, units and hypotheses before interpreting a calculation.", "coverage": "mapped", "sourceIds": [], "prerequisites": ["freq-nonstationary-claims"], "formulaIds": [], "kind": "topic", "domain": "frequency"}</data></node><node id="freq-nonstationary-claims-2-control"><data key="title">One person has many channel spectra</data><data key="kind">topic</data><data key="domain">frequency</data><data key="status">mapped</data><data key="metadata">{"id": "freq-nonstationary-claims-2-control", "title": "One person has many channel spectra", "parentId": "freq-nonstationary-claims-2", "level": 4, "summary": "Boundary study: One person has many channel spectra. Construct the alternative or null explicitly and ask which additional measurement would distinguish it.", "coverage": "mapped", "sourceIds": [], "prerequisites": ["freq-nonstationary-claims-2"], "formulaIds": [], "kind": "topic", "domain": "frequency"}</data></node><node id="freq-period"><data key="title">Period and frequency</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-period", "topicId": "freq-phase-time", "title": "Period and frequency", "latex": "f=1/T", "plain": "Frequency counts repeated cycles per elapsed time; period is the duration of one complete repetition. This definition presupposes a repeatable event and a declared clock, rather than assigning an oscillation to any object by naming it.", "variables": [{"symbol": "f", "meaning": "ordinary frequency in cycles per second", "unit": "Hz", "kind": "scalar"}, {"symbol": "T", "meaning": "period of one cycle", "unit": "s", "kind": "scalar"}], "conditions": ["T&gt;0; stationary periodic signal; cycles counted consistently."], "derivation": ["Choose successive equivalent phase crossings.", "Divide the number of complete cycles by the elapsed time; for one cycle invert its duration."], "workedExample": {"inputs": {"T_s": 0.002}, "steps": ["Invert 0.002 seconds."], "result": "500", "units": "Hz"}, "limitingCases": ["As T grows without bound, f approaches zero."], "pitfalls": ["A transient or irregular record need not have one period."], "sourceIds": ["freq-si-brochure"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-angular"><data key="title">Ordinary versus angular frequency</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-angular", "topicId": "freq-phase-time", "title": "Ordinary versus angular frequency", "latex": "\\omega=2\\pi f", "plain": "A full cycle is 2π radians. Ordinary frequency and angular frequency describe the same periodic evolution with different phase-counting conventions. The radian is a named dimensionless SI unit, but retaining rad in labels prevents factor-of-2π mistakes.", "variables": [{"symbol": "ω", "meaning": "angular frequency", "unit": "rad s⁻¹", "kind": "scalar"}, {"symbol": "f", "meaning": "ordinary frequency in cycles per second", "unit": "Hz", "kind": "scalar"}, {"symbol": "π", "meaning": "circle constant, about 3.141592653589793", "unit": "dimensionless", "kind": "constant"}], "conditions": ["Sinusoidal phase or a specified phase-rate definition."], "derivation": ["One cycle increments phase by 2π.", "Differentiate phase 2πft with respect to time."], "workedExample": {"inputs": {"f_Hz": 50}, "steps": ["Multiply 50 by 2π."], "result": "314.159", "units": "rad s⁻¹"}, "limitingCases": ["Zero frequency gives zero angular frequency."], "pitfalls": ["Do not insert a frequency in Hz into an equation that expects rad/s."], "sourceIds": ["freq-si-brochure", "freq-feynman-oscillator"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-instantaneous"><data key="title">Instantaneous phase frequency</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">conditional-result</data><data key="metadata">{"id": "freq-instantaneous", "topicId": "freq-phase-time", "title": "Instantaneous phase frequency", "latex": "f(t)=\\frac{1}{2\\pi}\\frac{d\\phi}{dt}", "plain": "For a resolved single-component signal, phase slope defines a local frequency. This is conditional on choosing a continuous phase representation and on adequate amplitude and signal quality. It is not a unique decomposition of an arbitrary multicomponent waveform.", "variables": [{"symbol": "f", "meaning": "ordinary frequency in cycles per second", "unit": "Hz", "kind": "scalar"}, {"symbol": "φ", "meaning": "continuous phase under stated unwrap convention", "unit": "rad", "kind": "scalar"}, {"symbol": "t", "meaning": "elapsed time", "unit": "s", "kind": "coordinate"}, {"symbol": "π", "meaning": "circle constant, about 3.141592653589793", "unit": "dimensionless", "kind": "constant"}], "conditions": ["Unwrapped differentiable phase; amplitude not zero; phase model declared."], "derivation": ["Represent one component by amplitude times cosine of phase.", "Define frequency as cycles of phase accumulated per unit time."], "workedExample": {"inputs": {"phase": "φ(t)=2π(100t+5t²)"}, "steps": ["Differentiate: dφ/dt=2π(100+10t).", "Evaluate at t=2 s."], "result": "120", "units": "Hz"}, "limitingCases": ["Constant phase has zero local frequency."], "pitfalls": ["Phase at an amplitude zero can be undefined; differentiation amplifies noise."], "sourceIds": ["freq-numpy-fft", "freq-scipy-stft"], "status": "conditional-result", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-oscillator"><data key="title">Undamped mass–spring natural frequency</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-oscillator", "topicId": "freq-free-damped", "title": "Undamped mass–spring natural frequency", "latex": "\\omega_0=\\sqrt{K/m}", "plain": "The free natural frequency follows from stiffness and inertia, not from the current drive. It is the frequency of one selected linearized coordinate under specified constraints. A real body generally supplies many coordinates and modes.", "variables": [{"symbol": "ω₀", "meaning": "undamped natural angular frequency", "unit": "rad s⁻¹", "kind": "scalar"}, {"symbol": "K", "meaning": "linear stiffness", "unit": "N m⁻¹", "kind": "coupling"}, {"symbol": "m", "meaning": "mass", "unit": "kg", "kind": "scalar"}], "conditions": ["m&gt;0; K&gt;0; linear Hookean restoring force; no damping."], "derivation": ["Start with m x″+Kx=0.", "Insert x=A cos(ωt) and require K−mω²=0."], "workedExample": {"inputs": {"K_N_per_m": 100, "m_kg": 1}, "steps": ["Take sqrt(100/1).", "Divide angular frequency by 2π to express Hz."], "result": "ω₀=10 rad/s; f₀≈1.59155 Hz", "units": "rad s⁻¹ and Hz"}, "limitingCases": ["K→0 removes the restoring oscillation."], "pitfalls": ["Support stiffness and effective mass must match the same coordinate."], "sourceIds": ["freq-feynman-oscillator"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-damped"><data key="title">Damped free oscillation</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-damped", "topicId": "freq-free-damped", "title": "Damped free oscillation", "latex": "\\omega_d=\\sqrt{\\omega_0^2-\\gamma^2},\\quad\\gamma=b/(2m)", "plain": "A viscously damped oscillator rings with an exponential envelope and a shifted oscillation frequency. This describes the underdamped free motion; the frequency of the maximum forced displacement is a different quantity.", "variables": [{"symbol": "ω_d", "meaning": "damped free angular frequency", "unit": "rad s⁻¹", "kind": "scalar"}, {"symbol": "ω₀", "meaning": "undamped natural angular frequency", "unit": "rad s⁻¹", "kind": "scalar"}, {"symbol": "γ", "meaning": "amplitude decay rate b/(2m)", "unit": "s⁻¹", "kind": "scalar"}, {"symbol": "b", "meaning": "viscous damping coefficient", "unit": "kg s⁻¹", "kind": "coupling"}, {"symbol": "m", "meaning": "mass", "unit": "kg", "kind": "scalar"}], "conditions": ["Linear viscous damping; 0≤γ&lt;ω₀."], "derivation": ["Solve the characteristic polynomial r²+2γr+ω₀²=0.", "Its roots are −γ±iω_d; the real part sets decay and imaginary part sets oscillation."], "workedExample": {"inputs": {"omega0_rad_s": 10, "gamma_per_s": 1}, "steps": ["Compute sqrt(100−1)."], "result": "9.949874", "units": "rad s⁻¹"}, "limitingCases": ["At γ=0 recover ω₀; critical damping has no sinusoidal ringing."], "pitfalls": ["Do not continue the square root as a real oscillation above critical damping.", "Feynman I23 writes the damping coefficient as b/m; this atlas gamma is b/(2m), requiring an explicit factor-of-two translation."], "sourceIds": ["freq-feynman-resonance"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-q"><data key="title">Quality factor in the weakly damped oscillator</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">approximation</data><data key="metadata">{"id": "freq-q", "topicId": "freq-free-damped", "title": "Quality factor in the weakly damped oscillator", "latex": "Q=\\omega_0/(2\\gamma)=m\\omega_0/b", "plain": "Quality factor compares stored energy with energy dissipated over an oscillation. For this linear viscous model the damping definition gives Q=ω₀/(2γ); the familiar energy-lost-per-cycle interpretation is most direct when damping is weak.", "variables": [{"symbol": "Q", "meaning": "quality factor under the stated energy/linewidth convention", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "ω₀", "meaning": "undamped natural angular frequency", "unit": "rad s⁻¹", "kind": "scalar"}, {"symbol": "γ", "meaning": "amplitude decay rate b/(2m)", "unit": "s⁻¹", "kind": "scalar"}, {"symbol": "m", "meaning": "mass", "unit": "kg", "kind": "scalar"}, {"symbol": "b", "meaning": "viscous damping coefficient", "unit": "kg s⁻¹", "kind": "coupling"}], "conditions": ["Positive viscous damping; energy/linewidth comparisons use weak damping."], "derivation": ["The displacement envelope decays as e^(−γt), so energy decays twice as fast.", "Compare the energy-loss timescale with the oscillation timescale."], "workedExample": {"inputs": {"omega0_rad_s": 1000, "gamma_per_s": 5}, "steps": ["Divide 1000 by 10."], "result": "100", "units": "dimensionless"}, "limitingCases": ["b→0 yields diverging Q in the lossless idealization."], "pitfalls": ["A high Q stores supplied energy; it is not energy creation.", "Feynman I23 writes the damping coefficient as b/m; this atlas gamma is b/(2m), requiring an explicit factor-of-two translation.", "Free ring-down amplitude decays at γ while energy decays at 2γ; loaded Q, internal Q and external-coupling Q are not interchangeable."], "sourceIds": ["freq-feynman-resonance"], "status": "approximation", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-response"><data key="title">Complex forced displacement response</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-response", "topicId": "freq-driven-coupled", "title": "Complex forced displacement response", "latex": "H(\\omega)=\\frac{1}{K-m\\omega^2+\\mathrm{i}b\\omega}", "plain": "The displacement-to-force transfer function contains both gain and phase. The stated sign follows the e^(iωt) convention. It makes an experimentally useful prediction only when force and displacement channels, units, loading and calibration are specified.", "variables": [{"symbol": "H", "meaning": "displacement/force frequency response", "unit": "m N⁻¹", "kind": "operator"}, {"symbol": "K", "meaning": "linear stiffness", "unit": "N m⁻¹", "kind": "coupling"}, {"symbol": "m", "meaning": "mass", "unit": "kg", "kind": "scalar"}, {"symbol": "b", "meaning": "viscous damping coefficient", "unit": "kg s⁻¹", "kind": "coupling"}, {"symbol": "ω", "meaning": "angular frequency", "unit": "rad s⁻¹", "kind": "scalar"}, {"symbol": "i", "meaning": "imaginary unit satisfying i²=−1; not electric current", "unit": "dimensionless", "kind": "constant"}], "conditions": ["Steady sinusoidal forcing; linear time-invariant system; e^(iωt) phasors."], "derivation": ["Insert complex sinusoidal force and displacement into the equation of motion.", "Cancel the common time factor and divide displacement amplitude by force amplitude."], "workedExample": {"inputs": {"K": 100, "m": 1, "b": 2, "omega": 10}, "steps": ["At ω=10 the real stiffness and inertia cancel.", "H=1/(i20)=−i0.05."], "result": "|H|=0.05; phase=−π/2", "units": "m N⁻¹; rad"}, "limitingCases": ["At ω=0 recover static compliance 1/K."], "pitfalls": ["Changing phasor convention conjugates the imaginary sign, not the measurable prediction."], "sourceIds": ["freq-feynman-resonance"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-peak"><data key="title">Forced-displacement peak frequency</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-peak", "topicId": "freq-driven-coupled", "title": "Forced-displacement peak frequency", "latex": "\\omega_r=\\sqrt{\\omega_0^2-2\\gamma^2}", "plain": "For a flat force amplitude and frequency-independent viscous damping, the maximum displacement occurs below the undamped natural frequency. Other measured quantities, such as velocity, absorbed power or a microphone output, can peak elsewhere.", "variables": [{"symbol": "ω_r", "meaning": "displacement-amplitude peak angular frequency", "unit": "rad s⁻¹", "kind": "scalar"}, {"symbol": "ω₀", "meaning": "undamped natural angular frequency", "unit": "rad s⁻¹", "kind": "scalar"}, {"symbol": "γ", "meaning": "amplitude decay rate b/(2m)", "unit": "s⁻¹", "kind": "scalar"}], "conditions": ["γ&lt;ω₀/√2; displacement amplitude; constant driving-force amplitude."], "derivation": ["Square the magnitude of the denominator of H.", "Set its frequency derivative to zero and select the positive minimum."], "workedExample": {"inputs": {"omega0": 10, "gamma": 1}, "steps": ["Compute sqrt(100−2)."], "result": "9.899495", "units": "rad s⁻¹"}, "limitingCases": ["At zero damping this approaches ω₀; above the stated bound the interior displacement peak disappears."], "pitfalls": ["A spectral maximum does not automatically equal the isolated object natural mode.", "Feynman I23 writes the damping coefficient as b/m; this atlas gamma is b/(2m), requiring an explicit factor-of-two translation."], "sourceIds": ["freq-feynman-resonance"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-linewidth"><data key="title">Loaded resonance linewidth</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">approximation</data><data key="metadata">{"id": "freq-linewidth", "topicId": "freq-driven-coupled", "title": "Loaded resonance linewidth", "latex": "Q\\simeq f_0/\\Delta f", "plain": "The linewidth relationship uses the half-power bandwidth of a single narrow resonance. Loaded Q includes energy loss through the measurement and drive ports as well as internal loss. A different amplitude threshold or a superposition of modes changes the inference.", "variables": [{"symbol": "Q", "meaning": "quality factor under the stated energy/linewidth convention", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "f₀", "meaning": "centre frequency of the isolated narrow resonance", "unit": "Hz", "kind": "scalar"}, {"symbol": "Δf", "meaning": "specified bandwidth or tone separation, as defined locally", "unit": "Hz", "kind": "scalar"}], "conditions": ["Isolated weakly damped resonance; Δf is full width at half maximum of power."], "derivation": ["Approximate the response denominator near its resonance.", "Find the two frequencies where response power is half its peak value."], "workedExample": {"inputs": {"f0_Hz": 1000, "bandwidth_Hz": 10}, "steps": ["Divide 1000 by 10."], "result": "100", "units": "dimensionless"}, "limitingCases": ["Vanishing linewidth gives divergent ideal Q."], "pitfalls": ["Half amplitude is not half power; unresolved neighboring peaks violate the fit model.", "Δf is the full half-power width, not the half-width-at-half-maximum (HWHM=Δf/2). Loaded loss rates add only when the declared independent-port linear-loss model applies."], "sourceIds": ["freq-feynman-resonance"], "status": "approximation", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-modes"><data key="title">Coupled normal-mode eigenproblem</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-modes", "topicId": "freq-driven-coupled", "title": "Coupled normal-mode eigenproblem", "latex": "Kq=\\omega^2Mq", "plain": "A coupled body has a family of mode shapes and eigenfrequencies. Positive mass and appropriate stiffness/boundary conditions determine the mathematical problem. A plotted shape alone does not specify the matrices, physical scale or material properties.", "variables": [{"symbol": "K", "meaning": "stiffness matrix", "unit": "N m⁻¹", "kind": "tensor"}, {"symbol": "M", "meaning": "positive mass matrix", "unit": "kg", "kind": "tensor"}, {"symbol": "q", "meaning": "normal-mode displacement vector", "unit": "m", "kind": "vector"}, {"symbol": "ω", "meaning": "angular frequency", "unit": "rad s⁻¹", "kind": "scalar"}], "conditions": ["Linear conservative finite-dimensional model; M positive definite; declared supports."], "derivation": ["Insert q(t)=q₀e^(iωt) into Mq″+Kq=0.", "Require a nonzero eigenvector instead of inverting a singular dynamic stiffness."], "workedExample": {"inputs": {"M": "I kg", "K": "diag(4,9) N/m"}, "steps": ["Read the two eigenvalues 4 and 9.", "Take their positive square roots."], "result": "2 and 3", "units": "rad s⁻¹"}, "limitingCases": ["A zero stiffness eigenvalue is a rigid or marginal mode, not a positive resonance."], "pitfalls": ["Degeneracies and damping can require different modal coordinates."], "sourceIds": ["freq-feynman-oscillator"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-wave"><data key="title">Nondispersive wave equation</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-wave", "topicId": "freq-propagation-dispersion", "title": "Nondispersive wave equation", "latex": "\\partial_t^2u=c^2\\partial_x^2u,\\quad\\omega=ck", "plain": "For a uniform one-dimensional nondispersive medium, sinusoidal plane waves satisfy a linear relation between angular frequency and spatial wave number. The medium speed belongs to that wave equation and is not automatically the vacuum speed of light.", "variables": [{"symbol": "u", "meaning": "wave-field displacement", "unit": "m", "kind": "state"}, {"symbol": "c", "meaning": "phase speed in the declared medium", "unit": "m s⁻¹", "kind": "scalar"}, {"symbol": "k", "meaning": "spatial angular wave number", "unit": "rad m⁻¹", "kind": "scalar"}, {"symbol": "ω", "meaning": "angular frequency", "unit": "rad s⁻¹", "kind": "scalar"}, {"symbol": "x", "meaning": "displacement", "unit": "m", "kind": "coordinate"}, {"symbol": "t", "meaning": "elapsed time", "unit": "s", "kind": "coordinate"}], "conditions": ["Linear uniform 1D medium; no dispersion, dissipation or unspecified boundaries."], "derivation": ["Insert u=A exp(i(kx−ωt)).", "Cancel the nonzero wave factor and compare ω² with c²k²."], "workedExample": {"inputs": {"c_m_s": 343, "f_Hz": 343}, "steps": ["Use λ=c/f=1 m.", "Thus k=2π rad/m."], "result": "λ=1 m; ω=2π·343 rad/s", "units": "m and rad s⁻¹"}, "limitingCases": ["At k=0 the chosen acoustic branch has ω=0."], "pitfalls": ["A boundary-value spectrum needs boundary conditions beyond a plane-wave dispersion law."], "sourceIds": ["freq-feynman-oscillator"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-velocities"><data key="title">Phase and group velocity</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">conditional-result</data><data key="metadata">{"id": "freq-velocities", "topicId": "freq-propagation-dispersion", "title": "Phase and group velocity", "latex": "v_p=\\omega/k,\\quad v_g=d\\omega/dk", "plain": "Phase speed follows constant phase; group speed follows the envelope of a narrow wave packet under suitable smooth dispersion. Neither expression alone proves a signal-front speed or licenses superluminal information transfer.", "variables": [{"symbol": "v_p", "meaning": "phase velocity", "unit": "m s⁻¹", "kind": "scalar"}, {"symbol": "v_g", "meaning": "group velocity dω/dk", "unit": "m s⁻¹", "kind": "scalar"}, {"symbol": "ω", "meaning": "angular frequency", "unit": "rad s⁻¹", "kind": "scalar"}, {"symbol": "k", "meaning": "spatial angular wave number", "unit": "rad m⁻¹", "kind": "scalar"}], "conditions": ["k≠0 for phase speed; smooth branch and narrowband packet for group speed."], "derivation": ["Keep kx−ωt constant for a phase crest.", "Expand ω(k) to first order around the carrier to obtain envelope translation."], "workedExample": {"inputs": {"dispersion": "ω=αk²", "at": "k=2 m⁻¹, α=3 m²/s"}, "steps": ["Compute ω=12 s⁻¹.", "v_p=6 and v_g=2αk=12."], "result": "v_p=6; v_g=12", "units": "m s⁻¹"}, "limitingCases": ["For ω=ck both reduce to c."], "pitfalls": ["Absorbing and strongly distorted pulses need more than an envelope-velocity formula."], "sourceIds": ["freq-feynman-oscillator"], "status": "conditional-result", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-string"><data key="title">Fixed-end string modes</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-string", "topicId": "freq-acoustics-em", "title": "Fixed-end string modes", "latex": "f_n=nc/(2L)", "plain": "A string fixed at both ends supports integer spatial half-wavelengths. This is a declared string model, not a formula that assigns a monument, sigil or arbitrary image its natural frequency.", "variables": [{"symbol": "f", "meaning": "ordinary frequency in cycles per second", "unit": "Hz", "kind": "scalar"}, {"symbol": "n", "meaning": "integer mode or comb index under the local definition", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "c", "meaning": "phase speed in the declared medium", "unit": "m s⁻¹", "kind": "scalar"}, {"symbol": "L", "meaning": "specified physical length", "unit": "m", "kind": "scalar"}], "conditions": ["Uniform ideal string; fixed displacement at both ends; n positive integer."], "derivation": ["Boundary zeros require k_nL=nπ.", "Combine ω=ck with f=ω/(2π)."], "workedExample": {"inputs": {"L_m": 1, "c_m_s": 100, "n": 3}, "steps": ["Evaluate 3·100/(2·1)."], "result": "150", "units": "Hz"}, "limitingCases": ["Double L at fixed c and n to halve f."], "pitfalls": ["Air cavities and elastic plates have different boundary equations."], "sourceIds": ["freq-feynman-oscillator"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-room"><data key="title">Ideal rigid rectangular-room modes</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">conditional-result</data><data key="metadata">{"id": "freq-room", "topicId": "freq-acoustics-em", "title": "Ideal rigid rectangular-room modes", "latex": "f_{n_xn_yn_z}=\\frac c2\\sqrt{(n_x/L_x)^2+(n_y/L_y)^2+(n_z/L_z)^2}", "plain": "A separable pressure-wave model in a rigid rectangular cavity gives a modal family indexed by three nonnegative integers. Wall impedance, openings, obstacles and real geometry change this spectrum and its linewidths.", "variables": [{"symbol": "f", "meaning": "ordinary frequency in cycles per second", "unit": "Hz", "kind": "scalar"}, {"symbol": "c", "meaning": "phase speed in the declared medium", "unit": "m s⁻¹", "kind": "scalar"}, {"symbol": "L_x", "meaning": "room dimension along x", "unit": "m", "kind": "scalar"}, {"symbol": "L_y", "meaning": "room dimension along y", "unit": "m", "kind": "scalar"}, {"symbol": "L_z", "meaning": "room dimension along z", "unit": "m", "kind": "scalar"}, {"symbol": "n_x", "meaning": "nonnegative integer mode index along x", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "n_y", "meaning": "nonnegative integer mode index along y", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "n_z", "meaning": "nonnegative integer mode index along z", "unit": "dimensionless", "kind": "scalar"}], "conditions": ["Rigid-wall pressure Neumann boundaries; rectangular uniform medium; indices not all zero."], "derivation": ["Separate the Helmholtz equation into three cosine factors.", "Add the squared axial wave numbers and convert angular frequency to Hz."], "workedExample": {"inputs": {"lengths_m": [5, 4, 3], "c_m_s": 343, "indices": [1, 0, 0]}, "steps": ["Only the 5 m axial term remains.", "Compute 343/(2·5)."], "result": "34.3", "units": "Hz"}, "limitingCases": ["Scale every room dimension by two to halve every mode frequency."], "pitfalls": ["L_x,L_y,L_z each have units m; n_x,n_y,n_z are integer indices. A photograph does not supply these dimensions or walls."], "sourceIds": ["freq-feynman-oscillator"], "status": "conditional-result", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-fourier"><data key="title">Continuous Fourier transform convention</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-fourier", "topicId": "freq-continuous-discrete", "title": "Continuous Fourier transform convention", "latex": "X(f)=\\int_{-\\infty}^{\\infty}x(t)e^{-\\mathrm{i}2\\pi ft}\\,dt", "plain": "The transform resolves a time signal into complex frequency components under one explicit normalization. Displacement data produce transform units of metre-seconds. Generalized functions are needed for ideal infinite-duration pure tones.", "variables": [{"symbol": "X(f)", "meaning": "continuous Fourier transform of x(t)", "unit": "m s", "kind": "operator"}, {"symbol": "x", "meaning": "displacement", "unit": "m", "kind": "coordinate"}, {"symbol": "f", "meaning": "ordinary frequency in cycles per second", "unit": "Hz", "kind": "scalar"}, {"symbol": "t", "meaning": "elapsed time", "unit": "s", "kind": "coordinate"}, {"symbol": "π", "meaning": "circle constant, about 3.141592653589793", "unit": "dimensionless", "kind": "constant"}, {"symbol": "i", "meaning": "imaginary unit satisfying i²=−1; not electric current", "unit": "dimensionless", "kind": "constant"}], "conditions": ["Integrable signal or stated generalized-function/L2 interpretation."], "derivation": ["Project the signal onto complex exponentials with frequency f.", "Retain the dt factor, which supplies the time dimension."], "workedExample": {"inputs": {"signal": "x(t)=e^(−at) for t≥0; a=2 s⁻¹, amplitude1 m"}, "steps": ["Integrate the decaying complex exponential."], "result": "X(f)=1/(2+i2πf) m·s", "units": "m s"}, "limitingCases": ["At f=0 the transform equals the time integral of the signal."], "pitfalls": ["An FFT array is not automatically the continuous transform without sample-spacing scaling."], "sourceIds": ["freq-numpy-fft", "freq-sympy-laplace"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-inverse-fourier"><data key="title">Inverse Fourier reconstruction</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">theorem</data><data key="metadata">{"id": "freq-inverse-fourier", "topicId": "freq-continuous-discrete", "title": "Inverse Fourier reconstruction", "latex": "x(t)=\\int_{-\\infty}^{\\infty}X(f)e^{\\mathrm{i}2\\pi ft}\\,df", "plain": "Under compatible hypotheses the inverse combines complex components to recover the signal. The frequency integral supplies inverse seconds, restoring the original signal units; phase is essential to the reconstruction.", "variables": [{"symbol": "x", "meaning": "displacement", "unit": "m", "kind": "coordinate"}, {"symbol": "X(f)", "meaning": "continuous Fourier transform of x(t)", "unit": "m s", "kind": "operator"}, {"symbol": "f", "meaning": "ordinary frequency in cycles per second", "unit": "Hz", "kind": "scalar"}, {"symbol": "t", "meaning": "elapsed time", "unit": "s", "kind": "coordinate"}, {"symbol": "π", "meaning": "circle constant, about 3.141592653589793", "unit": "dimensionless", "kind": "constant"}, {"symbol": "i", "meaning": "imaginary unit satisfying i²=−1; not electric current", "unit": "dimensionless", "kind": "constant"}], "conditions": ["Sufficient pointwise form: x and its Fourier transform X are both integrable on R; the inverse equals x almost everywhere and at continuity points. L2 inversion is a separate mean-square statement."], "derivation": ["Use orthogonality in the distributional or Hilbert-space sense.", "Integrate X against the opposite-sign exponential."], "workedExample": {"inputs": {"pair": "exp(−2t)·1(t) ↔ 1/(2+i2πf)"}, "steps": ["Apply the inverse with its specified sign."], "result": "Recover the causal exponential at continuity points.", "units": "m"}, "limitingCases": ["Removing all Fourier components gives the zero signal."], "pitfalls": ["Magnitude-only spectra generally cannot reconstruct phase or a unique time waveform."], "sourceIds": ["freq-numpy-fft", "freq-sympy-laplace"], "status": "theorem", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-convolution"><data key="title">Linear convolution theorem</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">theorem</data><data key="metadata">{"id": "freq-convolution", "topicId": "freq-transfer-id", "title": "Linear convolution theorem", "latex": "\\mathcal F\\{h*x\\}(f)=H(f)X(f)", "plain": "For a linear time-invariant channel, convolution in time corresponds to multiplication in frequency. The output spectrum includes the channel response, so a strong output line can come from propagation, sensor or electronics rather than the source alone.", "variables": [{"symbol": "h(t)", "meaning": "time-domain LTI impulse-response kernel", "unit": "output/(input·s)", "kind": "operator"}, {"symbol": "x(t)", "meaning": "input signal, here displacement for unit illustration", "unit": "m", "kind": "state"}, {"symbol": "*", "meaning": "convolution: (h*x)(t)=∫h(t−u)x(u)du, where u and t are time coordinates in seconds", "unit": "operator convention; includes integration over s", "kind": "operator"}, {"symbol": "𝓕", "meaning": "Fourier transform with negative exponent −i2πft", "unit": "maps a signal unit to signal unit·s", "kind": "operator"}, {"symbol": "H(f)", "meaning": "Fourier transform of the impulse response", "unit": "output/input", "kind": "operator"}, {"symbol": "X(f)", "meaning": "Fourier transform of the input", "unit": "m s", "kind": "state"}, {"symbol": "f", "meaning": "ordinary transform frequency", "unit": "Hz", "kind": "coordinate"}], "conditions": ["Sufficient classical form: x,h are integrable on R, so Fubini applies; compatible Fourier convention. A physical time-domain impulse kernel has output/(input·s) units and its H has output/input units."], "derivation": ["Insert the convolution integral into the Fourier definition.", "Exchange integrals under appropriate convergence conditions and shift the time variable."], "workedExample": {"inputs": {"gain": "H=2 dimensionless", "input_component": "X=3 m·s"}, "steps": ["Multiply the complex components."], "result": "Y=6", "units": "m s"}, "limitingCases": ["H=0 suppresses every source component at that frequency."], "pitfalls": ["A transfer-function zero destroys information that naive division cannot restore."], "sourceIds": ["freq-scipy-csd"], "status": "theorem", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-laplace"><data key="title">Causal Laplace transform and convergence</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-laplace", "topicId": "freq-continuous-discrete", "title": "Causal Laplace transform and convergence", "latex": "X(s)=\\int_0^{\\infty}x(t)e^{-st}\\,dt,\\quad s=\\sigma+\\mathrm{i}\\omega", "plain": "The Laplace variable carries both decay/growth weighting and angular oscillation. Its region of convergence is part of the transform. A formal substitution s=iω does not establish that a Fourier transform exists on that boundary.", "variables": [{"symbol": "X(s)", "meaning": "causal Laplace transform of displacement x(t)", "unit": "m s", "kind": "operator"}, {"symbol": "s", "meaning": "complex Laplace frequency σ+iω", "unit": "s⁻¹", "kind": "scalar"}, {"symbol": "σ", "meaning": "Laplace exponential growth/decay parameter", "unit": "s⁻¹", "kind": "scalar"}, {"symbol": "ω", "meaning": "angular frequency", "unit": "rad s⁻¹", "kind": "scalar"}, {"symbol": "x", "meaning": "displacement", "unit": "m", "kind": "coordinate"}, {"symbol": "t", "meaning": "elapsed time", "unit": "s", "kind": "coordinate"}, {"symbol": "i", "meaning": "imaginary unit satisfying i²=−1; not electric current", "unit": "dimensionless", "kind": "constant"}], "conditions": ["Causal convention; integral converges for stated Re(s)."], "derivation": ["Multiply the causal response by exponential weighting.", "Identify where the tail integral converges before simplifying algebra."], "workedExample": {"inputs": {"x": "e^(−2t)·1(t) m"}, "steps": ["Integrate exp[−(s+2)t]."], "result": "X=1/(s+2); Re(s)&gt;−2", "units": "m s"}, "limitingCases": ["At s=0 recover total area 0.5 m·s."], "pitfalls": ["The algebraic fraction alone omits the causal region of convergence."], "sourceIds": ["freq-sympy-laplace"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-dft"><data key="title">Finite discrete Fourier transform</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">theorem</data><data key="metadata">{"id": "freq-dft", "topicId": "freq-continuous-discrete", "title": "Finite discrete Fourier transform", "latex": "X_k=\\sum_{j=0}^{N-1}x_j e^{-\\mathrm{i}2\\pi jk/N}", "plain": "The DFT is an exact invertible change of coordinates for a finite sample vector under its chosen normalization. It is not, by itself, proof of the spectrum of the unsampled physical world.", "variables": [{"symbol": "X_k", "meaning": "unscaled forward DFT coefficient", "unit": "m", "kind": "state"}, {"symbol": "x_j", "meaning": "sampled signal, here displacement for unit illustration", "unit": "m", "kind": "state"}, {"symbol": "N", "meaning": "number of samples", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "j", "meaning": "time-sample integer index", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "k", "meaning": "DFT integer bin index", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "π", "meaning": "circle constant, about 3.141592653589793", "unit": "dimensionless", "kind": "constant"}, {"symbol": "i", "meaning": "imaginary unit satisfying i²=−1; not electric current", "unit": "dimensionless", "kind": "constant"}], "conditions": ["N positive integer; forward transform unscaled, inverse divided by N."], "derivation": ["Choose the N orthogonal discrete complex exponentials.", "Compute their finite inner products with the sample vector."], "workedExample": {"inputs": {"samples": [1, 0, -1, 0]}, "steps": ["Use the four-point forward convention."], "result": "[0,2,0,2]", "units": "input unit (m in this illustration)"}, "limitingCases": ["A constant vector has only its DC coefficient nonzero."], "pitfalls": ["FFT names an algorithm; DFT names the mathematical transform."], "sourceIds": ["freq-numpy-fft"], "status": "theorem", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-bins"><data key="title">DFT frequency grid</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-bins", "topicId": "freq-acquisition-estimation", "title": "DFT frequency grid", "latex": "f_k=kf_s/N,\\quad\\Delta f=f_s/N=1/T_{obs}", "plain": "The standard DFT grid spacing is reciprocal record duration. Zero padding provides additional interpolation points but does not create an independently longer measurement or separate arbitrarily close noisy components.", "variables": [{"symbol": "f", "meaning": "ordinary frequency in cycles per second", "unit": "Hz", "kind": "scalar"}, {"symbol": "k", "meaning": "DFT integer bin index", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "f_s", "meaning": "sampling rate", "unit": "Hz", "kind": "scalar"}, {"symbol": "N", "meaning": "number of samples", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "Δf", "meaning": "specified bandwidth or tone separation, as defined locally", "unit": "Hz", "kind": "scalar"}, {"symbol": "T_obs", "meaning": "observation duration", "unit": "s", "kind": "scalar"}], "conditions": ["Uniform sampling; T_obs=N/f_s; signed negative bins identified consistently."], "derivation": ["N equally spaced phase patterns span the finite vector.", "Convert phase advance per sample into cycles per second."], "workedExample": {"inputs": {"fs_Hz": 1000, "N": 2000}, "steps": ["T_obs=2 s.", "Compute 1000/2000."], "result": "0.5", "units": "Hz"}, "limitingCases": ["Doubling observation duration at fixed rate halves grid spacing."], "pitfalls": ["Grid spacing, estimator uncertainty and two-line resolution are different notions."], "sourceIds": ["freq-numpy-fft"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-alias"><data key="title">Discrete-time alias equivalence</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">theorem</data><data key="metadata">{"id": "freq-alias", "topicId": "freq-acquisition-estimation", "title": "Discrete-time alias equivalence", "latex": "e^{\\mathrm{i}2\\pi(f+nf_s)j/f_s}=e^{\\mathrm{i}2\\pi fj/f_s}", "plain": "Sampling identifies complex tones whose frequencies differ by an integer sampling rate. Real cosines add sign ambiguity. No later plot or machine-learning method can distinguish those aliases from the identical samples without additional assumptions or measurements.", "variables": [{"symbol": "f", "meaning": "ordinary frequency in cycles per second", "unit": "Hz", "kind": "scalar"}, {"symbol": "n", "meaning": "integer mode or comb index under the local definition", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "f_s", "meaning": "sampling rate", "unit": "Hz", "kind": "scalar"}, {"symbol": "j", "meaning": "time-sample integer index", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "π", "meaning": "circle constant, about 3.141592653589793", "unit": "dimensionless", "kind": "constant"}, {"symbol": "i", "meaning": "imaginary unit satisfying i²=−1; not electric current", "unit": "dimensionless", "kind": "constant"}], "conditions": ["Uniform ideal sample times; n and j integers."], "derivation": ["Expand the extra phase as 2πnj.", "Its complex exponential equals one for every sample."], "workedExample": {"inputs": {"fs_Hz": 1000, "tones_Hz": [100, 1100]}, "steps": ["Their difference is one sampling rate."], "result": "Identical complex sample sequences.", "units": "dimensionless identity"}, "limitingCases": ["Adding n=0 leaves the same frequency."], "pitfalls": ["Anti-alias filtering must occur before irrecoverable sampling."], "sourceIds": ["freq-numpy-fft"], "status": "theorem", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-nyquist"><data key="title">Bandlimited sampling condition</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">theorem</data><data key="metadata">{"id": "freq-nyquist", "topicId": "freq-acquisition-estimation", "title": "Bandlimited sampling condition", "latex": "f_{max}&lt;f_s/2", "plain": "A strictly bandlimited signal can be reconstructed in the ideal sampling theorem when the sample rate exceeds twice its highest frequency. Equality is delicate: a sine exactly at Nyquist can vanish at every sample. Real hardware needs a transition band and analog filtering.", "variables": [{"symbol": "f_max", "meaning": "highest absolute occupied signal frequency B, not an arbitrary oscillator carrier", "unit": "Hz", "kind": "scalar"}, {"symbol": "f_s", "meaning": "uniform sampling rate", "unit": "Hz", "kind": "scalar"}, {"symbol": "B", "meaning": "bandlimit used in the stated theorem hypothesis; equal to f_max", "unit": "Hz", "kind": "scalar"}], "conditions": ["Ideal theorem: an L2 continuous-time signal has Fourier support in [−B,B] with B&lt;f_s/2; infinitely many exact uniform samples and the associated ideal reconstruction are available. A finite record and real filter need extra error analysis."], "derivation": ["Sampling repeats the spectrum every f_s.", "Require its shifted copies not to overlap."], "workedExample": {"inputs": {"fs_Hz": 8000}, "steps": ["Choose frequencies strictly below 4000 Hz."], "result": "A 4000 Hz zero-phase sine samples to zero; 1000 Hz is within the strict band.", "units": "Hz"}, "limitingCases": ["DC remains representable if the measurement chain preserves it."], "pitfalls": ["A high sample rate alone does not certify bandwidth, clock accuracy or sensor calibration."], "sourceIds": ["freq-numpy-fft", "freq-pywavelets-cwt"], "status": "theorem", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-hann"><data key="title">Periodic Hann analysis window</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-hann", "topicId": "freq-acquisition-estimation", "title": "Periodic Hann analysis window", "latex": "w_j=\\tfrac12[1-\\cos(2\\pi j/N)]", "plain": "Windowing reduces discontinuities in the assumed repeated record, trading spectral leakage against main-lobe width and changing amplitude normalization. The periodic N-denominator form differs from the symmetric N−1 form used in some applications.", "variables": [{"symbol": "w_j", "meaning": "dimensionless discrete window", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "j", "meaning": "time-sample integer index", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "N", "meaning": "number of samples", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "π", "meaning": "circle constant, about 3.141592653589793", "unit": "dimensionless", "kind": "constant"}], "conditions": ["N&gt;1; explicitly periodic window for DFT analysis."], "derivation": ["Combine a constant with one cosine over the record.", "Multiplication in time convolves spectra and changes apparent peak shape."], "workedExample": {"inputs": {"N": 4}, "steps": ["Evaluate j=0,1,2,3."], "result": "[0,0.5,1,0.5]", "units": "dimensionless"}, "limitingCases": ["A rectangular window is the distinct choice w_j=1."], "pitfalls": ["Do not mix symmetric and periodic window calibration constants."], "sourceIds": ["freq-scipy-periodogram", "freq-scipy-welch"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-gain"><data key="title">Coherent window gain</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-gain", "topicId": "freq-acquisition-estimation", "title": "Coherent window gain", "latex": "G=N^{-1}\\sum_{j=0}^{N-1}w_j", "plain": "The mean window weight calibrates a bin-centred coherent tone under the declared transform convention. It is not the same normalization used for broadband noise power, which depends on the sum of squared weights.", "variables": [{"symbol": "G", "meaning": "coherent gain, mean window value", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "N", "meaning": "number of samples", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "w_j", "meaning": "dimensionless discrete window", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "j", "meaning": "time-sample integer index", "unit": "dimensionless", "kind": "scalar"}], "conditions": ["Coherent bin-centred tone; nonzero sum of window values; corresponding amplitude estimator."], "derivation": ["Window a coherent complex tone and evaluate its matching DFT bin.", "All phase terms cancel, leaving the sum of window weights."], "workedExample": {"inputs": {"window": "periodic Hann", "N": 4}, "steps": ["Sum [0,0.5,1,0.5]=2.", "Divide by 4."], "result": "0.5", "units": "dimensionless"}, "limitingCases": ["A rectangular window gives G=1."], "pitfalls": ["For real tone amplitude, also account for the positive/negative-frequency split and DC/Nyquist exceptions."], "sourceIds": ["freq-scipy-periodogram"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-psd"><data key="title">Two-sided windowed periodogram density</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-psd", "topicId": "freq-acquisition-estimation", "title": "Two-sided windowed periodogram density", "latex": "P_k=|\\mathrm{DFT}(w_jx_j)_k|^2/(f_s\\sum_jw_j^2)", "plain": "Power spectral density records signal squared per hertz, rather than signal amplitude or a per-bin power. A one-sided real-data form doubles the positive interior bins, retaining separate DC and Nyquist treatment.", "variables": [{"symbol": "P_k", "meaning": "two-sided displacement spectral-density estimate", "unit": "m² Hz⁻¹", "kind": "scalar"}, {"symbol": "x_j", "meaning": "sampled signal, here displacement for unit illustration", "unit": "m", "kind": "state"}, {"symbol": "w_j", "meaning": "dimensionless discrete window", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "N", "meaning": "number of samples", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "j", "meaning": "time-sample integer index", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "k", "meaning": "DFT integer bin index", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "f_s", "meaning": "sampling rate", "unit": "Hz", "kind": "scalar"}], "conditions": ["Real or complex finite samples; detrending and two-sided convention stated; nonzero window energy.", "For real data, one-sided interior positive-frequency bins are doubled. DC is not doubled; for even N the Nyquist bin is not doubled; for odd N there is no Nyquist endpoint bin."], "derivation": ["Square the windowed transform magnitude.", "Normalize by sample rate and total window-squared weight for density units."], "workedExample": {"inputs": {"unit": "voltage samples in V", "fs_Hz": 1000}, "steps": ["DFT squared has V².", "The denominator contributes Hz."], "result": "PSD unit is V²/Hz; an integrated band has V².", "units": "signal² Hz⁻¹"}, "limitingCases": ["Zero samples produce zero PSD."], "pitfalls": ["A log plot must state its reference and whether it displays amplitude, power or density."], "sourceIds": ["freq-scipy-periodogram", "freq-scipy-welch"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-parseval"><data key="title">DFT energy identity</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">theorem</data><data key="metadata">{"id": "freq-parseval", "topicId": "freq-continuous-discrete", "title": "DFT energy identity", "latex": "\\sum_j|x_j|^2=N^{-1}\\sum_k|X_k|^2", "plain": "Parseval’s finite identity checks normalization by matching the squared norm in sample and DFT coordinates. It is a mathematical identity for this vector; converting it to physical energy still requires sample spacing, impedances and a calibrated channel model.", "variables": [{"symbol": "x_j", "meaning": "sampled signal, here displacement for unit illustration", "unit": "m", "kind": "state"}, {"symbol": "X_k", "meaning": "unscaled forward DFT coefficient", "unit": "m", "kind": "state"}, {"symbol": "N", "meaning": "number of samples", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "j", "meaning": "time-sample integer index", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "k", "meaning": "DFT integer bin index", "unit": "dimensionless", "kind": "scalar"}], "conditions": ["Unscaled forward DFT and 1/N inverse; finite vector."], "derivation": ["Use discrete exponential orthogonality.", "Cross terms vanish except matching sample indices."], "workedExample": {"inputs": {"samples": [1, 0, -1, 0], "DFT": [0, 2, 0, 2]}, "steps": ["Time squared sum=2.", "Frequency squared sum/4=8/4."], "result": "Both sides equal 2.", "units": "signal²"}, "limitingCases": ["The zero vector gives zero on both sides."], "pitfalls": ["Sum of microphone-pressure squared is not automatically joules."], "sourceIds": ["freq-numpy-fft"], "status": "theorem", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-stft"><data key="title">Short-time Fourier transform</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-stft", "topicId": "freq-localized", "title": "Short-time Fourier transform", "latex": "S(\\tau,f)=\\int x(t)w(t-\\tau)e^{-\\mathrm{i}2\\pi ft}\\,dt", "plain": "The STFT measures local spectral content under a chosen window and hop. It shows change across the record but trades temporal localization against frequency discrimination. A bright ridge is conditional on this representation and its calibration.", "variables": [{"symbol": "S(τ,f)", "meaning": "windowed Fourier transform", "unit": "m s", "kind": "operator"}, {"symbol": "x", "meaning": "displacement", "unit": "m", "kind": "coordinate"}, {"symbol": "w(t−τ)", "meaning": "dimensionless continuous analysis window translated to τ", "unit": "dimensionless", "kind": "state"}, {"symbol": "τ", "meaning": "window centre or averaging time as declared locally", "unit": "s", "kind": "coordinate"}, {"symbol": "f", "meaning": "ordinary frequency in cycles per second", "unit": "Hz", "kind": "scalar"}, {"symbol": "t", "meaning": "elapsed time", "unit": "s", "kind": "coordinate"}, {"symbol": "π", "meaning": "circle constant, about 3.141592653589793", "unit": "dimensionless", "kind": "constant"}, {"symbol": "i", "meaning": "imaginary unit satisfying i²=−1; not electric current", "unit": "dimensionless", "kind": "constant"}], "conditions": ["Specified window, overlap/hop, padding, normalization and sampling."], "derivation": ["Multiply by a translated window.", "Transform that local weighted segment and repeat across centre times."], "workedExample": {"inputs": {"window_s": 0.1, "fs_Hz": 10000}, "steps": ["A 1000-sample window spans 0.1 s.", "Its basic frequency grid is 10 Hz before padding."], "result": "100 ms window; 10 Hz grid.", "units": "s and Hz"}, "limitingCases": ["A window covering the full record reduces to one windowed transform."], "pitfalls": ["A smaller hop does not independently improve the window’s frequency resolution."], "sourceIds": ["freq-scipy-stft"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-wavelet"><data key="title">L2-normalized continuous wavelet transform</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">conditional-result</data><data key="metadata">{"id": "freq-wavelet", "topicId": "freq-localized", "title": "L2-normalized continuous wavelet transform", "latex": "W(a,\\tau)=a^{-1/2}\\int x(t)\\psi^*((t-\\tau)/a)\\,dt", "plain": "Wavelet scale stretches a declared mother wavelet. Scale is not automatically hertz; converting it to frequency depends on the wavelet’s centre-frequency convention and sample period. Small sampled scales may alias even when the original input was properly sampled.", "variables": [{"symbol": "W(a,τ)", "meaning": "continuous wavelet coefficient for L2-normalized scale", "unit": "m s^1/2", "kind": "operator"}, {"symbol": "a", "meaning": "positive wavelet scale", "unit": "s", "kind": "scalar"}, {"symbol": "τ", "meaning": "window centre or averaging time as declared locally", "unit": "s", "kind": "coordinate"}, {"symbol": "ψ", "meaning": "dimensionless mother wavelet", "unit": "dimensionless", "kind": "state"}, {"symbol": "x", "meaning": "displacement", "unit": "m", "kind": "coordinate"}, {"symbol": "t", "meaning": "elapsed time", "unit": "s", "kind": "coordinate"}], "conditions": ["a&gt;0; admissible suitable mother wavelet; dimensional scale in seconds here."], "derivation": ["Translate the analysing wavelet in time.", "Stretch it by a and normalize its L2 norm before taking the signal inner product."], "workedExample": {"inputs": {"wavelet_centre_cycles": 1, "scale_s": 0.01}, "steps": ["For this declared centre, divide one cycle by 0.01 s."], "result": "100 Hz pseudo-frequency under this convention.", "units": "coefficient m s^1/2; pseudo-frequency Hz"}, "limitingCases": ["Different mother-wavelet centres give different scale-to-Hz mappings."], "pitfalls": ["Software scales may be dimensionless sample counts; do not reuse a seconds-based formula without conversion."], "sourceIds": ["freq-pywavelets-cwt"], "status": "conditional-result", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-floquet"><data key="title">Floquet factorization of periodic linear dynamics</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">theorem</data><data key="metadata">{"id": "freq-floquet", "topicId": "freq-periodic-combs", "title": "Floquet factorization of periodic linear dynamics", "latex": "U(t)=P(t)e^{Bt},\\quad P(t+T)=P(t)", "plain": "A periodic linear differential equation admits a fundamental-matrix factorization under standard continuity conditions. The eigenvalues of its constant generator describe growth and phase modulo a drive-frequency convention. This is not a general claim that all periodically driven matter has a single frequency.", "variables": [{"symbol": "U(t)", "meaning": "fundamental matrix of linear periodic dynamics", "unit": "dimensionless", "kind": "operator"}, {"symbol": "P(t)", "meaning": "periodic factor of fundamental matrix", "unit": "dimensionless", "kind": "operator"}, {"symbol": "B", "meaning": "constant Floquet generator", "unit": "s⁻¹", "kind": "operator"}, {"symbol": "t", "meaning": "elapsed time", "unit": "s", "kind": "coordinate"}, {"symbol": "T", "meaning": "period of one cycle", "unit": "s", "kind": "scalar"}], "conditions": ["Finite-dimensional complex linear system u′=A(t)u with continuous A(t+T)=A(t), T&gt;0; normalized invertible fundamental matrix U(0)=I; a complex logarithm of its nonsingular monodromy is chosen."], "derivation": ["Propagate over one drive period to form the monodromy matrix.", "Choose a matrix logarithm and remove its exponential evolution to leave a periodic factor."], "workedExample": {"inputs": {"equation": "x′=iωx; coefficients are constant and hence T-periodic"}, "steps": ["Choose P=1 and B=iω."], "result": "U=e^(iωt); quasifrequency is defined modulo 2π/T under branch changes.", "units": "U,P dimensionless; B s⁻¹"}, "limitingCases": ["With zero drive the autonomous solution remains included."], "pitfalls": ["A branch of a logarithm and stability/observable definitions must be declared."], "sourceIds": ["freq-floquet-2026"], "status": "theorem", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-comb"><data key="title">Optical frequency-comb tooth relation</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-comb", "topicId": "freq-periodic-combs", "title": "Optical frequency-comb tooth relation", "latex": "f_n=nf_{rep}+f_{CEO}", "plain": "A stabilized comb links an integer sequence of optical modes to repetition and carrier-envelope-offset frequencies. Its utility requires mode-number identification, controlled offsets and a calibrated reference; the formula alone is not an accurate clock or range measurement.", "variables": [{"symbol": "f", "meaning": "ordinary frequency in cycles per second", "unit": "Hz", "kind": "scalar"}, {"symbol": "n", "meaning": "integer mode or comb index under the local definition", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "f_rep", "meaning": "pulse repetition frequency", "unit": "Hz", "kind": "scalar"}, {"symbol": "f_CEO", "meaning": "carrier-envelope-offset frequency", "unit": "Hz", "kind": "scalar"}], "conditions": ["Comb regime with identifiable mode index and defined offset/repetition references."], "derivation": ["A pulse train supplies equally spaced Fourier components.", "Pulse-to-pulse carrier-envelope slip offsets the entire tooth grid."], "workedExample": {"inputs": {"n": 1000000, "frep_Hz": 100000000, "fCEO_Hz": 20000000}, "steps": ["Multiply mode number by repetition rate and add offset."], "result": "100000020000000", "units": "Hz"}, "limitingCases": ["f_CEO=0 yields an integer repetition-rate grid."], "pitfalls": ["An incorrect tooth number creates an enormous systematic error despite a narrow beat note."], "sourceIds": ["freq-comb-ranging-2026", "freq-thorium-ratio-2024"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-beats"><data key="title">Two-tone beating identity</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-beats", "topicId": "freq-periodic-combs", "title": "Two-tone beating identity", "latex": "\\sin(2\\pi f_1t)+\\sin(2\\pi f_2t)=2\\sin(2\\pi f_ct)\\cos(\\pi\\Delta f t)", "plain": "A pair of monaural tones has a rapid carrier factor and a slowly varying signed factor. The magnitude envelope repeats at the absolute tone separation. This algebra does not model dichotic binaural perception, EEG entrainment or clinical outcomes.", "variables": [{"symbol": "f₁", "meaning": "first tone frequency", "unit": "Hz", "kind": "scalar"}, {"symbol": "f₂", "meaning": "second tone frequency", "unit": "Hz", "kind": "scalar"}, {"symbol": "f_c", "meaning": "midpoint of two tone frequencies", "unit": "Hz", "kind": "scalar"}, {"symbol": "Δf", "meaning": "specified bandwidth or tone separation, as defined locally", "unit": "Hz", "kind": "scalar"}, {"symbol": "t", "meaning": "elapsed time", "unit": "s", "kind": "coordinate"}, {"symbol": "π", "meaning": "circle constant, about 3.141592653589793", "unit": "dimensionless", "kind": "constant"}], "conditions": ["f_c=(f₁+f₂)/2; Δf=f₂−f₁; equal phases/amplitudes in this identity."], "derivation": ["Apply the sine-sum identity.", "Keep carrier frequency and tone separation as distinct observables."], "workedExample": {"inputs": {"tones_Hz": [220, 228]}, "steps": ["Compute centre 224 Hz and separation 8 Hz."], "result": "Signed envelope cos(8πt); magnitude envelope repeats at 8 Hz.", "units": "Hz and dimensionless amplitude factor"}, "limitingCases": ["Equal tones give an unmodulated tone of double amplitude."], "pitfalls": ["The signed cosine factor has frequency |Δf|/2; its absolute envelope has repetition rate |Δf|."], "sourceIds": ["freq-numpy-fft"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-vacuum"><data key="title">Vacuum electromagnetic wavelength</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-vacuum", "topicId": "freq-photon-transition", "title": "Vacuum electromagnetic wavelength", "latex": "\\lambda=c_0/f", "plain": "Frequency converts to wavelength through the propagation law of the declared channel. The exact vacuum speed applies to electromagnetic waves in vacuum. Acoustic frequency needs a sound speed, while a material dispersion relation can make phase and group wavelengths more complicated.", "variables": [{"symbol": "λ", "meaning": "wavelength in the declared medium", "unit": "m", "kind": "scalar"}, {"symbol": "c₀", "meaning": "vacuum speed of light, exactly 299792458", "unit": "m s⁻¹", "kind": "constant"}, {"symbol": "f", "meaning": "ordinary frequency in cycles per second", "unit": "Hz", "kind": "scalar"}], "conditions": ["Vacuum electromagnetic plane wave; f&gt;0."], "derivation": ["Use one-period propagation distance.", "Set λ=c₀T and invert T."], "workedExample": {"inputs": {"f_Hz": 1000000000}, "steps": ["Divide exact c₀ by 10⁹."], "result": "0.299792458", "units": "m"}, "limitingCases": ["At fixed speed, doubling frequency halves wavelength."], "pitfalls": ["Do not use c₀/f for a sound wave in air or a body vibration."], "sourceIds": ["freq-si-brochure"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-photon"><data key="title">Quantum transition and photon energy</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-photon", "topicId": "freq-photon-transition", "title": "Quantum transition and photon energy", "latex": "\\Delta E=hf=\\hbar\\omega", "plain": "A photon or an energy gap associated with a resonant quantum transition relates energy to temporal frequency through Planck’s constant. This does not identify the total energy of a classical acoustic wave from its frequency alone; occupation and amplitude also matter.", "variables": [{"symbol": "E", "meaning": "photon or transition energy difference", "unit": "J", "kind": "scalar"}, {"symbol": "h", "meaning": "Planck constant, exactly 6.62607015e-34", "unit": "J s", "kind": "constant"}, {"symbol": "f", "meaning": "ordinary frequency in cycles per second", "unit": "Hz", "kind": "scalar"}, {"symbol": "ℏ", "meaning": "h/(2π)", "unit": "J s", "kind": "constant"}, {"symbol": "ω", "meaning": "angular frequency", "unit": "rad s⁻¹", "kind": "scalar"}], "conditions": ["Photon energy or specified quantum transition; not arbitrary classical total energy."], "derivation": ["Combine Planck’s relation with ω=2πf and ℏ=h/(2π).", "Check that J·s multiplied by s⁻¹ gives joules."], "workedExample": {"inputs": {"f_Hz": 500000000000000}, "steps": ["Multiply 6.62607015e−34 by 5e14."], "result": "3.313035075e−19", "units": "J"}, "limitingCases": ["Zero frequency gives zero photon energy in this relation, not a nontrivial static photon oscillator."], "pitfalls": ["A classical oscillator has many energy levels/occupations; a high frequency alone is not a high total stored energy."], "sourceIds": ["freq-si-brochure", "freq-thorium-ratio-2024"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-coherence"><data key="title">Lorentzian field-coherence linewidth relation</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">conditional-result</data><data key="metadata">{"id": "freq-coherence", "topicId": "freq-spectroscopy", "title": "Lorentzian field-coherence linewidth relation", "latex": "\\Delta f=1/(\\pi\\tau_c)", "plain": "For a stationary exponentially decaying first-order field correlation, the spectrum is Lorentzian and its full-width-at-half-maximum is reciprocal π times the field-correlation time. Other line shapes or intensity-correlation definitions give different relations.", "variables": [{"symbol": "Δf", "meaning": "specified bandwidth or tone separation, as defined locally", "unit": "Hz", "kind": "scalar"}, {"symbol": "τ_c", "meaning": "first-order field-correlation decay time for declared Lorentzian line", "unit": "s", "kind": "scalar"}, {"symbol": "π", "meaning": "circle constant, about 3.141592653589793", "unit": "dimensionless", "kind": "constant"}], "conditions": ["First-order field correlation proportional to exp(−|t|/τ_c); Lorentzian power spectrum."], "derivation": ["Fourier-transform the two-sided exponential correlation.", "Solve where the resulting Lorentzian is half its zero-offset value."], "workedExample": {"inputs": {"coherence_time_s": 0.001}, "steps": ["Invert π·0.001."], "result": "318.3099", "units": "Hz"}, "limitingCases": ["Longer field coherence narrows the Lorentzian."], "pitfalls": ["Do not substitute an intensity lifetime without checking the factor of two and correlation definition."], "sourceIds": ["freq-feynman-resonance", "freq-numpy-fft"], "status": "conditional-result", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-fractional"><data key="title">Fractional frequency deviation</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-fractional", "topicId": "freq-clock-reference", "title": "Fractional frequency deviation", "latex": "y(t)=[\\nu(t)-\\nu_0]/\\nu_0", "plain": "Fractional frequency compares an oscillator to a specified nominal/reference frequency. It is dimensionless and makes clock comparisons across very different carrier frequencies meaningful, while leaving reference calibration and correlations explicit.", "variables": [{"symbol": "y", "meaning": "fractional frequency deviation", "unit": "dimensionless", "kind": "state"}, {"symbol": "ν", "meaning": "measured oscillator frequency", "unit": "Hz", "kind": "scalar"}, {"symbol": "ν₀", "meaning": "nominal reference frequency", "unit": "Hz", "kind": "scalar"}], "conditions": ["ν₀&gt;0; common time coordinate and declared reference."], "derivation": ["Subtract nominal frequency from observed frequency.", "Normalize by the declared nominal value."], "workedExample": {"inputs": {"nu0_Hz": 10000000, "offset_Hz": 0.001}, "steps": ["Divide 0.001 by 10⁷."], "result": "1e−10", "units": "dimensionless"}, "limitingCases": ["Zero frequency offset yields y=0."], "pitfalls": ["An unstable or drifting reference contributes to the observed difference."], "sourceIds": ["freq-nist-stability"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-allan"><data key="title">Non-overlapping Allan variance estimator</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-allan", "topicId": "freq-stability-inference", "title": "Non-overlapping Allan variance estimator", "latex": "\\sigma_y^2(\\tau)=\\frac{1}{2(M-1)}\\sum_{i=1}^{M-1}(\\bar y_{i+1}-\\bar y_i)^2", "plain": "Allan variance measures changes between adjacent averages rather than deviation from one global mean. The averaging time and noise class are essential. A stability statistic is not by itself a full systematic-uncertainty or accuracy evaluation.", "variables": [{"symbol": "σ_y(τ)", "meaning": "Allan deviation at averaging time τ", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "τ", "meaning": "window centre or averaging time as declared locally", "unit": "s", "kind": "coordinate"}, {"symbol": "ȳ_i", "meaning": "mean fractional frequency in interval i of duration τ", "unit": "dimensionless", "kind": "state"}, {"symbol": "M", "meaning": "number of averaged-frequency observations", "unit": "dimensionless", "kind": "scalar"}], "conditions": ["M≥2 adjacent non-overlapping interval averages of length τ; gaps/dead time and drift treatment stated."], "derivation": ["Compute adjacent averaged-frequency differences.", "Average their squares and divide by two."], "workedExample": {"inputs": {"averages": [0, 1e-06, 0]}, "steps": ["Differences are +1e−6 and −1e−6.", "Squared sum divided by 4 is 5e−13."], "result": "variance=5e−13; deviation≈7.071e−7", "units": "dimensionless"}, "limitingCases": ["A constant fractional offset has zero Allan variance."], "pitfalls": ["That constant offset may still make the clock inaccurate; zero variance does not mean correct time."], "sourceIds": ["freq-nist-stability"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-white-frequency"><data key="title">White-frequency averaging benchmark</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">approximation</data><data key="metadata">{"id": "freq-white-frequency", "topicId": "freq-stability-inference", "title": "White-frequency averaging benchmark", "latex": "\\sigma_y(\\tau)=\\sigma_1\\sqrt{1\\,\\mathrm{s}/\\tau}", "plain": "For white frequency noise and an appropriate measurement process, Allan deviation improves as averaging time to the minus one-half power. Drift, flicker floors, dead time and correlated noise prevent extrapolating this law indefinitely.", "variables": [{"symbol": "σ_y(τ)", "meaning": "Allan deviation at averaging time τ", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "σ₁", "meaning": "white-frequency Allan deviation at τ=1 s", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "τ", "meaning": "window centre or averaging time as declared locally", "unit": "s", "kind": "coordinate"}], "conditions": ["White frequency noise in the assessed averaging range; σ₁ refers to 1 s."], "derivation": ["Average independent fluctuations over more samples.", "Their variance falls inversely with averaging duration, so deviation falls as its square root."], "workedExample": {"inputs": {"sigma_at_1s": 1e-15, "tau_s": 100}, "steps": ["Divide 1e−15 by sqrt(100)."], "result": "1e−16", "units": "dimensionless"}, "limitingCases": ["At τ=1 s recover σ₁."], "pitfalls": ["A plotted slope alone does not prove the underlying noise is white at unmeasured times."], "sourceIds": ["freq-nist-stability"], "status": "approximation", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-redshift"><data key="title">Weak-field gravitational clock shift</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">approximation</data><data key="metadata">{"id": "freq-redshift", "topicId": "freq-clock-reference", "title": "Weak-field gravitational clock shift", "latex": "\\Delta\\nu/\\nu\\simeq g\\Delta h/c_0^2", "plain": "Two otherwise comparable clocks at different gravitational potentials accumulate different proper times. Near Earth in a small static height interval, the higher clock runs faster by approximately gΔh/c₀². This is a conditional relativistic comparison, not motion changing an object’s intrinsic material constant.", "variables": [{"symbol": "ν", "meaning": "measured oscillator frequency", "unit": "Hz", "kind": "scalar"}, {"symbol": "g", "meaning": "local gravitational acceleration", "unit": "m s⁻²", "kind": "scalar"}, {"symbol": "Δh", "meaning": "height difference under weak static-field approximation", "unit": "m", "kind": "scalar"}, {"symbol": "c₀", "meaning": "vacuum speed of light, exactly 299792458", "unit": "m s⁻¹", "kind": "constant"}], "conditions": ["Weak static field; small local vertical interval; potential difference≈gΔh; kinematic terms separately assessed."], "derivation": ["Expand the proper-time ratio to first order in gravitational potential difference/c₀².", "Approximate the local potential difference by gΔh."], "workedExample": {"inputs": {"g_m_s2": 9.81, "height_m": 0.01}, "steps": ["Divide 0.0981 by (299792458)²."], "result": "about 1.0915e−18", "units": "dimensionless"}, "limitingCases": ["Equal potential gives zero gravitational differential under these assumptions."], "pitfalls": ["Height must be tied to a geopotential model for precision work; velocity effects are separate."], "sourceIds": ["freq-si-brochure", "freq-thorium-ratio-2024"], "status": "approximation", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-nuclear-energy"><data key="title">Nuclear-scale optical frequency conversion</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">established-model</data><data key="metadata">{"id": "freq-nuclear-energy", "topicId": "freq-spectroscopy", "title": "Nuclear-scale optical frequency conversion", "latex": "f=E/h", "plain": "The unusually low-energy thorium-229 transition lies in the vacuum-ultraviolet optical range even though the participating states are nuclear. The word nuclear therefore does not by itself specify a gamma-ray frequency, clock performance or a deployed time standard.", "variables": [{"symbol": "f", "meaning": "ordinary frequency in cycles per second", "unit": "Hz", "kind": "scalar"}, {"symbol": "E", "meaning": "photon or transition energy difference", "unit": "J", "kind": "scalar"}, {"symbol": "h", "meaning": "Planck constant, exactly 6.62607015e-34", "unit": "J s", "kind": "constant"}], "conditions": ["An independently measured/assumed transition energy; illustrative value, not a claim of a new precision determination."], "derivation": ["Convert electronvolts to joules using the exact elementary charge.", "Divide transition energy by Planck’s constant."], "workedExample": {"inputs": {"illustrative_energy_eV": 8.4, "e_J_per_eV": 1.602176634e-19}, "steps": ["E=1.34582837256e−18 J.", "Divide by 6.62607015e−34 J·s."], "result": "about 2.0311e15", "units": "Hz"}, "limitingCases": ["Changing the assumed energy changes frequency proportionally."], "pitfalls": ["8.4 eV is a rounded illustration, not the quoted precision of a particular paper."], "sourceIds": ["freq-si-brochure", "freq-thorium-ratio-2024", "freq-nuclear-feedback-2026"], "status": "established-model", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-covariance"><data key="title">First-order uncertainty propagation with covariance</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">approximation</data><data key="metadata">{"id": "freq-covariance", "topicId": "freq-dimensions-units", "title": "First-order uncertainty propagation with covariance", "latex": "C_y\\simeq JCJ^{\\mathsf T}", "plain": "A differentiable map carries input covariance into output covariance through its Jacobian. Correlations can cancel or amplify uncertainty in ratios. This linearization must be checked when distributions, nonlinearity or denominator uncertainty are substantial.", "variables": [{"symbol": "C_y", "meaning": "propagated output covariance matrix", "unit": "specified product of output units", "kind": "tensor"}, {"symbol": "J", "meaning": "Jacobian of derived quantities with respect to inputs", "unit": "output unit/input unit", "kind": "tensor"}, {"symbol": "C", "meaning": "input covariance matrix", "unit": "specified product of input units", "kind": "tensor"}], "conditions": ["Differentiable map near the estimate; small uncertainties; covariance and units declared."], "derivation": ["Linearize the map as δy≈Jδx.", "Take the covariance expectation while retaining cross terms."], "workedExample": {"inputs": {"quantity": "z=x₁−x₂", "each_variance": 1, "covariance": 0.9}, "steps": ["Var(z)=1+1−2·0.9."], "result": "0.2", "units": "input unit squared"}, "limitingCases": ["Perfect common-mode correlation cancels the difference uncertainty in this ideal case."], "pitfalls": ["Independent-error quadrature is wrong when the two channels share a reference."], "sourceIds": ["freq-nist-stability"], "status": "approximation", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-measurement"><data key="title">Source–channel–receiver measurement model</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">conditional-result</data><data key="metadata">{"id": "freq-measurement", "topicId": "freq-transfer-id", "title": "Source–channel–receiver measurement model", "latex": "Y(f)=H(f)X(f)+N(f)", "plain": "A measured spectrum combines the source, propagation/instrument transfer and additive noise. Multiple source/channel pairs can produce the same record. A peak or a learned embedding is therefore not a unique reconstruction of source physics without calibration and constraints.", "variables": [{"symbol": "Y(f)", "meaning": "measured-channel Fourier transform", "unit": "output unit s", "kind": "state"}, {"symbol": "H(f)", "meaning": "calibrated sensor/propagation transfer function", "unit": "specified output/input unit", "kind": "operator"}, {"symbol": "X(f)", "meaning": "continuous Fourier transform of x(t)", "unit": "m s", "kind": "operator"}, {"symbol": "N(f)", "meaning": "Fourier transform of additive measurement noise η(t); not sample-count N", "unit": "output unit s", "kind": "state"}, {"symbol": "f", "meaning": "ordinary frequency in cycles per second", "unit": "Hz", "kind": "scalar"}], "conditions": ["Frequency-domain linear channel within declared bandwidth; noise convention and units stated."], "derivation": ["Model the instrument response as convolution plus additive noise.", "Transform under the compatible Fourier convention."], "workedExample": {"inputs": {"pair_A": "H=2, X=3", "pair_B": "H=3, X=2", "noise": 0}, "steps": ["Both pairs give the same output component 6."], "result": "Output alone cannot distinguish these source/channel amplitudes.", "units": "output unit s"}, "limitingCases": ["At H=0 source components are unobservable through this channel."], "pitfalls": ["Noise is N(f), the transform of η(t), not the sample-count N used in the DFT."], "sourceIds": ["freq-scipy-csd"], "status": "conditional-result", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-rectangular-width"><data key="title">Rectangular interrogation power linewidth</data><data key="kind">formula</data><data key="domain">frequency</data><data key="status">conditional-result</data><data key="metadata">{"id": "freq-rectangular-width", "topicId": "freq-spectroscopy", "title": "Rectangular interrogation power linewidth", "latex": "P(\\Delta f)/P(0)=\\operatorname{sinc}^2(\\pi\\Delta f T),\\quad\\Delta f_{FWHM}\\simeq0.885893/T", "plain": "A finite rectangular coherent interrogation produces a sinc-squared power/excitation profile. Its width comes from interaction duration and is not an intrinsic Lorentzian lifetime.", "variables": [{"symbol": "P(Δf)/P(0)", "meaning": "normalized power or weak-excitation response", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "Δf", "meaning": "detuning from line centre", "unit": "Hz", "kind": "coordinate"}, {"symbol": "T", "meaning": "rectangular coherent interaction duration", "unit": "s", "kind": "scalar"}, {"symbol": "sinc(u)", "meaning": "unnormalized sinc sin(u)/u, with continuous value1 at u=0", "unit": "dimensionless function", "kind": "operator"}, {"symbol": "π", "meaning": "circle constant", "unit": "dimensionless", "kind": "constant"}, {"symbol": "Δf_FWHM", "meaning": "full width between the two half-power points", "unit": "Hz", "kind": "scalar"}], "conditions": ["Constant-amplitude rectangular coherent time window. Power is squared Fourier amplitude; strong-drive Rabi/dephasing/loss effects may require the full excitation model."], "derivation": ["Integrate a complex exponential over a centred interval of durationT to obtain T sin(πΔfT)/(πΔfT).", "Normalize and square the amplitude; solve(sin u/u)^2=1/2 for u≈1.391557, then take the full two-sided detuning width2u/(πT)."], "workedExample": {"inputs": {"interaction_length_m": 0.012, "transport_speed_m_s": 0.016}, "steps": ["T=L/v=.75s.", "Compute0.885893/.75."], "result": "about1.18119Hz, close to the reported1.2Hz source spectrum; not an independent experimental fit", "units": "Hz"}, "limitingCases": ["T→∞ narrows the ideal central lobe; a nonrectangular or incoherent interaction changes the profile."], "pitfalls": ["sinc here is sin(u)/u, not the normalized software sinc sin(πu)/(πu).", "Do not insert this FWHM into the Lorentzian field-coherence formula1/(πτ_c)."], "sourceIds": ["freq-optical-rabi-2026", "freq-scipy-periodogram"], "status": "conditional-result", "kind": "formula", "domain": "frequency"}</data></node><node id="freq-si-brochure"><data key="title">BIPM SI Brochure, 9th edition</data><data key="kind">source</data><data key="domain">frequency</data><data key="status">selected-text</data><data key="metadata">{"id": "freq-si-brochure", "title": "BIPM SI Brochure, 9th edition", "url": "https://www.bipm.org/documents/20126/41483022/SI-Brochure-9.pdf", "authors": "BIPM", "year": 2019, "version": "9th edition; retrieved current PDF revision not independently dated", "kind": "source", "status": "selected-text", "readDepth": "Actual selected passages/sections read; raw capture is not a claim that every page was reviewed.", "sectionsRead": ["English section 2.2 defining constants", "English second definition", "Hz/radian and defining-constant tables"], "claim": "Defines the second through the unperturbed cesium transition, Hz as s−1, and exact h and c.", "limitations": "Definitions are exact; practical realizations, transfer and relativistic corrections retain uncertainty.", "passageKind": "research-note", "note": "Defines the second through the unperturbed cesium transition, Hz as s−1, and exact h and c.", "capture": "docs/field-atlas/sources/frequency/freq-si-brochure.pdf", "sha256": "1122cf38e25b23d780a30607c68f7350b2b6d1f9970a89947aaa87a45ecbb20a", "retrievedAt": "2026-11-25T06:25:04.644261+00:00", "domain": "frequency", "recordKind": "official-data", "sourceKind": "official-data"}</data></node><node id="freq-nist-stability"><data key="title">NIST SP1065 Handbook of Frequency Stability Analysis</data><data key="kind">source</data><data key="domain">frequency</data><data key="status">selected-text</data><data key="metadata">{"id": "freq-nist-stability", "title": "NIST SP1065 Handbook of Frequency Stability Analysis", "url": "https://nvlpubs.nist.gov/nistpubs/Legacy/SP/nistspecialpublication1065.pdf", "authors": "W. J. Riley / NIST", "year": 2008, "version": "NIST SP1065", "kind": "source", "status": "selected-text", "readDepth": "Actual selected passages/sections read; raw capture is not a claim that every page was reviewed.", "sectionsRead": ["Time-domain stability overview", "Allan/overlapping/modified Allan sections and table", "Noise-type and dead-time discussion"], "claim": "Explains frequency stability estimators, adjacent averages, different noise classes and estimator scope.", "limitations": "Selected sections only; handbook predates current clock hardware and does not certify a new device.", "passageKind": "research-note", "note": "Explains frequency stability estimators, adjacent averages, different noise classes and estimator scope.", "capture": "docs/field-atlas/sources/frequency/freq-nist-stability.pdf", "sha256": "ee6bb84554683d718638717651c75f7d487af9e04c168880760ae41a485eb52f", "retrievedAt": "2026-11-25T06:25:04.258107+00:00", "domain": "frequency", "recordKind": "textbook", "sourceKind": "textbook"}</data></node><node id="freq-feynman-oscillator"><data key="title">Feynman Lectures I21: The harmonic oscillator</data><data key="kind">source</data><data key="domain">frequency</data><data key="status">selected-text</data><data key="metadata">{"id": "freq-feynman-oscillator", "title": "Feynman Lectures I21: The harmonic oscillator", "url": "https://www.feynmanlectures.caltech.edu/I_21.html", "authors": "R. P. Feynman, R. B. Leighton, M. Sands", "year": 1963, "version": "Online Volume I chapter21 captured", "kind": "source", "status": "selected-text", "readDepth": "Actual selected passages/sections read; raw capture is not a claim that every page was reviewed.", "sectionsRead": ["21–2 harmonic oscillator equation and cosine solution"], "claim": "Derives linear mass–spring dynamics and distinguishes model coefficients and time units.", "limitations": "Not a universal material-frequency formula; selected section, not the full volume.", "passageKind": "research-note", "note": "Derives linear mass–spring dynamics and distinguishes model coefficients and time units.", "capture": "docs/field-atlas/sources/frequency/freq-feynman-oscillator.html", "sha256": "ccc2a4951db15bb7c2fc8d74fd67f6b745f36d6cd864dfb502c3e7c9acb8deab", "retrievedAt": "2026-11-25T06:24:59.364789+00:00", "domain": "frequency", "recordKind": "textbook", "sourceKind": "textbook"}</data></node><node id="freq-feynman-resonance"><data key="title">Feynman Lectures I23: Resonance</data><data key="kind">source</data><data key="domain">frequency</data><data key="status">selected-text</data><data key="metadata">{"id": "freq-feynman-resonance", "title": "Feynman Lectures I23: Resonance", "url": "https://www.feynmanlectures.caltech.edu/I_23.html", "authors": "R. P. Feynman, R. B. Leighton, M. Sands", "year": 1963, "version": "Online Volume I chapter23 captured", "kind": "source", "status": "selected-text", "readDepth": "Actual selected passages/sections read; raw capture is not a claim that every page was reviewed.", "sectionsRead": ["23–2 forced oscillator with damping", "Complex-response derivation context"], "claim": "Demonstrates finite damped response and the role of complex amplitude/phase.", "limitations": "Notation conflict explicitly translated: chapter uses damping coefficient gamma=b/m; atlas gamma=b/(2m), so gamma_source=2 gamma_atlas.", "passageKind": "research-note", "note": "Demonstrates finite damped response and the role of complex amplitude/phase.", "capture": "docs/field-atlas/sources/frequency/freq-feynman-resonance.html", "sha256": "2123ff1a20246f2c9bb4c7e1a33ba93027d205f9dc2a6026792664bbe050c80c", "retrievedAt": "2026-11-25T06:24:59.217936+00:00", "domain": "frequency", "recordKind": "textbook", "sourceKind": "textbook"}</data></node><node id="freq-scipy-periodogram"><data key="title">SciPy periodogram documentation</data><data key="kind">source</data><data key="domain">frequency</data><data key="status">selected-text</data><data key="metadata">{"id": "freq-scipy-periodogram", "title": "SciPy periodogram documentation", "url": "https://docs.scipy.org/doc/scipy/reference/generated/scipy.signal.periodogram.html", "authors": "SciPy developers", "year": null, "version": "SciPy v1.18.0 live documentation captured", "kind": "source", "status": "selected-text", "readDepth": "Actual selected passages/sections read; raw capture is not a claim that every page was reviewed.", "sectionsRead": ["Parameters", "Notes: spectrum versus density and one-sided conventions"], "claim": "Specifies spectral-density versus squared-spectrum normalization and units.", "limitations": "Documentation describes a software estimator, not proof of physical source identification.", "passageKind": "research-note", "note": "Specifies spectral-density versus squared-spectrum normalization and units.", "capture": "docs/field-atlas/sources/frequency/freq-scipy-periodogram.html", "sha256": "e0e1075b4855619bb48b3ae96161a55caf4a0d77c68f9a5e79361355afd691d7", "retrievedAt": "2026-11-25T06:24:59.225083+00:00", "domain": "frequency", "recordKind": "official-data", "sourceKind": "official-data"}</data></node><node id="freq-scipy-welch"><data key="title">SciPy Welch documentation</data><data key="kind">source</data><data key="domain">frequency</data><data key="status">selected-text</data><data key="metadata">{"id": "freq-scipy-welch", "title": "SciPy Welch documentation", "url": "https://docs.scipy.org/doc/scipy/reference/generated/scipy.signal.welch.html", "authors": "SciPy developers", "year": null, "version": "SciPy v1.18.0 live documentation captured", "kind": "source", "status": "selected-text", "readDepth": "Actual selected passages/sections read; raw capture is not a claim that every page was reviewed.", "sectionsRead": ["Method summary", "Parameters: segment/window/overlap", "Notes"], "claim": "Welch averages modified periodograms from overlapping segments.", "limitations": "Overlapping segments are not fully independent; uncertainty is not supplied merely by the number of plotted segments.", "passageKind": "research-note", "note": "Welch averages modified periodograms from overlapping segments.", "capture": "docs/field-atlas/sources/frequency/freq-scipy-welch.html", "sha256": "e051ac508a3765c4470f3c5e7bbdb79cec462db6968c3dd94a99df92aa824cfb", "retrievedAt": "2026-11-25T06:24:59.160762+00:00", "domain": "frequency", "recordKind": "official-data", "sourceKind": "official-data"}</data></node><node id="freq-scipy-stft"><data key="title">SciPy ShortTimeFFT documentation</data><data key="kind">source</data><data key="domain">frequency</data><data key="status">selected-text</data><data key="metadata">{"id": "freq-scipy-stft", "title": "SciPy ShortTimeFFT documentation", "url": "https://docs.scipy.org/doc/scipy/reference/generated/scipy.signal.ShortTimeFFT.html", "authors": "SciPy developers", "year": null, "version": "SciPy v1.18.0 live documentation captured", "kind": "source", "status": "selected-text", "readDepth": "Actual selected passages/sections read; raw capture is not a claim that every page was reviewed.", "sectionsRead": ["ShortTimeFFT class description", "Hop, window and frequency/time-index conventions"], "claim": "Defines a parametrized windowed transform and inverse with explicit hop and frequency grid.", "limitations": "A representation and software contract; localization/resolution and invertibility depend on the window and sampling.", "passageKind": "research-note", "note": "Defines a parametrized windowed transform and inverse with explicit hop and frequency grid.", "capture": "docs/field-atlas/sources/frequency/freq-scipy-stft.html", "sha256": "e5b9167bac9db052d7d7568f152f5f8e0fcba3c3132668497eeba98b7ed22444", "retrievedAt": "2026-11-25T06:24:59.300401+00:00", "domain": "frequency", "recordKind": "official-data", "sourceKind": "official-data"}</data></node><node id="freq-numpy-fft"><data key="title">NumPy discrete Fourier transform conventions</data><data key="kind">source</data><data key="domain">frequency</data><data key="status">selected-text</data><data key="metadata">{"id": "freq-numpy-fft", "title": "NumPy discrete Fourier transform conventions", "url": "https://numpy.org/doc/stable/reference/routines.fft.html", "authors": "NumPy developers", "year": null, "version": "Stable documentation retrieved 2026-11-25", "kind": "source", "status": "selected-text", "readDepth": "Actual selected passages/sections read; raw capture is not a claim that every page was reviewed.", "sectionsRead": ["DFT definition and inverse normalization", "Standard ordering and Nyquist bins", "Background and normalization"], "claim": "Pins finite-transform sign, normalization and signed frequency ordering.", "limitations": "A finite transform cannot reconstruct an unsampled physical bandwidth without additional assumptions.", "passageKind": "research-note", "note": "Pins finite-transform sign, normalization and signed frequency ordering.", "capture": "docs/field-atlas/sources/frequency/freq-numpy-fft.html", "sha256": "929ecf598038678601dc28089255633661e9ae5c11934911eb87434a79a521fb", "retrievedAt": "2026-11-25T06:24:59.093377+00:00", "domain": "frequency", "recordKind": "official-data", "sourceKind": "official-data"}</data></node><node id="freq-scipy-csd"><data key="title">SciPy cross-spectral density documentation</data><data key="kind">source</data><data key="domain">frequency</data><data key="status">selected-text</data><data key="metadata">{"id": "freq-scipy-csd", "title": "SciPy cross-spectral density documentation", "url": "https://docs.scipy.org/doc/scipy/reference/generated/scipy.signal.csd.html", "authors": "SciPy developers", "year": null, "version": "SciPy v1.18.0 live documentation captured", "kind": "source", "status": "selected-text", "readDepth": "Actual selected passages/sections read; raw capture is not a claim that every page was reviewed.", "sectionsRead": ["Parameters", "Notes: conjugate-X times Y convention"], "claim": "States a cross-spectrum convention useful for transfer estimation.", "limitations": "Cross-spectral correlations alone do not establish a causal pathway or an independently calibrated transfer function.", "passageKind": "research-note", "note": "States a cross-spectrum convention useful for transfer estimation.", "capture": "docs/field-atlas/sources/frequency/freq-scipy-csd.html", "sha256": "864263a253a74f309466a7de31f20cd805fc4c809fbd9d236cb9b30aae730fee", "retrievedAt": "2026-11-25T06:24:59.352715+00:00", "domain": "frequency", "recordKind": "official-data", "sourceKind": "official-data"}</data></node><node id="freq-pywavelets-cwt"><data key="title">PyWavelets continuous wavelet transform documentation</data><data key="kind">source</data><data key="domain">frequency</data><data key="status">selected-text</data><data key="metadata">{"id": "freq-pywavelets-cwt", "title": "PyWavelets continuous wavelet transform documentation", "url": "https://pywavelets.readthedocs.io/en/latest/ref/cwt.html", "authors": "PyWavelets developers", "year": null, "version": "Latest documentation captured 2026-11-25", "kind": "source", "status": "selected-text", "readDepth": "Actual selected passages/sections read; raw capture is not a claim that every page was reviewed.", "sectionsRead": ["CWT parameters", "Scale-to-frequency conversion", "Small-scale aliasing example"], "claim": "Explains wavelet-dependent scale/frequency conversion and warns that low sampled scales can alias.", "limitations": "Continuous seconds-based and software sample-based scale conventions differ; output units and normalization must be translated.", "passageKind": "research-note", "note": "Explains wavelet-dependent scale/frequency conversion and warns that low sampled scales can alias.", "capture": "docs/field-atlas/sources/frequency/freq-pywavelets-cwt.html", "sha256": "cec7247bb827c6a53ff619909bda8362cce95dcc1784a5aa96bd78e1be02f3ab", "retrievedAt": "2026-11-25T06:24:59.523912+00:00", "domain": "frequency", "recordKind": "official-data", "sourceKind": "official-data"}</data></node><node id="freq-sympy-laplace"><data key="title">SymPy integral transforms documentation</data><data key="kind">source</data><data key="domain">frequency</data><data key="status">selected-text</data><data key="metadata">{"id": "freq-sympy-laplace", "title": "SymPy integral transforms documentation", "url": "https://docs.sympy.org/latest/modules/integrals/integrals.html", "authors": "SymPy developers", "year": null, "version": "Latest documentation captured 2026-11-25", "kind": "source", "status": "selected-text", "readDepth": "Actual selected passages/sections read; raw capture is not a claim that every page was reviewed.", "sectionsRead": ["Integral transform conventions", "Laplace transform and convergence-condition interface"], "claim": "Transforms include convergence information rather than only an algebraic expression.", "limitations": "No symbolic software result was executed here; formulas and regions are derived separately.", "passageKind": "research-note", "note": "Transforms include convergence information rather than only an algebraic expression.", "capture": "docs/field-atlas/sources/frequency/freq-sympy-laplace.html", "sha256": "677f463e032b302b8bced2d3ed69abbf6c559fa2df098fa5b9b52e4e40ccfa0d", "retrievedAt": "2026-11-25T06:24:59.901236+00:00", "domain": "frequency", "recordKind": "official-data", "sourceKind": "official-data"}</data></node><node id="freq-thorium-ratio-2024"><data key="title">Frequency ratio of the 229mTh nuclear isomeric transition and the 87Sr atomic clock</data><data key="kind">source</data><data key="domain">frequency</data><data key="status">abstract-only</data><data key="metadata">{"id": "freq-thorium-ratio-2024", "title": "Frequency ratio of the 229mTh nuclear isomeric transition and the 87Sr atomic clock", "url": "https://www.nature.com/articles/s41586-024-07839-6", "authors": "C. Zhang et al.", "year": 2024, "version": "Nature published 2024-09-04; abstract/figure-caption page only", "kind": "source", "status": "abstract-only", "readDepth": "Actual selected passages/sections read; raw capture is not a claim that every page was reviewed.", "sectionsRead": ["Abstract", "Visible figure captions", "Access boundary"], "claim": "Reports VUV-comb linkage of thorium nuclear and strontium electronic transitions, with a frequency-ratio measurement.", "limitations": "Publisher page explicitly exposes subscription preview only; methods, full paper and experimental data were not read.", "passageKind": "research-note", "note": "Reports VUV-comb linkage of thorium nuclear and strontium electronic transitions, with a frequency-ratio measurement.", "capture": "docs/field-atlas/sources/frequency/freq-thorium-ratio-2024.html", "sha256": "6d4311a7f18414557306ef49cda5148f3bdedd568bbc2d99b659061360728d72", "retrievedAt": "2026-11-25T06:25:02.120168+00:00", "domain": "frequency", "recordKind": "primary-paper", "sourceKind": "primary-paper"}</data></node><node id="freq-nuclear-feedback-2026"><data key="title">A thorium-229 optical nuclear clock with feedback loop</data><data key="kind">source</data><data key="domain">frequency</data><data key="status">selected-text</data><data key="metadata">{"id": "freq-nuclear-feedback-2026", "title": "A thorium-229 optical nuclear clock with feedback loop", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC13686927/", "authors": ["L Toscani De Col", "T Riebner", "I Morawetz", "F Schneider", "N Sempelmann", "J Schlachet-Lépinay", "F Schaden", "M Bartokos", "G A Kazakov", "K Beeks", "B Gerstenecker", "M Pimon", "S Lahs", "A Hellerschmied", "T Lercher", "H Denker", "J Premper", "A Niessner", "M Matus", "M Čížek", "O Číp", "V Lal", "G Zitzer", "V Petrov", "J Tiedau", "M V Okhapkin", "E Peik", "T Schumm"], "year": 2026, "version": "Published 2026-10-07; full XML captured", "kind": "source", "status": "selected-text", "readDepth": "Abstract/initial sections plus the explicitly listed Round2 body sections actually read; no complete experimental reanalysis or independent replication.", "sectionsRead": ["Abstract", "Introductory clock-comparison discussion", "Round2 body: Clock operation", "Round2 body: Clock performance", "Round2 body: Prospects for future solid-state 229Th nuclear clocks"], "claim": "Reports absorption-based nuclear-transition feedback; body distinguishes improved within-run stability from about5×10^−13 between-day reproducibility and crystal-position-dependent line centres.", "limitations": "Clock performance section reports shifts up to1.7kHz between probed crystal regions; host strain is a proposed explanation. Improved future linewidth/power projections are not demonstrated clock accuracy. No independent systematic-budget reconstruction.", "passageKind": "research-note", "note": "Reports stabilization of a cw laser to a solid-host thorium nuclear transition with a feedback loop and comparison to a Yb+ reference.", "capture": "docs/field-atlas/sources/frequency/freq-nuclear-feedback-2026.xml", "sha256": "0cbb41d71784149f8c61fe12c0dbfde1afc297b779c5f767dc161728dd0c8216", "retrievedAt": "2026-11-25T06:26:24.132776+00:00", "domain": "frequency", "recordKind": "primary-paper", "sourceKind": "primary-paper"}</data></node><node id="freq-optical-rabi-2026"><data key="title">Spatially defined Rabi spectroscopy for uninterrupted optical clock interrogation</data><data key="kind">source</data><data key="domain">frequency</data><data key="status">selected-text</data><data key="metadata">{"id": "freq-optical-rabi-2026", "title": "Spatially defined Rabi spectroscopy for uninterrupted optical clock interrogation", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC13448705/", "authors": ["Koki Nishida", "Ryoto Takeuchi", "Shigenori Tsuji", "Shoichi Okaba", "Hidetoshi Katori"], "year": 2026, "version": "Published 2026-08-06; full XML captured", "kind": "source", "status": "selected-text", "readDepth": "Abstract/initial sections plus the explicitly listed Round2 body sections actually read; no complete experimental reanalysis or independent replication.", "sectionsRead": ["Abstract", "Conclusion", "Opening methods context", "Round2 body: Clock spectroscopy with Fourier-limited resolution", "Round2 body: Discussion", "Round2 body: BBR shift"], "claim": "Reports1.2Hz FWHM excitation spectrum with0.75s transit through a12mm region at16mm/s; body identifies a rectangular-interaction Fourier width and retains cooling-light and BBR-shift effects.", "limitations": "A finite-time Rabi excitation line is not a Lorentzian intrinsic lifetime. Discussion treats dead-time-free closed-loop stabilization as future work; BBR estimate uses approximate emissivity/area weighting and later thermometry, not a complete simultaneous accuracy certification.", "passageKind": "research-note", "note": "Reports spatially defined Rabi spectroscopy of continuously transported strontium and a 1.2Hz-wide spectrum.", "capture": "docs/field-atlas/sources/frequency/freq-optical-rabi-2026.xml", "sha256": "efa8a7a3a89c14319ad3b39878903482f5a6afc8a751ab466e0998f91b4554b4", "retrievedAt": "2026-11-25T06:26:24.199854+00:00", "domain": "frequency", "recordKind": "primary-paper", "sourceKind": "primary-paper"}</data></node><node id="freq-comb-ranging-2026"><data key="title">A Ranging System Integrating Time‐of‐Flight Approach With Optical‐Frequency‐Comb Interferometry for Ultra‐Precise Long‐Distance Measurements</data><data key="kind">source</data><data key="domain">frequency</data><data key="status">selected-text</data><data key="metadata">{"id": "freq-comb-ranging-2026", "title": "A Ranging System Integrating Time‐of‐Flight Approach With Optical‐Frequency‐Comb Interferometry for Ultra‐Precise Long‐Distance Measurements", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC13755749/", "authors": ["Cunliang Yang", "Xiao Wang", "Zihao Zhang", "Junhao Li", "Jingjing Wang", "Jinman Ge", "Lizhong Xiao", "Jijun Feng"], "year": 2026, "version": "Published 2026-11-11; full XML captured", "kind": "source", "status": "selected-text", "readDepth": "Actual selected passages/sections read; raw capture is not a claim that every page was reviewed.", "sectionsRead": ["Abstract", "Conclusions"], "claim": "Combines coarse time-of-flight and fine comb interferometry for absolute ranging.", "limitations": "Reported apparatus-specific distance errors are not independently reanalysed, and air-index/reference uncertainties are not resolved by citing the comb equation.", "passageKind": "research-note", "note": "Combines coarse time-of-flight and fine comb interferometry for absolute ranging.", "capture": "docs/field-atlas/sources/frequency/freq-comb-ranging-2026.xml", "sha256": "481871db49e098f34ad6ad27556fb1dc2634bf6783960fb64091d1a9daff4888", "retrievedAt": "2026-11-25T06:26:22.133201+00:00", "domain": "frequency", "recordKind": "primary-paper", "sourceKind": "primary-paper"}</data></node><n