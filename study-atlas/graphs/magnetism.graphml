<graphml xmlns="http://graphml.graphdrawing.org/xmlns"><key id="title" for="all" attr.name="title" attr.type="string" /><key id="kind" for="all" attr.name="kind" attr.type="string" /><key id="domain" for="all" attr.name="domain" attr.type="string" /><key id="relation" for="all" attr.name="relation" attr.type="string" /><key id="label" for="all" attr.name="label" attr.type="string" /><key id="status" for="all" attr.name="status" attr.type="string" /><key id="metadata" for="all" attr.name="metadata" attr.type="string" /><graph id="field-atlas" edgedefault="directed"><node id="mag-root"><data key="title">Magnetism: fields, matter and controlled inference</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-root", "title": "Magnetism: fields, matter and controlled inference", "parentId": null, "level": 0, "summary": "A multiscale map from current-generated fields to quantum materials, spin transport and calibrated measurement. Physical mechanisms and evidence status remain separate.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-energy"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-classical"><data key="title">Classical magnetic fields</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-classical", "title": "Classical magnetic fields", "parentId": "mag-root", "level": 1, "summary": "Currents, flux continuity, potentials and boundary-value problems.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-dynamics"><data key="title">Induction and electromagnetic energy</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-dynamics", "title": "Induction and electromagnetic energy", "parentId": "mag-root", "level": 1, "summary": "Time-dependent fields, motional circuits, local energy transfer and passive device budgets.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-materials"><data key="title">Magnetic order and material response</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-materials", "title": "Magnetic order and material response", "parentId": "mag-root", "level": 1, "summary": "Response functions and microscopic interactions connect atomic moments to domains and phases.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-lowdim"><data key="title">Low-dimensional and moiré magnets</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-lowdim", "title": "Low-dimensional and moiré magnets", "parentId": "mag-root", "level": 1, "summary": "Dimensionality, anisotropy, stacking and correlations control order and textures.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-spintronics"><data key="title">Spin transport and magnetic dynamics</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-spintronics", "title": "Spin transport and magnetic dynamics", "parentId": "mag-root", "level": 1, "summary": "Angular momentum transfer, resonances, textures and wave-based information processing.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-superconduct"><data key="title">Superconducting magnetic response</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-superconduct", "title": "Superconducting magnetic response", "parentId": "mag-root", "level": 1, "summary": "Equilibrium flux exclusion, screening currents, vortices and critical scales.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-coupled"><data key="title">Magnetoelectric and hybrid systems</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-coupled", "title": "Magnetoelectric and hybrid systems", "parentId": "mag-root", "level": 1, "summary": "Cross responses need conjugate variables, symmetry and an external energy supply.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-metrology"><data key="title">Magnetometry and inverse inference</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-metrology", "title": "Magnetometry and inverse inference", "parentId": "mag-root", "level": 1, "summary": "Measurements require channel models, geometry, calibration and identifiable source parameters.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-computation"><data key="title">Computational magnetism</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-computation", "title": "Computational magnetism", "parentId": "mag-root", "level": 1, "summary": "Discretization, energy functionals, verification, uncertainty and reproducibility.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-fields"><data key="title">Flux density and field intensity</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-fields", "title": "Flux density and field intensity", "parentId": "mag-classical", "level": 2, "summary": "B describes magnetic induction; H separates free current from macroscopic magnetization. Neither can be replaced by the other without a constitutive statement.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-energy", "mag-src-mit-vector", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-gauss", "mag-f-bh"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-sources"><data key="title">Current distributions</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-sources", "title": "Current distributions", "parentId": "mag-fields", "level": 3, "summary": "Line, surface and volume current idealizations have different supports and units.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-steady"><data key="title">Steady current kernels</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-steady", "title": "Steady current kernels", "parentId": "mag-sources", "level": 4, "summary": "Magnetostatics assumes stationary sources with consistent return currents.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-biot"><data key="title">Biot–Savart reconstruction</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-biot", "title": "Biot–Savart reconstruction", "parentId": "mag-steady", "level": 5, "summary": "The vector kernel weights each source element by orientation and distance; near-wire singularities reveal the idealization.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-vector", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-biot"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-wire"><data key="title">Straight-wire symmetry</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-wire", "title": "Straight-wire symmetry", "parentId": "mag-biot", "level": 6, "summary": "An infinitely long thin wire permits a closed-form azimuthal field; finite leads break that symmetry.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-vector", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-wire"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-loop"><data key="title">Current-loop geometry</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-loop", "title": "Current-loop geometry", "parentId": "mag-biot", "level": 6, "summary": "Axial loop fields provide a controlled route from a finite circuit to the far-field dipole.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-vector", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-loop"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-ampere"><data key="title">Ampèrian integral methods</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-ampere", "title": "Ampèrian integral methods", "parentId": "mag-steady", "level": 5, "summary": "An integral law is always valid in its domain but solves a field only when symmetry controls the integrand.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-vector", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-ampere"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-solenoid"><data key="title">Solenoids and return flux</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-solenoid", "title": "Solenoids and return flux", "parentId": "mag-ampere", "level": 6, "summary": "Long-coil interior estimates omit fringe fields and winding resistance.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-vector", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-solenoid"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-potential"><data key="title">Vector potential and gauge</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-potential", "title": "Vector potential and gauge", "parentId": "mag-fields", "level": 3, "summary": "A curl representation enforces flux continuity; gauge choice does not change B.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-dipoles"><data key="title">Magnetic dipoles and force</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-dipoles", "title": "Magnetic dipoles and force", "parentId": "mag-classical", "level": 2, "summary": "Dipole approximations require source-target separation large relative to source extent.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-energy", "mag-src-mit-vector", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-dipole", "mag-f-torque", "mag-f-force"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-bound"><data key="title">Bound versus free current</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-bound", "title": "Bound versus free current", "parentId": "mag-fields", "level": 3, "summary": "Magnetization produces volume curl and surface cross-product currents; classifications depend on material coarse graining.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-energy", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-bound-volume", "mag-f-bound-surface"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-boundary"><data key="title">Interface boundary conditions</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-boundary", "title": "Interface boundary conditions", "parentId": "mag-fields", "level": 3, "summary": "Normal B continuity and tangential H jumps encode flux conservation and free surface current.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-faraday"><data key="title">Faraday induction</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-faraday", "title": "Faraday induction", "parentId": "mag-dynamics", "level": 2, "summary": "Changing flux and moving material circuits contribute to the same oriented emf.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-induction", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-flux"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-moving"><data key="title">Motional electromagnetic circuits</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-moving", "title": "Motional electromagnetic circuits", "parentId": "mag-faraday", "level": 3, "summary": "The velocity in a circuit emf is the velocity of the material boundary, not a guessed wave velocity.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-induction", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-faraday"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-maxwell"><data key="title">Displacement current</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-maxwell", "title": "Displacement current", "parentId": "mag-dynamics", "level": 2, "summary": "A changing electric displacement repairs continuity and enables waves; quasistatics needs a scale argument.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-energy", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-maxwell"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-energy"><data key="title">Local energy accounting</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-energy", "title": "Local energy accounting", "parentId": "mag-dynamics", "level": 2, "summary": "Poynting flux, storage and mechanical/Joule work identify where supplied energy goes.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-energy", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-poynting", "mag-f-density"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-passivity"><data key="title">Passive ports and finite time</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-passivity", "title": "Passive ports and finite time", "parentId": "mag-energy", "level": 3, "summary": "Initial stored energy and all powered auxiliary ports belong in a finite-window budget.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-energy", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-inductor"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-hysteresis"><data key="title">Hysteretic losses</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-hysteresis", "title": "Hysteretic losses", "parentId": "mag-energy", "level": 3, "summary": "A loop measures cycle work only for declared field variables, sample volume and measurement conditions.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-energy", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-hysteresis"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-skin"><data key="title">Eddy currents and skin effect</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-skin", "title": "Eddy currents and skin effect", "parentId": "mag-dynamics", "level": 2, "summary": "Diffusion and conductive loss can shift response peaks without adding an energy source.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-response"><data key="title">Macroscopic susceptibility</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-response", "title": "Macroscopic susceptibility", "parentId": "mag-materials", "level": 2, "summary": "A scalar constant susceptibility is a restricted linear, reversible approximation.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-demag"><data key="title">Demagnetizing fields</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-demag", "title": "Demagnetizing fields", "parentId": "mag-response", "level": 3, "summary": "Applied and internal fields differ; ellipsoids supply a special uniform-field solution.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-energy", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-demag"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-paramag"><data key="title">Thermal paramagnetism</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-paramag", "title": "Thermal paramagnetism", "parentId": "mag-response", "level": 3, "summary": "Independent moments give a high-temperature weak-field Curie law, not a universal low-temperature law.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax", "mag-src-tong-phase"], "prerequisites": [], "formulaIds": ["mag-f-curie"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-exchange"><data key="title">Microscopic exchange</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-exchange", "title": "Microscopic exchange", "parentId": "mag-materials", "level": 2, "summary": "An effective spin Hamiltonian represents electronic exchange after model reduction.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax", "mag-src-qsl"], "prerequisites": [], "formulaIds": ["mag-f-heisenberg"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-ordered"><data key="title">Ordered phases</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-ordered", "title": "Ordered phases", "parentId": "mag-exchange", "level": 3, "summary": "An order parameter and symmetry specify a phase more precisely than the presence of a magnetic signal.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-ferro"><data key="title">Ferromagnetism</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-ferro", "title": "Ferromagnetism", "parentId": "mag-ordered", "level": 4, "summary": "Parallel order can form domains that hide a large local moment behind small net magnetization.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-domains"><data key="title">Domains and walls</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-domains", "title": "Domains and walls", "parentId": "mag-ferro", "level": 5, "summary": "Exchange, anisotropy and magnetostatics compete to set walls and domain patterns.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-wallwidth"><data key="title">Continuum wall profiles</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-wallwidth", "title": "Continuum wall profiles", "parentId": "mag-domains", "level": 6, "summary": "A one-dimensional wall width follows from a specific functional and boundary states.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-wall"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-afm"><data key="title">Antiferromagnetism</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-afm", "title": "Antiferromagnetism", "parentId": "mag-ordered", "level": 4, "summary": "Opposing sublattice moments require a Néel order parameter, not just net M.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-ferri"><data key="title">Ferrimagnetism and compensation</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-ferri", "title": "Ferrimagnetism and compensation", "parentId": "mag-ordered", "level": 4, "summary": "Unequal sublattices can compensate net magnetization or angular momentum at different temperatures.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-frustration"><data key="title">Frustrated interactions</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-frustration", "title": "Frustrated interactions", "parentId": "mag-exchange", "level": 3, "summary": "Not all preferred pairwise alignments can be simultaneously realized on a frustrated lattice.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax", "mag-src-qsl"], "prerequisites": [], "formulaIds": ["mag-f-triangle"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-qsl"><data key="title">Quantum spin liquids</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-qsl", "title": "Quantum spin liquids", "parentId": "mag-frustration", "level": 4, "summary": "Absence of conventional order alone is insufficient; competing states and disorder must be tested.", "coverage": "mapped", "sourceIds": ["mag-src-mumax", "mag-src-qsl"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-altermagnets"><data key="title">Altermagnetic symmetry</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-altermagnets", "title": "Altermagnetic symmetry", "parentId": "mag-ordered", "level": 4, "summary": "Some compensated collinear orders allow momentum-dependent nonrelativistic spin splitting.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-ruo2"><data key="title">Material-specific RuO2 controversy</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-ruo2", "title": "Material-specific RuO2 controversy", "parentId": "mag-altermagnets", "level": 5, "summary": "Bulk magnetic order, thin-film structure, spin/orbital conversion and interfacial effects are separate claims.", "coverage": "mapped", "sourceIds": ["mag-src-mumax", "mag-src-ruo2-null", "mag-src-ruo2-2026"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-critical"><data key="title">Criticality and finite-size scaling</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-critical", "title": "Criticality and finite-size scaling", "parentId": "mag-ordered", "level": 4, "summary": "Apparent transitions in finite systems require size, dimensionality and dynamical-time analysis.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax", "mag-src-qsl", "mag-src-tong-phase"], "prerequisites": [], "formulaIds": ["mag-f-cw"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-2d"><data key="title">Two-dimensional order</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-2d", "title": "Two-dimensional order", "parentId": "mag-lowdim", "level": 2, "summary": "Continuous spin symmetry and short-range interactions restrict finite-temperature order; anisotropy changes the premises.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-vdw"><data key="title">van der Waals layers</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-vdw", "title": "van der Waals layers", "parentId": "mag-2d", "level": 3, "summary": "Weak interlayer bonding permits assembly but does not make exchange or disorder negligible.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-twist"><data key="title">Twist and stacking</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-twist", "title": "Twist and stacking", "parentId": "mag-vdw", "level": 4, "summary": "Twist changes local registry and therefore exchange, anisotropy and relaxation.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-moirecells"><data key="title">Moiré supercell phase coexistence</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-moirecells", "title": "Moiré supercell phase coexistence", "parentId": "mag-twist", "level": 5, "summary": "Spatially separated local phases and transition scales need resolved measurement rather than one averaged moment.", "coverage": "mapped", "sourceIds": ["mag-src-mumax", "mag-src-moire"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-gating"><data key="title">Electrostatic tuning of magnets</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-gating", "title": "Electrostatic tuning of magnets", "parentId": "mag-vdw", "level": 4, "summary": "A gate can alter carriers, electric field and strain; these mechanisms must be discriminated.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-valley"><data key="title">Spin–valley correlations</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-valley", "title": "Spin–valley correlations", "parentId": "mag-lowdim", "level": 2, "summary": "Valley labels are electronic momentum-space degrees of freedom, not real-space locations.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-graphene"><data key="title">Magnetic parent states and pairing</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-graphene", "title": "Magnetic parent states and pairing", "parentId": "mag-valley", "level": 3, "summary": "Field-enhanced superconductivity and valley imbalance constrain mechanisms without proving one unique pairing theory.", "coverage": "mapped", "sourceIds": ["mag-src-mumax", "mag-src-moire-2026"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-llg"><data key="title">Magnetization dynamics</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-llg", "title": "Magnetization dynamics", "parentId": "mag-spintronics", "level": 2, "summary": "The sign convention for gyromagnetic ratio and choice of B or H must be explicit.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-llg"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-resonance"><data key="title">Ferromagnetic resonance</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-resonance", "title": "Ferromagnetic resonance", "parentId": "mag-llg", "level": 3, "summary": "A resonance depends on effective-field curvature, damping, geometry and drive/readout channels.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-kittel"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-magnonics"><data key="title">Magnonics</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-magnonics", "title": "Magnonics", "parentId": "mag-resonance", "level": 4, "summary": "Spin waves carry energy and angular momentum; excitation, propagation and detection losses remain.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-spinwave"><data key="title">Exchange-dominated dispersion</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-spinwave", "title": "Exchange-dominated dispersion", "parentId": "mag-magnonics", "level": 5, "summary": "A quadratic wavevector term is a limiting continuum result, not every film mode dispersion.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-magnon"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-transport"><data key="title">Spin and orbital transport</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-transport", "title": "Spin and orbital transport", "parentId": "mag-spintronics", "level": 2, "summary": "Spin, orbital and charge currents have distinct units and conversion mechanisms.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-spinHall"><data key="title">Spin Hall conversion</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-spinHall", "title": "Spin Hall conversion", "parentId": "mag-transport", "level": 3, "summary": "A conversion angle is defined only after specifying current normalization and geometry.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax", "mag-src-ruo2-2026"], "prerequisites": [], "formulaIds": ["mag-f-spin-hall"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-sot"><data key="title">Spin–orbit torque switching</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-sot", "title": "Spin–orbit torque switching", "parentId": "mag-spinHall", "level": 4, "summary": "Coherent torque, heating and field-induced switching require separate controls.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax", "mag-src-sot"], "prerequisites": [], "formulaIds": ["mag-f-sot"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-textures"><data key="title">Chiral textures</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-textures", "title": "Chiral textures", "parentId": "mag-spintronics", "level": 2, "summary": "DMI, exchange, anisotropy and dipolar energy stabilize or destabilize different textures.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-skyrmions"><data key="title">Skyrmions and topological charge</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-skyrmions", "title": "Skyrmions and topological charge", "parentId": "mag-textures", "level": 3, "summary": "A continuum integer invariant requires smoothness and a compactified or fixed boundary.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax", "mag-src-skyrmion"], "prerequisites": [], "formulaIds": ["mag-f-topology"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-opticalwriting"><data key="title">Optical writing of magnetic textures</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-opticalwriting", "title": "Optical writing of magnetic textures", "parentId": "mag-skyrmions", "level": 4, "summary": "Laser pulses are an external energy input; field-free is not energy-free.", "coverage": "mapped", "sourceIds": ["mag-src-mumax", "mag-src-skyrmion"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-antiferrodynamics"><data key="title">Ultrafast Néel dynamics</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-antiferrodynamics", "title": "Ultrafast Néel dynamics", "parentId": "mag-llg", "level": 3, "summary": "Two-sublattice exchange gives dynamics not captured by a single ferromagnetic macrospin.", "coverage": "mapped", "sourceIds": ["mag-src-mumax", "mag-src-sot"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-meissner"><data key="title">Meissner equilibrium response</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-meissner", "title": "Meissner equilibrium response", "parentId": "mag-superconduct", "level": 2, "summary": "Equilibrium flux expulsion differs from frozen flux in an ideal perfect conductor.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-london"><data key="title">London screening</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-london", "title": "London screening", "parentId": "mag-meissner", "level": 3, "summary": "A local homogeneous superfluid model gives exponential screening only in a stated geometry.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-induction", "mag-src-mit-london", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-london"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-fluxoid"><data key="title">Fluxoid and phase winding</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-fluxoid", "title": "Fluxoid and phase winding", "parentId": "mag-meissner", "level": 3, "summary": "Phase single-valuedness constrains a fluxoid; magnetic flux alone needs additional limits.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-fluxoid", "mag-src-mumax", "mag-src-nist"], "prerequisites": [], "formulaIds": ["mag-f-fluxquantum"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-vortices"><data key="title">Type-II vortices</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-vortices", "title": "Type-II vortices", "parentId": "mag-superconduct", "level": 2, "summary": "Vortex cores, penetration depth and sample geometry distinguish lower and upper critical fields.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-gl"><data key="title">Ginzburg–Landau description</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-gl", "title": "Ginzburg–Landau description", "parentId": "mag-vortices", "level": 3, "summary": "A coarse-grained order parameter has a controlled near-transition regime, not unrestricted microscopic authority.", "coverage": "reviewed", "sourceIds": ["mag-src-mit-fluxoid", "mag-src-moire-2026", "mag-src-mumax", "mag-src-tong-phase"], "prerequisites": [], "formulaIds": ["mag-f-gl"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-mixed"><data key="title">Magnet–superconductor hybrids</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-mixed", "title": "Magnet–superconductor hybrids", "parentId": "mag-superconduct", "level": 2, "summary": "Stray fields, screening, proximity and dissipation couple distinct subsystems.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-thermodynamics"><data key="title">Cross-response thermodynamics</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-thermodynamics", "title": "Cross-response thermodynamics", "parentId": "mag-coupled", "level": 2, "summary": "A derivative with respect to H differs by permeability factors from one with respect to B.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-magnetoelectric"><data key="title">Linear magnetoelectric tensor</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-magnetoelectric", "title": "Linear magnetoelectric tensor", "parentId": "mag-thermodynamics", "level": 3, "summary": "Symmetry and chosen thermodynamic potential determine allowed reciprocal cross responses.", "coverage": "reviewed", "sourceIds": ["mag-src-magnetoelectric", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-me"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-bilayer"><data key="title">Layer-resolved orbital response</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-bilayer", "title": "Layer-resolved orbital response", "parentId": "mag-magnetoelectric", "level": 4, "summary": "A bilayer layer-pseudospin response is not automatically the bulk SI magnetoelectric coefficient.", "coverage": "mapped", "sourceIds": ["mag-src-mumax", "mag-src-magnetoelectric"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-magnetostriction"><data key="title">Magnetoelastic transduction</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-magnetostriction", "title": "Magnetoelastic transduction", "parentId": "mag-coupled", "level": 2, "summary": "Changing strain can modify anisotropy; external electrical/mechanical work remains in the budget.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-hybrid"><data key="title">Cavity and resonator hybrids</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-hybrid", "title": "Cavity and resonator hybrids", "parentId": "mag-coupled", "level": 2, "summary": "Avoided crossing alone does not establish a useful autonomous energy source or quantum advantage.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-sensors"><data key="title">Sensor transfer functions</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-sensors", "title": "Sensor transfer functions", "parentId": "mag-metrology", "level": 2, "summary": "A magnetometer produces a calibrated channel with finite bandwidth, orientation and noise.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-nv"><data key="title">NV-center magnetometry</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-nv", "title": "NV-center magnetometry", "parentId": "mag-sensors", "level": 3, "summary": "Zeeman shifts depend on the projection along a known crystallographic axis and the applicable spin Hamiltonian.", "coverage": "reviewed", "sourceIds": ["mag-src-inverse-nv", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-nv"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-hall"><data key="title">Hall and inductive probes</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-hall", "title": "Hall and inductive probes", "parentId": "mag-sensors", "level": 3, "summary": "Hall voltage and pickup-coil emf measure different functions of the same field history.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-uncertainty"><data key="title">Measurement uncertainty</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-uncertainty", "title": "Measurement uncertainty", "parentId": "mag-sensors", "level": 3, "summary": "Calibration, correlation, geometry and drift can dominate counting noise.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax", "mag-src-nist"], "prerequisites": [], "formulaIds": ["mag-f-uncertainty"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-inverse"><data key="title">Inverse magnetization</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-inverse", "title": "Inverse magnetization", "parentId": "mag-metrology", "level": 2, "summary": "External fields need not uniquely determine a vector magnetization distribution.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-continuation"><data key="title">Height continuation and bandwidth</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-continuation", "title": "Height continuation and bandwidth", "parentId": "mag-inverse", "level": 3, "summary": "High-spatial-frequency components decay rapidly above the sample and amplify noise on inversion.", "coverage": "reviewed", "sourceIds": ["mag-src-inverse-nv", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-height"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-nullspace"><data key="title">Magnetic inverse null spaces</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-nullspace", "title": "Magnetic inverse null spaces", "parentId": "mag-inverse", "level": 3, "summary": "A single field component generally cannot identify every source component without extra assumptions.", "coverage": "mapped", "sourceIds": ["mag-src-inverse-nv", "mag-src-mit-vector", "mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-inverse-witness"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-reconstruction"><data key="title">Physics-informed reconstruction</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-reconstruction", "title": "Physics-informed reconstruction", "parentId": "mag-inverse", "level": 3, "summary": "A fitted field can coexist with multiple magnetization explanations; priors and held-out data must be reported.", "coverage": "mapped", "sourceIds": ["mag-src-mumax", "mag-src-inverse-nv"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-micromagnetics"><data key="title">Micromagnetic energy functionals</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-micromagnetics", "title": "Micromagnetic energy functionals", "parentId": "mag-computation", "level": 2, "summary": "A continuous unit-vector model excludes atomic-scale degrees of freedom by construction.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-discretization"><data key="title">Mesh and timestep convergence</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-discretization", "title": "Mesh and timestep convergence", "parentId": "mag-micromagnetics", "level": 3, "summary": "Agreement at one grid spacing is not convergence; resolve relevant exchange and wall scales.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-lex"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-exchangeenergy"><data key="title">Exchange functional</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-exchangeenergy", "title": "Exchange functional", "parentId": "mag-micromagnetics", "level": 3, "summary": "Gradient penalties approximate slowly varying exchange and need compatible boundary conditions.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-exchange"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-anisotropy"><data key="title">Anisotropy functional</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-anisotropy", "title": "Anisotropy functional", "parentId": "mag-micromagnetics", "level": 3, "summary": "Easy axes and energy offsets must be stated with the coefficient convention.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-anisotropy"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-dmi"><data key="title">DMI conventions and boundaries</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">reviewed</data><data key="metadata">{"id": "mag-dmi", "title": "DMI conventions and boundaries", "parentId": "mag-micromagnetics", "level": 3, "summary": "Bulk and interfacial DMI have different invariant forms and boundary twists.", "coverage": "reviewed", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": ["mag-f-dmi"], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-validation"><data key="title">Code verification versus validation</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-validation", "title": "Code verification versus validation", "parentId": "mag-computation", "level": 2, "summary": "Analytic/standard-problem agreement verifies implementation within a model, not actual material parameters.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-mumax"><data key="title">MuMax3 verification corpus</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-mumax", "title": "MuMax3 verification corpus", "parentId": "mag-validation", "level": 3, "summary": "Selected source sections expose finite-difference approximations and even benchmark disagreement.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-dft"><data key="title">Electronic-structure model choices</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-dft", "title": "Electronic-structure model choices", "parentId": "mag-computation", "level": 2, "summary": "Exchange-correlation approximations and Hubbard U can change predicted magnetic ground states.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-reproducibility"><data key="title">Reproducibility and uncertainty</data><data key="kind">topic</data><data key="domain">magnetism</data><data key="status">mapped</data><data key="metadata">{"id": "mag-reproducibility", "title": "Reproducibility and uncertainty", "parentId": "mag-computation", "level": 2, "summary": "Record code/version, mesh, convergence, material parameters, boundary conditions and numerical budgets.", "coverage": "mapped", "sourceIds": ["mag-src-mumax"], "prerequisites": [], "formulaIds": [], "kind": "topic", "domain": "magnetism"}</data></node><node id="mag-f-gauss"><data key="title">Magnetic flux continuity</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-gauss", "topicId": "mag-fields", "title": "Magnetic flux continuity", "latex": "\\nabla\\cdot\\mathbf B=0,\\quad\\oint_{\\partial V}\\mathbf B\\cdot d\\mathbf a=0", "plain": "Divergence-free B has zero net outward flux through a closed surface.", "variables": [{"symbol": "B", "meaning": "magnetic flux density", "unit": "T", "kind": "vector"}, {"symbol": "V", "meaning": "enclosed region", "unit": "m^3", "kind": "coordinate"}, {"symbol": "da", "meaning": "oriented outward area element", "unit": "m^2", "kind": "vector"}, {"symbol": "nabla", "meaning": "spatial derivative", "unit": "1/m", "kind": "operator"}], "conditions": ["Classical Maxwell theory with no magnetic monopoles; include all faces of a closed surface."], "derivation": ["Apply the divergence theorem to local flux continuity.", "Opposite face contributions cancel for a uniform field."], "workedExample": {"inputs": "Bz=0.01 T; cube side=0.1 m", "steps": ["Top flux=+0.0001 Wb; bottom=-0.0001 Wb; sides zero."], "result": "Net flux=0", "units": "Wb"}, "limitingCases": ["A nonzero open-surface flux is entirely compatible."], "pitfalls": ["Zero divergence does not imply zero curl or zero local field."], "sourceIds": ["mag-src-mit-vector"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-biot"><data key="title">Biot–Savart law for a filament</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-biot", "topicId": "mag-biot", "title": "Biot–Savart law for a filament", "latex": "\\mathbf B(\\mathbf r)=\\frac{\\mu_0 I}{4\\pi}\\int \\frac{d\\boldsymbol\\ell\\times(\\mathbf r-\\mathbf r^\\prime)}{|\\mathbf r-\\mathbf r^\\prime|^3}", "plain": "Sum oriented steady-current elements using the inverse-distance vector kernel.", "variables": [{"symbol": "mu0", "meaning": "vacuum magnetic permeability, measured CODATA constant", "unit": "H/m", "kind": "constant"}, {"symbol": "I", "meaning": "steady line current", "unit": "A", "kind": "scalar"}, {"symbol": "r", "meaning": "observation point", "unit": "m", "kind": "coordinate"}, {"symbol": "rprime", "meaning": "source point", "unit": "m", "kind": "coordinate"}, {"symbol": "dl", "meaning": "oriented line element in current direction", "unit": "m", "kind": "vector"}, {"symbol": "B", "meaning": "resulting flux density", "unit": "T", "kind": "vector"}], "conditions": ["Steady localized current with a physically completed return path; vacuum.", "Observation point is outside the ideal filament."], "derivation": ["Solve the vector Poisson equation in Coulomb gauge with the free-space Green function.", "Take its curl to obtain the cross-product kernel."], "workedExample": {"inputs": "Circular loop I=1 A, R=0.1 m; evaluate centre", "steps": ["All axial contributions add; transverse contributions cancel.", "Integrate circumference to obtain mu0 I/(2R)."], "result": "B=6.2831853 microtesla", "units": "T"}, "limitingCases": ["The far field of a localized closed loop is dipolar, not an isolated-wire 1/r field."], "pitfalls": ["Do not omit return current when predicting a finite device field."], "sourceIds": ["mag-src-mit-vector"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-wire"><data key="title">Infinite straight wire</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-wire", "topicId": "mag-wire", "title": "Infinite straight wire", "latex": "B_\\phi=\\frac{\\mu_0 I}{2\\pi r}", "plain": "Cylindrical symmetry turns Ampere circulation into an azimuthal field.", "variables": [{"symbol": "mu0", "meaning": "vacuum magnetic permeability, measured CODATA constant", "unit": "H/m", "kind": "constant"}, {"symbol": "I", "meaning": "wire current", "unit": "A", "kind": "scalar"}, {"symbol": "r", "meaning": "distance from wire axis", "unit": "m", "kind": "coordinate"}, {"symbol": "Bphi", "meaning": "azimuthal flux density, right-hand sense", "unit": "T", "kind": "scalar"}], "conditions": ["Infinite thin wire, vacuum, stationary current; r exceeds conductor radius."], "derivation": ["Choose a coaxial circular contour.", "B is tangential and constant on the contour, so 2 pi r B=mu0 I."], "workedExample": {"inputs": "I=2 A; r=0.05 m", "steps": ["Substitute into mu0*2/(2*pi*0.05)."], "result": "B=8.0 microtesla", "units": "T"}, "limitingCases": ["As I tends to zero, B vanishes; the singular r→0 limit is outside the thin-wire domain."], "pitfalls": ["A finite wire cannot inherit this expression arbitrarily close to its ends."], "sourceIds": ["mag-src-mit-vector"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-loop"><data key="title">On-axis circular-loop field</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-loop", "topicId": "mag-loop", "title": "On-axis circular-loop field", "latex": "B_z(z)=\\frac{\\mu_0 I R^2}{2(R^2+z^2)^{3/2}}", "plain": "The axial field of a thin circular loop interpolates between centre field and a dipole.", "variables": [{"symbol": "mu0", "meaning": "vacuum magnetic permeability, measured CODATA constant", "unit": "H/m", "kind": "constant"}, {"symbol": "I", "meaning": "oriented loop current", "unit": "A", "kind": "scalar"}, {"symbol": "R", "meaning": "loop radius", "unit": "m", "kind": "scalar"}, {"symbol": "z", "meaning": "distance along oriented loop axis", "unit": "m", "kind": "coordinate"}, {"symbol": "Bz", "meaning": "axial flux density", "unit": "T", "kind": "scalar"}], "conditions": ["Circular filament in vacuum; observation on its symmetry axis."], "derivation": ["Project the Biot–Savart cross product onto the axis.", "The denominator is constant around the loop; integrate azimuth."], "workedExample": {"inputs": "I=1 A; R=0.1 m; z=0.1 m", "steps": ["Centre field=6.283 microtesla.", "Multiply by (1+1)^(-3/2)."], "result": "Bz=2.22144 microtesla", "units": "T"}, "limitingCases": ["At z=0 recover mu0 I/(2R); for |z|≫R recover z^-3."], "pitfalls": ["The expression is not the off-axis field of a finite solenoid."], "sourceIds": ["mag-src-mit-vector"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-ampere"><data key="title">Magnetostatic free-current circulation</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-ampere", "topicId": "mag-ampere", "title": "Magnetostatic free-current circulation", "latex": "\\nabla\\times\\mathbf H=\\mathbf J_f,\\quad\\oint_C\\mathbf H\\cdot d\\boldsymbol\\ell=I_{f,enc}", "plain": "H circulation counts free current after magnetization is separated out.", "variables": [{"symbol": "H", "meaning": "magnetic field intensity", "unit": "A/m", "kind": "vector"}, {"symbol": "Jf", "meaning": "free-current density", "unit": "A/m^2", "kind": "vector"}, {"symbol": "C", "meaning": "oriented closed contour", "unit": "m", "kind": "coordinate"}, {"symbol": "dl", "meaning": "oriented line increment", "unit": "m", "kind": "vector"}, {"symbol": "Ifenc", "meaning": "free current through compatible surface", "unit": "A", "kind": "scalar"}], "conditions": ["Stationary fields; displacement current negligible; contour and normal follow right-hand orientation."], "derivation": ["Apply Stokes theorem to curl H=Jf.", "Integrate current density over the spanning surface."], "workedExample": {"inputs": "Ienc=3 A; circular contour radius=0.1 m with cylindrical symmetry", "steps": ["H is constant and tangential.", "Divide 3 A by 2*pi*0.1 m."], "result": "H=4.77465 A/m", "units": "A/m"}, "limitingCases": ["Zero enclosed current gives zero circulation, not necessarily H=0 everywhere."], "pitfalls": ["Ampere law does not justify constant H on a nonsymmetric contour."], "sourceIds": ["mag-src-mit-vector"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-solenoid"><data key="title">Long-solenoid interior estimate</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">approximation</data><data key="metadata">{"id": "mag-f-solenoid", "topicId": "mag-solenoid", "title": "Long-solenoid interior estimate", "latex": "B\\simeq\\mu_0 n I", "plain": "Turns per unit length set the ideal long air-core coil field.", "variables": [{"symbol": "mu0", "meaning": "vacuum magnetic permeability, measured CODATA constant", "unit": "H/m", "kind": "constant"}, {"symbol": "n", "meaning": "turn density", "unit": "1/m", "kind": "scalar"}, {"symbol": "I", "meaning": "coil current", "unit": "A", "kind": "scalar"}, {"symbol": "B", "meaning": "interior axial field", "unit": "T", "kind": "scalar"}], "conditions": ["Length much larger than radius, observation away from ends, air core, negligible winding thickness."], "derivation": ["Choose an Ampere rectangle along the interior and remote exterior.", "Neglect exterior contribution and count n*l turns."], "workedExample": {"inputs": "n=1000/m; I=0.1 A", "steps": ["Compute mu0*100 A/m."], "result": "B≈0.125664 mT", "units": "T"}, "limitingCases": ["At an ideal long coil end the on-axis field is about half the deep-interior value."], "pitfalls": ["Real coil heating, fringe fields and magnetic core saturation are separate calculations."], "sourceIds": ["mag-src-mit-vector"], "status": "approximation", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-bh"><data key="title">Macroscopic B–H–M relation</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-bh", "topicId": "mag-fields", "title": "Macroscopic B–H–M relation", "latex": "\\mathbf B=\\mu_0(\\mathbf H+\\mathbf M)", "plain": "Magnetization is magnetic moment per material volume; the relation defines H in SI.", "variables": [{"symbol": "mu0", "meaning": "vacuum magnetic permeability, measured CODATA constant", "unit": "H/m", "kind": "constant"}, {"symbol": "B", "meaning": "magnetic induction", "unit": "T", "kind": "vector"}, {"symbol": "H", "meaning": "field intensity", "unit": "A/m", "kind": "vector"}, {"symbol": "M", "meaning": "magnetization", "unit": "A/m", "kind": "vector"}], "conditions": ["Macroscopic SI fields defined at compatible coarse-graining scale."], "derivation": ["Separate microscopic current into free and magnetization contributions.", "Define H=B/mu0−M; no linear material law is assumed."], "workedExample": {"inputs": "Collinear H=100 A/m and M=900 A/m", "steps": ["Sum H+M=1000 A/m."], "result": "B=1.256637 mT", "units": "T"}, "limitingCases": ["For M=0, vacuum B=mu0 H; at H=0 an ordered sample can have M≠0."], "pitfalls": ["B and H do not have the same SI units; B=mu H additionally assumes a constitutive law."], "sourceIds": ["mag-src-mit-energy"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-bound-volume"><data key="title">Volume magnetization current</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-bound-volume", "topicId": "mag-bound", "title": "Volume magnetization current", "latex": "\\mathbf J_b=\\nabla\\times\\mathbf M", "plain": "Spatially varying magnetization has an equivalent bound volume current.", "variables": [{"symbol": "Jb", "meaning": "bound volume current density", "unit": "A/m^2", "kind": "vector"}, {"symbol": "M", "meaning": "magnetization", "unit": "A/m", "kind": "vector"}, {"symbol": "nabla", "meaning": "spatial derivative", "unit": "1/m", "kind": "operator"}], "conditions": ["Continuum magnetization differentiable inside the material; add interface surface currents separately."], "derivation": ["Represent localized magnetic moments as small current loops.", "Interior loop contributions cancel except where magnetization varies."], "workedExample": {"inputs": "M=(0,0,a*x), a=1000 A/m^2", "steps": ["Curl gives Jb_y=−dMz/dx."], "result": "Jb=(0,−1000,0) A/m²", "units": "A/m^2"}, "limitingCases": ["Uniform M has zero volume curl but generally nonzero surface current."], "pitfalls": ["Zero Jb in the bulk does not imply an unmagnetized body."], "sourceIds": ["mag-src-mit-energy"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-bound-surface"><data key="title">Surface magnetization current</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-bound-surface", "topicId": "mag-bound", "title": "Surface magnetization current", "latex": "\\mathbf K_b=\\mathbf M\\times\\hat{\\mathbf n}", "plain": "The boundary current closes magnetization loops at an interface.", "variables": [{"symbol": "Kb", "meaning": "bound surface current density", "unit": "A/m", "kind": "vector"}, {"symbol": "M", "meaning": "magnetization inside relative to outside", "unit": "A/m", "kind": "vector"}, {"symbol": "n", "meaning": "outward unit surface normal", "unit": "dimensionless", "kind": "vector"}], "conditions": ["Use the magnetization jump if both sides are magnetic; orientation is outward from the chosen body."], "derivation": ["Integrate volume curl through an infinitesimal interface layer.", "The normal derivative of the magnetization step produces a surface sheet."], "workedExample": {"inputs": "M=1000 zhat A/m; surface normal=xhat", "steps": ["zhat cross xhat = yhat."], "result": "Kb=1000 yhat A/m", "units": "A/m"}, "limitingCases": ["A face normal parallel to M carries no equivalent surface current."], "pitfalls": ["The order M cross n matters; reversing it reverses circulation."], "sourceIds": ["mag-src-mit-energy"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-dipole"><data key="title">Far-field magnetic dipole</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">approximation</data><data key="metadata">{"id": "mag-f-dipole", "topicId": "mag-dipoles", "title": "Far-field magnetic dipole", "latex": "\\mathbf B=\\frac{\\mu_0}{4\\pi r^3}[3(\\mathbf m\\cdot\\hat{\\mathbf r})\\hat{\\mathbf r}-\\mathbf m]", "plain": "A localized current distribution has a leading magnetic dipole term.", "variables": [{"symbol": "mu0", "meaning": "vacuum magnetic permeability, measured CODATA constant", "unit": "H/m", "kind": "constant"}, {"symbol": "m", "meaning": "magnetic dipole moment", "unit": "A m^2", "kind": "vector"}, {"symbol": "r", "meaning": "distance from source centre", "unit": "m", "kind": "scalar"}, {"symbol": "rhat", "meaning": "unit displacement", "unit": "dimensionless", "kind": "vector"}, {"symbol": "B", "meaning": "dipole field", "unit": "T", "kind": "vector"}], "conditions": ["r much larger than source extent; outside the source in vacuum."], "derivation": ["Expand the localized vector potential at large distance.", "The closed-current monopole term vanishes; curl the leading moment term."], "workedExample": {"inputs": "m=0.1 A m²; axial r=0.1 m", "steps": ["On axis B=mu0*2m/(4*pi*r³)."], "result": "B=20 microtesla", "units": "T"}, "limitingCases": ["At the equator the field points opposite m with half the axial magnitude."], "pitfalls": ["The singular point-dipole field cannot describe the source interior."], "sourceIds": ["mag-src-mit-vector"], "status": "approximation", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-torque"><data key="title">Dipole torque and energy</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-torque", "topicId": "mag-dipoles", "title": "Dipole torque and energy", "latex": "\\boldsymbol\\tau=\\mathbf m\\times\\mathbf B,\\quad U=-\\mathbf m\\cdot\\mathbf B", "plain": "A fixed permanent dipole tends to align with the applied field.", "variables": [{"symbol": "tau", "meaning": "mechanical torque", "unit": "N m", "kind": "vector"}, {"symbol": "m", "meaning": "fixed dipole moment", "unit": "A m^2", "kind": "vector"}, {"symbol": "B", "meaning": "external field excluding self field", "unit": "T", "kind": "vector"}, {"symbol": "U", "meaning": "orientation-dependent potential energy", "unit": "J", "kind": "scalar"}], "conditions": ["Small fixed moment in a field uniform over the dipole; induced moments require material work accounting."], "derivation": ["Sum Lorentz forces around a small loop.", "Integrate torque against angle to obtain U=−mB cos(theta)."], "workedExample": {"inputs": "m=0.01 A m²; B=0.1 T; perpendicular orientation", "steps": ["Torque magnitude=mB; aligned energy=−mB."], "result": "Torque=0.001 N m; aligned U=−0.001 J", "units": "N m; J"}, "limitingCases": ["Aligned torque is zero although energy is minimal, not zero by necessity."], "pitfalls": ["An induced moment may introduce a factor1/2 in energy after its formation is included."], "sourceIds": ["mag-src-mit-energy"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-force"><data key="title">Force on a fixed dipole</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-force", "topicId": "mag-dipoles", "title": "Force on a fixed dipole", "latex": "\\mathbf F=\\nabla(\\mathbf m\\cdot\\mathbf B)", "plain": "The gradient of dipole potential gives force when its moment is fixed.", "variables": [{"symbol": "F", "meaning": "force on dipole", "unit": "N", "kind": "vector"}, {"symbol": "m", "meaning": "fixed moment", "unit": "A m^2", "kind": "vector"}, {"symbol": "B", "meaning": "external induction", "unit": "T", "kind": "vector"}, {"symbol": "nabla", "meaning": "position gradient", "unit": "1/m", "kind": "operator"}], "conditions": ["Small rigid moment, quasistatic external field, derivatives at fixed m."], "derivation": ["Use F=−gradient U with U=−m dot B.", "Keep self field and induced-response work outside this simplified potential."], "workedExample": {"inputs": "mz=0.01 A m²; dBz/dz=2 T/m", "steps": ["Multiply mz by axial field gradient."], "result": "Fz=0.02 N", "units": "N"}, "limitingCases": ["A uniform field can exert torque but gives no translational dipole force."], "pitfalls": ["A field magnitude alone is insufficient to determine lifting force."], "sourceIds": ["mag-src-mit-energy"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-flux"><data key="title">Magnetic flux</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-flux", "topicId": "mag-faraday", "title": "Magnetic flux", "latex": "\\Phi_B=\\int_S\\mathbf B\\cdot d\\mathbf a", "plain": "Flux is the oriented surface integral, not B multiplied by any convenient area.", "variables": [{"symbol": "PhiB", "meaning": "magnetic flux through chosen oriented surface", "unit": "Wb", "kind": "scalar"}, {"symbol": "B", "meaning": "induction", "unit": "T", "kind": "vector"}, {"symbol": "da", "meaning": "oriented area element", "unit": "m^2", "kind": "vector"}], "conditions": ["A defined surface and normal; B and geometry may vary across it."], "derivation": ["Sum infinitesimal normal field contributions.", "For a uniform field and flat area, obtain BA cos(theta)."], "workedExample": {"inputs": "B=0.2 T; A=0.01 m²; field at60degrees to normal", "steps": ["cos60=0.5."], "result": "Phi=0.001 Wb", "units": "Wb"}, "limitingCases": ["A surface parallel to field has zero flux despite nonzero B."], "pitfalls": ["Angle is measured from the normal, not from the surface plane."], "sourceIds": ["mag-src-mit-induction"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-faraday"><data key="title">Oriented moving-loop Faraday law</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-faraday", "topicId": "mag-moving", "title": "Oriented moving-loop Faraday law", "latex": "\\mathcal E=\\oint_{C(t)}(\\mathbf E+\\mathbf v\\times\\mathbf B)\\cdot d\\boldsymbol\\ell=-\\frac{d\\Phi_B}{dt}", "plain": "Electric and motional contributions give the emf around the actual moving material loop.", "variables": [{"symbol": "emf", "meaning": "oriented electromotive force", "unit": "V", "kind": "scalar"}, {"symbol": "E", "meaning": "electric field", "unit": "V/m", "kind": "vector"}, {"symbol": "v", "meaning": "material-loop velocity", "unit": "m/s", "kind": "vector"}, {"symbol": "B", "meaning": "induction", "unit": "T", "kind": "vector"}, {"symbol": "dl", "meaning": "oriented circuit element", "unit": "m", "kind": "vector"}, {"symbol": "PhiB", "meaning": "flux through compatible moving surface", "unit": "Wb", "kind": "scalar"}, {"symbol": "t", "meaning": "time", "unit": "s", "kind": "coordinate"}], "conditions": ["A well-defined material circuit and right-hand orientation; ideal thin circuit approximation."], "derivation": ["Combine local curl E=−partial B/partial t with the moving-surface transport theorem.", "The boundary motion term is v cross B, not an extra energy source."], "workedExample": {"inputs": "Stationary loop, flux rises by0.003 Wb over0.1 s", "steps": ["dPhi/dt=0.03 Wb/s; apply minus sign."], "result": "emf=−0.03 V for the chosen positive circulation", "units": "V"}, "limitingCases": ["Steady B can induce emf if the loop area/orientation changes."], "pitfalls": ["Reversing the chosen normal reverses both flux and emf sign consistently."], "sourceIds": ["mag-src-mit-induction"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-maxwell"><data key="title">Ampère–Maxwell law</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-maxwell", "topicId": "mag-maxwell", "title": "Ampère–Maxwell law", "latex": "\\nabla\\times\\mathbf H=\\mathbf J_f+\\frac{\\partial\\mathbf D}{\\partial t}", "plain": "Free current and displacement-current density both source the curl of H.", "variables": [{"symbol": "H", "meaning": "field intensity", "unit": "A/m", "kind": "vector"}, {"symbol": "Jf", "meaning": "free-current density", "unit": "A/m^2", "kind": "vector"}, {"symbol": "D", "meaning": "electric displacement", "unit": "C/m^2", "kind": "vector"}, {"symbol": "t", "meaning": "time", "unit": "s", "kind": "coordinate"}, {"symbol": "nabla", "meaning": "spatial derivative", "unit": "1/m", "kind": "operator"}], "conditions": ["Macroscopic Maxwell equations with polarization placed in D."], "derivation": ["Add displacement current to preserve free-charge continuity.", "Taking divergence gives divergence Jf+partial rho_f/partial t=0 using divergence D=rho_f."], "workedExample": {"inputs": "Charging capacitor: dD/dt=2 A/m² over0.01 m²", "steps": ["Integrate displacement current density over gap area."], "result": "Displacement current=0.02 A", "units": "A"}, "limitingCases": ["The term may be negligible in a specific MQS limit, not identically absent."], "pitfalls": ["Displacement current is not a flow of free charges across an ideal vacuum capacitor gap."], "sourceIds": ["mag-src-mit-energy"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-poynting"><data key="title">Vacuum Poynting theorem</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-poynting", "topicId": "mag-energy", "title": "Vacuum Poynting theorem", "latex": "\\partial_t u+\\nabla\\cdot\\mathbf S=-\\mathbf J\\cdot\\mathbf E,\\quad\\mathbf S=\\mathbf E\\times\\mathbf H", "plain": "Field storage plus outward electromagnetic flux equals negative work rate on matter.", "variables": [{"symbol": "u", "meaning": "vacuum electromagnetic energy density", "unit": "J/m^3", "kind": "scalar"}, {"symbol": "S", "meaning": "Poynting energy flux", "unit": "W/m^2", "kind": "vector"}, {"symbol": "J", "meaning": "material current density", "unit": "A/m^2", "kind": "vector"}, {"symbol": "E", "meaning": "electric field", "unit": "V/m", "kind": "vector"}, {"symbol": "H", "meaning": "magnetic field intensity", "unit": "A/m", "kind": "vector"}, {"symbol": "t", "meaning": "time", "unit": "s", "kind": "coordinate"}, {"symbol": "nabla", "meaning": "spatial derivative", "unit": "1/m", "kind": "operator"}], "conditions": ["Vacuum fields with material currents treated explicitly; material storage needs a consistent constitutive energy model."], "derivation": ["Dot Ampère–Maxwell with E and Faraday with H.", "Subtract using divergence(E cross H)=H dot curl E−E dot curl H."], "workedExample": {"inputs": "Control volume: inward flux3 W; stored-energy rise1 W", "steps": ["Outward integrated S=−3 W; dU/dt=1 W.", "Work on matter=3−1."], "result": "Matter receives2 W", "units": "W"}, "limitingCases": ["A steady state can have nonzero energy flux while storage is constant."], "pitfalls": ["Field enhancement is not net output; include every boundary port and initial storage."], "sourceIds": ["mag-src-mit-energy"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-density"><data key="title">Vacuum field-energy density</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-density", "topicId": "mag-energy", "title": "Vacuum field-energy density", "latex": "u=\\frac{\\epsilon_0 E^2}{2}+\\frac{B^2}{2\\mu_0}", "plain": "Quadratic vacuum storage follows from reversible field work.", "variables": [{"symbol": "mu0", "meaning": "vacuum magnetic permeability, measured CODATA constant", "unit": "H/m", "kind": "constant"}, {"symbol": "epsilon0", "meaning": "vacuum electric permittivity", "unit": "F/m", "kind": "constant"}, {"symbol": "E", "meaning": "electric field magnitude", "unit": "V/m", "kind": "scalar"}, {"symbol": "B", "meaning": "magnetic induction magnitude", "unit": "T", "kind": "scalar"}, {"symbol": "u", "meaning": "field energy per volume", "unit": "J/m^3", "kind": "scalar"}], "conditions": ["Vacuum or a specified linear nondispersive analogue; not a general hysteretic-material formula."], "derivation": ["Integrate E dD and H dB along a reversible constitutive path.", "In vacuum D=epsilon0 E and H=B/mu0."], "workedExample": {"inputs": "E=0; B=0.01 T in volume0.001 m³", "steps": ["Magnetic density=B²/(2mu0)=39.7887 J/m³."], "result": "Stored magnetic energy=0.0397887 J", "units": "J"}, "limitingCases": ["Storage vanishes quadratically as B→0."], "pitfalls": ["Using B²/(2mu) in a nonlinear hysteretic core can give incorrect material energy accounting."], "sourceIds": ["mag-src-mit-energy"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-inductor"><data key="title">Passive inductor and winding budget</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-inductor", "topicId": "mag-passivity", "title": "Passive inductor and winding budget", "latex": "v=L\\dot i+Ri,\\quad vi=\\frac{d}{dt}\\frac{Li^2}{2}+Ri^2", "plain": "Source power splits into changing magnetic storage and nonnegative winding dissipation.", "variables": [{"symbol": "v", "meaning": "passive-sign terminal voltage", "unit": "V", "kind": "scalar"}, {"symbol": "i", "meaning": "current entering positive terminal", "unit": "A", "kind": "scalar"}, {"symbol": "L", "meaning": "constant inductance", "unit": "H", "kind": "coupling"}, {"symbol": "R", "meaning": "nonnegative winding resistance", "unit": "ohm", "kind": "scalar"}, {"symbol": "t", "meaning": "time", "unit": "s", "kind": "coordinate"}], "conditions": ["L positive and constant, R≥0, no additional coupled or powered ports."], "derivation": ["Multiply voltage equation by current.", "Use L i di/dt=d(Li²/2)/dt."], "workedExample": {"inputs": "L=0.1 H; i rises0→2 A; R=0 for illustrative storage", "steps": ["Ufinal=0.5*0.1*4."], "result": "Input work=0.2 J; no continuous output from a fixed stored state", "units": "J"}, "limitingCases": ["With source off, a resistor can drain initial energy but cannot replenish it."], "pitfalls": ["A changing L introduces mechanical/coupling work; do not omit it."], "sourceIds": ["mag-src-mit-energy"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-hysteresis"><data key="title">Cycle work in magnetic material</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">approximation</data><data key="metadata">{"id": "mag-f-hysteresis", "topicId": "mag-hysteresis", "title": "Cycle work in magnetic material", "latex": "w_{cycle}=\\oint\\mathbf H\\cdot d\\mathbf B", "plain": "An oriented quasistatic B–H loop gives magnetic work per sample volume for a completed cycle.", "variables": [{"symbol": "wcycle", "meaning": "net supplied work per cycle per volume", "unit": "J/m^3", "kind": "scalar"}, {"symbol": "H", "meaning": "internal field intensity", "unit": "A/m", "kind": "vector"}, {"symbol": "B", "meaning": "induction", "unit": "T", "kind": "vector"}], "conditions": ["Closed periodic cycle, consistent internal field and sample volume; separate nonmagnetic apparatus losses."], "derivation": ["Integrate local magnetic work H dot dB.", "Reversible storage returns to its initial value after a cycle, leaving net dissipative work."], "workedExample": {"inputs": "Rectangular scalar loop: coercive Hc=100 A/m; remanent Br=0.5 T", "steps": ["Oriented area magnitude=4 Hc Br."], "result": "Dissipated work=200 J/m³ per cycle under this loop idealization", "units": "J/m^3"}, "limitingCases": ["A reversible single-valued path traversed forward and back encloses zero area."], "pitfalls": ["A counterclockwise plotted loop may change algebraic sign; passivity uses work supplied to matter."], "sourceIds": ["mag-src-mit-energy"], "status": "approximation", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-demag"><data key="title">Ellipsoidal internal-field correction</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">approximation</data><data key="metadata">{"id": "mag-f-demag", "topicId": "mag-demag", "title": "Ellipsoidal internal-field correction", "latex": "H_{int}=H_{app}-NM,\\quad M=\\frac{\\chi H_{app}}{1+N\\chi}", "plain": "A uniform ellipsoid gives a closed correction for reversible scalar susceptibility.", "variables": [{"symbol": "Hint", "meaning": "internal field along principal axis", "unit": "A/m", "kind": "scalar"}, {"symbol": "Happ", "meaning": "applied field", "unit": "A/m", "kind": "scalar"}, {"symbol": "N", "meaning": "SI demagnetizing factor", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "M", "meaning": "magnetization", "unit": "A/m", "kind": "scalar"}, {"symbol": "chi", "meaning": "intrinsic scalar susceptibility", "unit": "dimensionless", "kind": "coupling"}], "conditions": ["Uniform ellipsoid, principal-axis drive, linear reversible medium; SI factors sum to1."], "derivation": ["Combine demagnetizing field −NM with M=chi Hint.", "Solve the one-variable linear equation for M."], "workedExample": {"inputs": "Sphere N=1/3; chi=3; Happ=100 A/m", "steps": ["Denominator=1+1=2."], "result": "M=150 A/m and Hint=50 A/m", "units": "A/m"}, "limitingCases": ["For chi→0, M≈chi Happ; large chi is shape-limited."], "pitfalls": ["CGS demagnetizing factors can sum to4pi; do not mix conventions."], "sourceIds": ["mag-src-mit-energy"], "status": "approximation", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-curie"><data key="title">Weak-field Curie susceptibility</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">approximation</data><data key="metadata">{"id": "mag-f-curie", "topicId": "mag-paramag", "title": "Weak-field Curie susceptibility", "latex": "\\chi=\\frac{\\mu_0 n\\mu^2}{3k_B T}", "plain": "Independent isotropically orientable moments respond linearly when thermal energy dominates alignment.", "variables": [{"symbol": "mu0", "meaning": "vacuum magnetic permeability, measured CODATA constant", "unit": "H/m", "kind": "constant"}, {"symbol": "n", "meaning": "number density of moments", "unit": "1/m^3", "kind": "scalar"}, {"symbol": "mu", "meaning": "moment magnitude", "unit": "A m^2", "kind": "scalar"}, {"symbol": "kB", "meaning": "Boltzmann constant", "unit": "J/K", "kind": "constant"}, {"symbol": "T", "meaning": "absolute temperature", "unit": "K", "kind": "scalar"}, {"symbol": "chi", "meaning": "small-field volume susceptibility", "unit": "dimensionless", "kind": "scalar"}], "conditions": ["Noninteracting moments in weak field mu B≪kB T; classical orientation or appropriate quantum effective moment."], "derivation": ["For classical isotropic independent moments use x=mu B/(kB T) and Z_orientation=4pi sinh(x)/x. Its mean axial moment is mu[coth(x)−1/x].", "Expand coth(x)−1/x=x/3+O(x³), multiply by number density, and use B≈mu0 H in this weak-response limit. This is an explanatory derivation, distinct from the source’s two-state Ising normalization."], "workedExample": {"inputs": "n=1e28/m³; mu=9.274e-24 A m²; T=300 K", "steps": ["Use kB=1.380649e-23 J/K."], "result": "chi≈8.70e-5", "units": "dimensionless"}, "limitingCases": ["The expression cannot be extrapolated to T=0 or saturation."], "pitfalls": ["It is not a ferromagnetic hysteresis law and does not include exchange correlations.", "An Ising two-state moment has a different weak-field angular factor; do not import its normalized B coupling as SI tesla."], "sourceIds": ["mag-src-tong-phase"], "status": "approximation", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-cw"><data key="title">Curie–Weiss phenomenology</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">approximation</data><data key="metadata">{"id": "mag-f-cw", "topicId": "mag-critical", "title": "Curie–Weiss phenomenology", "latex": "\\chi=\\frac{C}{T-\\theta}", "plain": "A molecular-field correction shifts the Curie-law denominator.", "variables": [{"symbol": "chi", "meaning": "uniform susceptibility", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "C", "meaning": "Curie constant", "unit": "K", "kind": "coupling"}, {"symbol": "T", "meaning": "temperature", "unit": "K", "kind": "scalar"}, {"symbol": "theta", "meaning": "Weiss intercept", "unit": "K", "kind": "scalar"}], "conditions": ["Paramagnetic regime sufficiently far from transitions; fitted C and theta are model-dependent."], "derivation": ["Assume an effective field H+lambda M and insert the Curie response.", "Solve for M/H and absorb molecular-field coefficient into theta."], "workedExample": {"inputs": "C=0.1 K; T=300 K; theta=50 K", "steps": ["Compute0.1/(300−50)."], "result": "chi=0.0004", "units": "dimensionless"}, "limitingCases": ["theta=0 recovers Curie behavior; the denominator divergence is not a literal finite-sample infinity."], "pitfalls": ["Negative theta suggests dominant AFM correlations, not proof of a spin liquid or an ordering temperature."], "sourceIds": ["mag-src-tong-phase"], "status": "approximation", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-heisenberg"><data key="title">Heisenberg exchange convention</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-heisenberg", "topicId": "mag-exchange", "title": "Heisenberg exchange convention", "latex": "\\mathcal H=J\\sum_{\\langle ij\\rangle}\\mathbf S_i\\cdot\\mathbf S_j", "plain": "With this plus-sign convention, positive J favors antiparallel spin correlations.", "variables": [{"symbol": "H", "meaning": "model Hamiltonian", "unit": "J", "kind": "operator"}, {"symbol": "J", "meaning": "nearest-neighbor exchange energy, positive AFM", "unit": "J", "kind": "coupling"}, {"symbol": "Si", "meaning": "dimensionless spin operator at site i", "unit": "dimensionless", "kind": "operator"}, {"symbol": "Sj", "meaning": "spin at neighboring site j", "unit": "dimensionless", "kind": "operator"}, {"symbol": "ij", "meaning": "once-counted nearest-neighbor bond", "unit": "dimensionless", "kind": "coordinate"}], "conditions": ["Specify lattice, spin magnitude, boundary and omitted anisotropy/dipolar terms."], "derivation": ["Reduce an electronic low-energy problem to spin degrees of freedom under declared assumptions.", "For two spin1/2 particles, S1 dot S2 has eigenvalues−3/4 and+1/4."], "workedExample": {"inputs": "One bond J=1 meV", "steps": ["Singlet energy=−0.75 meV; triplet=+0.25 meV."], "result": "Singlet–triplet gap=1 meV=1.602176634e-22 J", "units": "J"}, "limitingCases": ["For J&lt;0 the triplet is lower in this convention."], "pitfalls": ["Some authors write−J S dot S and reverse the meaning of positive J."], "sourceIds": ["mag-src-qsl", "mag-src-tong-phase"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-triangle"><data key="title">Classical triangular AFM counterexample</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">conditional-result</data><data key="metadata">{"id": "mag-f-triangle", "topicId": "mag-frustration", "title": "Classical triangular AFM counterexample", "latex": "E=J(\\mathbf s_1\\cdot\\mathbf s_2+\\mathbf s_2\\cdot\\mathbf s_3+\\mathbf s_3\\cdot\\mathbf s_1)", "plain": "Three unit spins cannot make all three AFM bonds antiparallel.", "variables": [{"symbol": "E", "meaning": "three-bond energy", "unit": "J", "kind": "scalar"}, {"symbol": "J", "meaning": "positive classical AFM coupling", "unit": "J", "kind": "coupling"}, {"symbol": "si", "meaning": "classical unit spin vector", "unit": "dimensionless", "kind": "vector"}], "conditions": ["Classical isotropic spins on a single triangular plaquette, zero field."], "derivation": ["Write E=J(|s1+s2+s3|²−3)/2.", "The lower bound occurs when the three vectors sum to zero."], "workedExample": {"inputs": "J=1 energy unit; coplanar angles0,120,240degrees", "steps": ["Each pair dot product=−1/2."], "result": "Emin=−1.5 J rather than the impossible−3 J", "units": "J"}, "limitingCases": ["The 120degree classical ground state is ordered; frustration alone is not a quantum-spin-liquid proof."], "pitfalls": ["Do not transfer a three-site classical minimum to an infinite quantum lattice without analysis."], "sourceIds": ["mag-src-qsl"], "status": "conditional-result", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-llg"><data key="title">Gilbert dynamics with positive gamma convention</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-llg", "topicId": "mag-llg", "title": "Gilbert dynamics with positive gamma convention", "latex": "\\dot{\\mathbf m}=-\\frac{\\gamma}{1+\\alpha^2}[\\mathbf m\\times\\mathbf B_{eff}+\\alpha\\mathbf m\\times(\\mathbf m\\times\\mathbf B_{eff})]", "plain": "A unit magnetization precesses and damps with a declared positive gyromagnetic magnitude.", "variables": [{"symbol": "m", "meaning": "unit magnetization vector", "unit": "dimensionless", "kind": "state"}, {"symbol": "gamma", "meaning": "positive gyromagnetic magnitude", "unit": "rad/(T s)", "kind": "constant"}, {"symbol": "alpha", "meaning": "nonnegative Gilbert damping", "unit": "dimensionless", "kind": "coupling"}, {"symbol": "Beff", "meaning": "effective induction including selected energy terms", "unit": "T", "kind": "vector"}, {"symbol": "t", "meaning": "time", "unit": "s", "kind": "coordinate"}], "conditions": ["Fixed saturation magnitude; differentiable effective energy; torque sources and temperature terms must be added explicitly."], "derivation": ["Solve Gilbert implicit equation dm/dt=−gamma m cross B+alpha m cross dm/dt.", "Use m dot dm/dt=0 to invert its tangent-plane operator."], "workedExample": {"inputs": "alpha=0; Bz=0.1 T; gamma=1.760e11 rad/(T s)", "steps": ["Angular rate=gamma B=1.760e10 rad/s; divide by2pi."], "result": "Precession frequency≈2.801 GHz", "units": "Hz"}, "limitingCases": ["With alpha=0 and static energy, precession conserves energy; alpha&gt;0 removes energy for the consistent convention."], "pitfalls": ["The selected MuMax paper prints a plus-prefactor gamma_LL form; this entry chooses positive gamma and an explicit minus sign. Check the source convention and actual precession direction before converting symbols."], "sourceIds": ["mag-src-mumax"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-exchange"><data key="title">Continuum exchange energy and effective field</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-exchange", "topicId": "mag-exchangeenergy", "title": "Continuum exchange energy and effective field", "latex": "E_{ex}=\\int A|\\nabla\\mathbf m|^2dV,\\quad\\mathbf B_{ex}=\\frac{2A}{M_s}\\nabla^2\\mathbf m", "plain": "A smooth magnetization texture costs gradient energy and creates a restoring exchange field.", "variables": [{"symbol": "Eex", "meaning": "exchange energy", "unit": "J", "kind": "scalar"}, {"symbol": "A", "meaning": "exchange stiffness, not current", "unit": "J/m", "kind": "coupling"}, {"symbol": "m", "meaning": "unit magnetization", "unit": "dimensionless", "kind": "state"}, {"symbol": "V", "meaning": "magnetic region", "unit": "m^3", "kind": "coordinate"}, {"symbol": "Ms", "meaning": "saturation magnetization", "unit": "A/m", "kind": "scalar"}, {"symbol": "Bex", "meaning": "effective exchange induction", "unit": "T", "kind": "vector"}, {"symbol": "nabla", "meaning": "spatial derivative", "unit": "1/m", "kind": "operator"}], "conditions": ["Constant A and Ms; slowly varying texture; appropriate fixed or natural boundaries."], "derivation": ["Vary the gradient functional and integrate by parts.", "Use Beff=−(1/Ms) deltaE/deltam as a volume functional derivative."], "workedExample": {"inputs": "A=1e-11 J/m; sinusoidal wave k=1e7/m; Ms=8e5 A/m", "steps": ["The exchange-field scale is2Ak²/Ms."], "result": "Field scale=0.0025 T", "units": "T"}, "limitingCases": ["Uniform m has zero exchange energy in this reference."], "pitfalls": ["A mesh that cannot resolve rotation between cells misrepresents this continuum model."], "sourceIds": ["mag-src-mumax"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-anisotropy"><data key="title">Uniaxial anisotropy convention</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-anisotropy", "topicId": "mag-anisotropy", "title": "Uniaxial anisotropy convention", "latex": "w_K=K[1-(\\mathbf m\\cdot\\hat{\\mathbf u})^2]", "plain": "Positive K in this convention favors alignment along either easy-axis direction.", "variables": [{"symbol": "wK", "meaning": "anisotropy energy density", "unit": "J/m^3", "kind": "scalar"}, {"symbol": "K", "meaning": "uniaxial anisotropy coefficient", "unit": "J/m^3", "kind": "coupling"}, {"symbol": "m", "meaning": "unit magnetization", "unit": "dimensionless", "kind": "state"}, {"symbol": "u", "meaning": "unit easy axis", "unit": "dimensionless", "kind": "vector"}], "conditions": ["One uniaxial contribution with a chosen zero of energy; other anisotropies may coexist."], "derivation": ["Expand a time-reversal-even scalar energy in the axis projection.", "Subtract a constant so aligned states have zero energy."], "workedExample": {"inputs": "K=1e5 J/m³; m at45degrees to u", "steps": ["Projection squared=1/2."], "result": "wK=5e4 J/m³", "units": "J/m^3"}, "limitingCases": ["Parallel and antiparallel easy-axis states are degenerate under this term alone."], "pitfalls": ["A negative coefficient changes the easy directions; do not infer them from the symbol K alone."], "sourceIds": ["mag-src-mumax"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-dmi"><data key="title">Interfacial DMI energy convention</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-dmi", "topicId": "mag-dmi", "title": "Interfacial DMI energy convention", "latex": "w_D=D[m_z\\nabla\\cdot\\mathbf m-(\\mathbf m\\cdot\\nabla)m_z]", "plain": "An inversion-asymmetric interfacial invariant favors one texture chirality.", "variables": [{"symbol": "wD", "meaning": "DMI energy per volume in effective thin-film convention", "unit": "J/m^3", "kind": "scalar"}, {"symbol": "D", "meaning": "effective interfacial DMI coefficient", "unit": "J/m^2", "kind": "coupling"}, {"symbol": "m", "meaning": "unit magnetization", "unit": "dimensionless", "kind": "state"}, {"symbol": "nabla", "meaning": "in-plane gradient only", "unit": "1/m", "kind": "operator"}, {"symbol": "mz", "meaning": "out-of-plane component", "unit": "dimensionless", "kind": "scalar"}], "conditions": ["Thin-film interfacial symmetry; derivatives x,y only; boundary terms and normal orientation matter."], "derivation": ["Construct a scalar linear in gradients allowed by interfacial symmetry.", "A functional variation generates a chiral field plus nontrivial boundary conditions."], "workedExample": {"inputs": "One-dimensional cycloid m=(sin(qx),0,cos(qx)); q=1e7/m; D=1e-3 J/m²", "steps": ["Substitution gives wD=Dq for this convention."], "result": "wD=1e4 J/m³; reversing q reverses the sign", "units": "J/m^3"}, "limitingCases": ["D=0 restores degeneracy of opposite chiralities for this term."], "pitfalls": ["Bulk D m dot curl m is a different invariant; surface D_s in J/m must be divided by thickness to compare this effective D."], "sourceIds": ["mag-src-mumax"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-lex"><data key="title">Magnetostatic exchange length</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">approximation</data><data key="metadata">{"id": "mag-f-lex", "topicId": "mag-discretization", "title": "Magnetostatic exchange length", "latex": "\\ell_{ex}=\\sqrt{\\frac{2A}{\\mu_0 M_s^2}}", "plain": "Exchange and magnetostatic energy density scales define a useful resolution length.", "variables": [{"symbol": "mu0", "meaning": "vacuum magnetic permeability, measured CODATA constant", "unit": "H/m", "kind": "constant"}, {"symbol": "A", "meaning": "exchange stiffness", "unit": "J/m", "kind": "coupling"}, {"symbol": "Ms", "meaning": "saturation magnetization", "unit": "A/m", "kind": "scalar"}, {"symbol": "lex", "meaning": "exchange length", "unit": "m", "kind": "scalar"}], "conditions": ["Continuum ferromagnet; a characteristic scale, not a universal sufficient mesh certificate."], "derivation": ["Balance gradient density A/ell² against mu0 Ms²/2.", "Solve for ell."], "workedExample": {"inputs": "A=1.3e-11 J/m; Ms=8e5 A/m", "steps": ["Evaluate sqrt(2*1.3e-11/(mu0*(8e5)^2))."], "result": "lex≈5.69 nm", "units": "m"}, "limitingCases": ["Increasing A broadens the scale; increasing Ms reduces it."], "pitfalls": ["DMI, anisotropy, interfaces and convergence may require smaller cells than this estimate."], "sourceIds": ["mag-src-mumax"], "status": "approximation", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-wall"><data key="title">Ideal one-dimensional domain wall</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">approximation</data><data key="metadata">{"id": "mag-f-wall", "topicId": "mag-wallwidth", "title": "Ideal one-dimensional domain wall", "latex": "\\Delta=\\sqrt{A/K},\\quad\\sigma=4\\sqrt{AK}", "plain": "Exchange and positive uniaxial anisotropy set a wall parameter and surface energy.", "variables": [{"symbol": "Delta", "meaning": "wall profile parameter, not necessarily reported full width", "unit": "m", "kind": "scalar"}, {"symbol": "A", "meaning": "exchange stiffness", "unit": "J/m", "kind": "coupling"}, {"symbol": "K", "meaning": "positive effective anisotropy", "unit": "J/m^3", "kind": "coupling"}, {"symbol": "sigma", "meaning": "wall energy per wall area", "unit": "J/m^2", "kind": "scalar"}], "conditions": ["One-dimensional180degree wall, no DMI or nonlocal demagnetizing correction; fixed opposite domains."], "derivation": ["Minimize integral[A(theta prime)²+K sin²theta] dx.", "First integral gives A(theta prime)²=K sin²theta; integrate the wall energy."], "workedExample": {"inputs": "A=1e-11 J/m; K=1e5 J/m³", "steps": ["Delta=sqrt(1e-16)=1e-8 m.", "sigma=4sqrt(1e-6)."], "result": "Delta=10 nm; sigma=0.004 J/m²", "units": "m; J/m^2"}, "limitingCases": ["K→0 broadens the wall and invalidates isolated localized-wall assumptions in a finite sample."], "pitfalls": ["Some papers call pi*Delta the wall width; define the convention before comparison."], "sourceIds": ["mag-src-mumax"], "status": "approximation", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-kittel"><data key="title">Thin-film macrospin resonance</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">approximation</data><data key="metadata">{"id": "mag-f-kittel", "topicId": "mag-resonance", "title": "Thin-film macrospin resonance", "latex": "f=\\frac{\\gamma}{2\\pi}\\sqrt{B_H(B_H+\\mu_0 M_{eff})}", "plain": "Two restoring-field curvatures set the in-plane uniform-mode frequency.", "variables": [{"symbol": "mu0", "meaning": "vacuum magnetic permeability, measured CODATA constant", "unit": "H/m", "kind": "constant"}, {"symbol": "f", "meaning": "resonance frequency", "unit": "Hz", "kind": "scalar"}, {"symbol": "gamma", "meaning": "positive gyromagnetic magnitude", "unit": "rad/(T s)", "kind": "constant"}, {"symbol": "BH", "meaning": "applied induction-equivalent mu0 H in plane", "unit": "T", "kind": "scalar"}, {"symbol": "Meff", "meaning": "effective magnetization including declared perpendicular anisotropy", "unit": "A/m", "kind": "scalar"}], "conditions": ["Uniform saturated film, small-angle motion, negligible damping shift; geometry/anisotropy convention specified."], "derivation": ["Linearize torque around the in-plane equilibrium.", "Combine two coupled transverse equations to obtain the product of restoring fields."], "workedExample": {"inputs": "gamma/(2pi)=28 GHz/T; BH=0.1 T; mu0 Meff=1 T", "steps": ["sqrt(0.1*1.1)=0.33166 T."], "result": "f≈9.287 GHz", "units": "Hz"}, "limitingCases": ["Setting Meff=0 reduces the expression to the simple Larmor frequency."], "pitfalls": ["Do not insert H in A/m into a formula whose field arguments are tesla."], "sourceIds": ["mag-src-mumax"], "status": "approximation", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-magnon"><data key="title">Exchange-dominated spin-wave limit</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">approximation</data><data key="metadata">{"id": "mag-f-magnon", "topicId": "mag-spinwave", "title": "Exchange-dominated spin-wave limit", "latex": "\\omega(k)=\\gamma[B_0+2Ak^2/M_s]", "plain": "A uniformly magnetized exchange continuum has quadratic wavevector dispersion in this limit.", "variables": [{"symbol": "omega", "meaning": "angular frequency", "unit": "rad/s", "kind": "scalar"}, {"symbol": "gamma", "meaning": "positive gyromagnetic magnitude", "unit": "rad/(T s)", "kind": "constant"}, {"symbol": "B0", "meaning": "uniform effective bias induction", "unit": "T", "kind": "scalar"}, {"symbol": "A", "meaning": "exchange stiffness", "unit": "J/m", "kind": "coupling"}, {"symbol": "k", "meaning": "wavevector magnitude", "unit": "1/m", "kind": "coordinate"}, {"symbol": "Ms", "meaning": "saturation magnetization", "unit": "A/m", "kind": "scalar"}], "conditions": ["Small-amplitude mode, uniform equilibrium, neglect dipolar dispersion/anisotropy or absorb appropriate constants in B0."], "derivation": ["Insert a transverse plane wave into the exchange field.", "Linearize undamped LLG to get precession with the shifted restoring field."], "workedExample": {"inputs": "A=1e-11 J/m; Ms=8e5 A/m; k=1e7/m; gamma/(2pi)=28 GHz/T", "steps": ["Exchange induction=0.0025 T."], "result": "Exchange frequency shift=70 MHz", "units": "Hz"}, "limitingCases": ["As k→0 the exchange shift vanishes, but other gap terms may remain."], "pitfalls": ["A measured film mode can be dipolar, exchange-dominated or mixed; this is not the entire magnon spectrum."], "sourceIds": ["mag-src-mumax"], "status": "approximation", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-topology"><data key="title">Skyrmion degree</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">conditional-result</data><data key="metadata">{"id": "mag-f-topology", "topicId": "mag-skyrmions", "title": "Skyrmion degree", "latex": "Q=\\frac{1}{4\\pi}\\int\\mathbf m\\cdot(\\partial_x\\mathbf m\\times\\partial_y\\mathbf m)\\,dxdy", "plain": "An oriented smooth two-dimensional spin texture maps the compactified plane to the unit sphere.", "variables": [{"symbol": "Q", "meaning": "topological degree", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "m", "meaning": "smooth unit magnetization", "unit": "dimensionless", "kind": "state"}, {"symbol": "x", "meaning": "in-plane coordinate", "unit": "m", "kind": "coordinate"}, {"symbol": "y", "meaning": "second in-plane coordinate", "unit": "m", "kind": "coordinate"}], "conditions": ["Fixed common boundary direction or compact domain; no singular point where |m| vanishes."], "derivation": ["Integrate oriented area swept on the unit sphere and normalize by4pi.", "For an axisymmetric texture reduce the integral to azimuthal winding and polar endpoint values."], "workedExample": {"inputs": "Azimuthal winding n=1; core theta=pi; boundary theta=0", "steps": ["Q=(n/2)[cos(theta_core)−cos(theta_boundary)] in this coordinate convention."], "result": "Q=−1; reversing orientation conventions can reverse its sign", "units": "dimensionless"}, "limitingCases": ["A uniform state has Q=0; a boundary-unfixed partial texture need not give an integer."], "pitfalls": ["Topological charge alone does not guarantee infinite lifetime or free energy; boundaries and singular events permit changes."], "sourceIds": ["mag-src-skyrmion"], "status": "conditional-result", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-spin-hall"><data key="title">Spin Hall normalization</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">conditional-result</data><data key="metadata">{"id": "mag-f-spin-hall", "topicId": "mag-spinHall", "title": "Spin Hall normalization", "latex": "j_s^{(ang)}=\\frac{\\hbar}{2e}\\theta_{SH}j_c", "plain": "A declared scalar spin Hall angle relates selected spin-angular-momentum flux to charge current density.", "variables": [{"symbol": "js", "meaning": "selected spin-angular-momentum flux component", "unit": "J/m^2", "kind": "tensor"}, {"symbol": "jc", "meaning": "charge-current density component", "unit": "A/m^2", "kind": "scalar"}, {"symbol": "hbar", "meaning": "reduced Planck constant", "unit": "J s", "kind": "constant"}, {"symbol": "e", "meaning": "positive elementary charge", "unit": "C", "kind": "constant"}, {"symbol": "thetaSH", "meaning": "signed conversion angle for stated axes", "unit": "dimensionless", "kind": "coupling"}], "conditions": ["A specified material, transport geometry and spin polarization convention; tensor character suppressed only for one chosen component.", "For this scalar example define charge along+x, flux along+z and polarization along+y; the signed thetaSH is defined for exactly that ordered axis choice."], "derivation": ["Express spin flux as angular momentum per transported carrier.", "Define thetaSH by the ratio of normalized transverse spin flux to charge flux."], "workedExample": {"inputs": "thetaSH=0.1; jc=1e10 A/m²", "steps": ["hbar/(2e)=3.29106e-16 J s/C."], "result": "js=3.29106e-7 J/m² in the angular-momentum-flux convention", "units": "J/m^2"}, "limitingCases": ["Changing spin-flux convention to charge-equivalent A/m² removes the hbar/(2e) prefactor."], "pitfalls": ["A spin current is not an extra source of energy; injector electrical power and interface losses remain.", "A spin Hall angle is a normalization-dependent conversion ratio, not an event probability; its magnitude is not universally bounded by1."], "sourceIds": ["mag-src-ruo2-2026"], "status": "conditional-result", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-sot"><data key="title">Damping-like spin–orbit torque</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">conditional-result</data><data key="metadata">{"id": "mag-f-sot", "topicId": "mag-sot", "title": "Damping-like spin–orbit torque", "latex": "\\dot{\\mathbf m}_{DL}=\\gamma B_{DL}\\,\\mathbf m\\times(\\mathbf s\\times\\mathbf m)", "plain": "A transverse angular-momentum input can reorient an ordered moment.", "variables": [{"symbol": "m", "meaning": "unit magnetization", "unit": "dimensionless", "kind": "state"}, {"symbol": "s", "meaning": "unit injected spin-polarization axis", "unit": "dimensionless", "kind": "vector"}, {"symbol": "gamma", "meaning": "positive gyromagnetic magnitude", "unit": "rad/(T s)", "kind": "constant"}, {"symbol": "BDL", "meaning": "signed effective damping-like torque induction", "unit": "T", "kind": "coupling"}, {"symbol": "t", "meaning": "time", "unit": "s", "kind": "coordinate"}], "conditions": ["A selected torque term in an explicitly powered model; two-sublattice AFMs require the corresponding sublattice torques."], "derivation": ["Resolve the injected spin into the tangent plane perpendicular to m.", "Use m cross(s cross m)=s−(m dot s)m."], "workedExample": {"inputs": "m=xhat; s=zhat; gamma=1.76e11; BDL=0.001 T", "steps": ["The tangent direction is zhat; instantaneous rate scale is gamma BDL."], "result": "dm/dt=1.76e8 zhat per second for this isolated term", "units": "1/s"}, "limitingCases": ["Collinear s and m give zero torque for this term."], "pitfalls": ["Switching depends on competing fields, pulse shape and heating; a torque expression is not a complete switching prediction."], "sourceIds": ["mag-src-sot"], "status": "conditional-result", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-london"><data key="title">London penetration in a half-space</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">established-model</data><data key="metadata">{"id": "mag-f-london", "topicId": "mag-london", "title": "London penetration in a half-space", "latex": "\\nabla^2\\mathbf B=\\mathbf B/\\lambda_L^2,\\quad B(z)=B(0)e^{-z/\\lambda_L}", "plain": "Local superfluid screening produces exponential equilibrium penetration in the simple half-space.", "variables": [{"symbol": "B", "meaning": "magnetic induction", "unit": "T", "kind": "vector"}, {"symbol": "z", "meaning": "depth into superconducting half-space", "unit": "m", "kind": "coordinate"}, {"symbol": "lambdaL", "meaning": "London penetration depth", "unit": "m", "kind": "scalar"}, {"symbol": "nabla", "meaning": "spatial derivative", "unit": "1/m", "kind": "operator"}], "conditions": ["Static homogeneous London regime, planar surface, weak fields without vortices or strong nonlocality; bulk boundary B→0."], "derivation": ["Combine curl js=−B/(mu0 lambdaL²) with stationary Ampere law and divergence B=0.", "Select the decaying solution of the one-dimensional second-order equation."], "workedExample": {"inputs": "B(0)=1 mT; lambdaL=100 nm; z=200 nm", "steps": ["The exponent is−2."], "result": "B=0.135335 mT", "units": "T"}, "limitingCases": ["The growing exponential is excluded by the bulk boundary condition."], "pitfalls": ["An ideal perfect conductor preserves initial flux; equilibrium Meissner expulsion needs more than infinite DC conductivity."], "sourceIds": ["mag-src-mit-london"], "status": "established-model", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-fluxquantum"><data key="title">Superconducting flux quantum and fluxoid</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">conditional-result</data><data key="metadata">{"id": "mag-f-fluxquantum", "topicId": "mag-fluxoid", "title": "Superconducting flux quantum and fluxoid", "latex": "\\Phi_0=\\frac{h}{2e},\\quad\\Phi_B+\\mu_0\\lambda_L^2\\oint\\mathbf j_s\\cdot d\\boldsymbol\\ell=n\\Phi_0", "plain": "Single-valued pair phase quantizes a fluxoid, with magnetic flux alone recovered when the current term is negligible.", "variables": [{"symbol": "mu0", "meaning": "vacuum magnetic permeability, measured CODATA constant", "unit": "H/m", "kind": "constant"}, {"symbol": "Phi0", "meaning": "pair flux quantum", "unit": "Wb", "kind": "constant"}, {"symbol": "h", "meaning": "Planck constant", "unit": "J s", "kind": "constant"}, {"symbol": "e", "meaning": "positive elementary charge", "unit": "C", "kind": "constant"}, {"symbol": "PhiB", "meaning": "magnetic flux through contour", "unit": "Wb", "kind": "scalar"}, {"symbol": "lambdaL", "meaning": "London penetration depth", "unit": "m", "kind": "scalar"}, {"symbol": "js", "meaning": "supercurrent density", "unit": "A/m^2", "kind": "vector"}, {"symbol": "dl", "meaning": "oriented superconducting path element", "unit": "m", "kind": "vector"}, {"symbol": "n", "meaning": "integer phase winding", "unit": "dimensionless", "kind": "scalar"}], "conditions": ["Closed contour in a coherent superconducting region; conventional2e pairing assumed; finite kinetic-current correction retained."], "derivation": ["Integrate the gauge-invariant phase-gradient relation around a closed loop.", "Phase change is2pi n; retain both vector-potential and supercurrent terms."], "workedExample": {"inputs": "h=6.62607015e-34 J s; e=1.602176634e-19 C; n=1; negligible current correction", "steps": ["Divide h by2e."], "result": "Phi0=2.067833848e-15 Wb", "units": "Wb"}, "limitingCases": ["In thin/high-kinetic-inductance loops, flux need not equal nPhi0 even though fluxoid does."], "pitfalls": ["Flux quantization is not a universal quantization of arbitrary classical coil flux."], "sourceIds": ["mag-src-mit-fluxoid", "mag-src-nist"], "status": "conditional-result", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-gl"><data key="title">Ginzburg–Landau scale ratio</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">approximation</data><data key="metadata">{"id": "mag-f-gl", "topicId": "mag-gl", "title": "Ginzburg–Landau scale ratio", "latex": "\\kappa=\\lambda/\\xi,\\quad B_{c2}\\simeq\\frac{\\Phi_0}{2\\pi\\xi^2}", "plain": "Penetration and coherence scales organize superconducting interfaces and the orbital upper critical field.", "variables": [{"symbol": "kappa", "meaning": "GL parameter", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "lambda", "meaning": "penetration depth in the model", "unit": "m", "kind": "scalar"}, {"symbol": "xi", "meaning": "GL coherence length", "unit": "m", "kind": "scalar"}, {"symbol": "Bc2", "meaning": "orbital upper critical induction", "unit": "T", "kind": "scalar"}, {"symbol": "Phi0", "meaning": "pair flux quantum", "unit": "Wb", "kind": "constant"}], "conditions": ["Conventional isotropic GL description near its controlled transition regime; orbital limit, neglect paramagnetic/multiband modifications."], "derivation": ["Nondimensionalize the GL equations by lambda and xi.", "Linearized order-parameter onset in a uniform field gives the orbital length condition."], "workedExample": {"inputs": "lambda=100 nm; xi=10 nm; Phi0=2.067833848e-15 Wb", "steps": ["kappa=10; Bc2=Phi0/(2pi*1e-16 m²)."], "result": "kappa=10; Bc2≈3.29 T in this orbital approximation", "units": "dimensionless; T"}, "limitingCases": ["The GL interface crossover is kappa=1/sqrt2 under the standard isotropic premises."], "pitfalls": ["A material measured far from Tc may require a microscopic theory; this is not its universal critical field.", "These sources support the Landau/phase and flux-quantum ingredients. A direct original GL/Hc2 source was not reviewed; the stated orbital formula is the explanatory linear-GL reconstruction, not a result inferred from the graphene preprint."], "sourceIds": ["mag-src-tong-phase", "mag-src-mit-fluxoid"], "status": "approximation", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-me"><data key="title">SI magnetoelectric cross derivative</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">conditional-result</data><data key="metadata">{"id": "mag-f-me", "topicId": "mag-magnetoelectric", "title": "SI magnetoelectric cross derivative", "latex": "g_{ME}=-\\alpha_{ij}E_iH_j,\\quad P_i=\\alpha_{ij}H_j,\\quad\\mu_0 M_j=\\alpha_{ij}E_i", "plain": "A reciprocal static cross response follows from one explicitly chosen thermodynamic potential.", "variables": [{"symbol": "mu0", "meaning": "vacuum magnetic permeability, measured CODATA constant", "unit": "H/m", "kind": "constant"}, {"symbol": "gME", "meaning": "magnetoelectric free-energy density term", "unit": "J/m^3", "kind": "scalar"}, {"symbol": "alphaij", "meaning": "linear SI magnetoelectric tensor in this E,H convention", "unit": "s/m", "kind": "tensor"}, {"symbol": "Ei", "meaning": "electric field component", "unit": "V/m", "kind": "scalar"}, {"symbol": "Hj", "meaning": "magnetic field-intensity component", "unit": "A/m", "kind": "scalar"}, {"symbol": "Pi", "meaning": "electric polarization component", "unit": "C/m^2", "kind": "scalar"}, {"symbol": "Mj", "meaning": "magnetization component", "unit": "A/m", "kind": "scalar"}, {"symbol": "i,j", "meaning": "Cartesian indices summed when repeated", "unit": "dimensionless", "kind": "coordinate"}], "conditions": ["Equilibrium reversible small-field expansion at fixed declared thermodynamic variables; allowed tensor components depend on symmetry."], "derivation": ["Use dg=−P dot dE−mu0 M dot dH for the selected material contribution.", "Differentiate the bilinear cross term and equate mixed derivatives."], "workedExample": {"inputs": "alpha_zz=1e-12 s/m; Hz=1e5 A/m; Ez=0", "steps": ["Pz=alpha Hz."], "result": "Pz=1e-7 C/m²", "units": "C/m^2"}, "limitingCases": ["A coefficient defined using B or electric displacement instead of H/E has different factors and potentially units."], "pitfalls": ["The layer-pseudospin polarizability in the selected bilayer paper is not silently identified with this bulk SI coefficient.", "Only for volumetric M and a fixed uniform constitutive D=epsilon E can alpha_(E,H)=mu0*epsilon*(partial M/partial D). A two-dimensional layer moment may additionally require a thickness normalization; none is silently supplied."], "sourceIds": ["mag-src-magnetoelectric"], "status": "conditional-result", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-nv"><data key="title">NV axial Zeeman splitting</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">approximation</data><data key="metadata">{"id": "mag-f-nv", "topicId": "mag-nv", "title": "NV axial Zeeman splitting", "latex": "\\nu_\\pm\\simeq D\\pm\\frac{\\gamma_e}{2\\pi}B_\\parallel", "plain": "A simple axial NV-center model converts a calibrated spin transition shift into a field projection.", "variables": [{"symbol": "nuplus, numinus", "meaning": "spin transition frequencies", "unit": "Hz", "kind": "scalar"}, {"symbol": "D", "meaning": "zero-field splitting parameter, temperature dependent", "unit": "Hz", "kind": "coupling"}, {"symbol": "gammae", "meaning": "positive electron gyromagnetic magnitude", "unit": "rad/(T s)", "kind": "constant"}, {"symbol": "Bparallel", "meaning": "field projection along the known NV axis", "unit": "T", "kind": "scalar"}], "conditions": ["Weak suitably aligned field, negligible transverse mixing/strain or independently calibrated corrections; approximate spin1 Hamiltonian."], "derivation": ["Diagonalize D Sz²+gammae Bparallel Sz/(2pi) in frequency units.", "Transition shifts are opposite for the m_s=±1 branches."], "workedExample": {"inputs": "gammae/(2pi)=28 GHz/T; Bparallel=100 microtesla", "steps": ["Shift magnitude=28e9*1e-4 Hz."], "result": "Each branch shifts2.8 MHz; branch separation changes5.6 MHz", "units": "Hz"}, "limitingCases": ["Temperature drift in D shifts both branches and can mimic single-line field changes."], "pitfalls": ["One NV axis measures a projection, not an unconstrained three-component vector field."], "sourceIds": ["mag-src-inverse-nv"], "status": "approximation", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-height"><data key="title">Stray-field Fourier height filtering</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">conditional-result</data><data key="metadata">{"id": "mag-f-height", "topicId": "mag-continuation", "title": "Stray-field Fourier height filtering", "latex": "\\widetilde B(\\mathbf k,z)=\\widetilde B(\\mathbf k,0)e^{-|\\mathbf k|z}", "plain": "In a source-free half-space, lateral high-spatial-frequency magnetic structure decays with height.", "variables": [{"symbol": "Btilde", "meaning": "lateral Fourier field amplitude under a fixed transform convention", "unit": "T m^2", "kind": "state"}, {"symbol": "k", "meaning": "lateral angular wavevector", "unit": "1/m", "kind": "vector"}, {"symbol": "z", "meaning": "height above planar source region", "unit": "m", "kind": "coordinate"}], "conditions": ["Planar Fourier analysis in a homogeneous source-free half-space; choose the solution decaying at infinity."], "derivation": ["A scalar magnetic potential satisfies Laplace equation above sources.", "Fourier transform laterally to obtain partial_z² potential=|k|² potential."], "workedExample": {"inputs": "Wavelength=100 nm; sensor height=50 nm", "steps": ["|k|z=2pi*50/100=pi."], "result": "Amplitude attenuation=e^−pi≈0.04321; inverse amplification≈23.14", "units": "dimensionless amplitude ratio"}, "limitingCases": ["At k=0 the exponential is1, but boundary/source constraints can make particular uniform channels unobservable."], "pitfalls": ["Exact back-propagation multiplies noise exponentially; regularization adds assumptions, not missing data."], "sourceIds": ["mag-src-inverse-nv"], "status": "conditional-result", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-uncertainty"><data key="title">Correlated first-order uncertainty propagation</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">approximation</data><data key="metadata">{"id": "mag-f-uncertainty", "topicId": "mag-uncertainty", "title": "Correlated first-order uncertainty propagation", "latex": "u_y^2\\simeq\\sum_{ij}\\frac{\\partial f}{\\partial x_i}\\frac{\\partial f}{\\partial x_j}\\operatorname{Cov}(x_i,x_j)", "plain": "A local sensitivity Jacobian propagates a declared input covariance into output variance.", "variables": [{"symbol": "uy", "meaning": "standard uncertainty of y", "unit": "same as y", "kind": "scalar"}, {"symbol": "f", "meaning": "differentiable measurement function", "unit": "declared output unit", "kind": "operator"}, {"symbol": "xi", "meaning": "input quantities", "unit": "declared per input", "kind": "scalar"}, {"symbol": "Cov", "meaning": "input covariance, product of input units", "unit": "unit(xi) unit(xj)", "kind": "tensor"}, {"symbol": "i,j", "meaning": "input indices", "unit": "dimensionless", "kind": "coordinate"}], "conditions": ["Small enough uncertainties for linearization; covariance and model must be justified independently."], "derivation": ["Taylor-expand output around nominal inputs.", "Take variance of the linearized combination, retaining cross terms."], "workedExample": {"inputs": "y=x1−x2; each standard uncertainty=1 microtesla; correlationrho=0.9", "steps": ["Variance=(1+1−2*0.9) microtesla²=0.2."], "result": "uy≈0.447214 microtesla", "units": "T"}, "limitingCases": ["Perfect common-mode correlation cancels in a difference only for matched sensitivities."], "pitfalls": ["Ignoring covariance can overstate or understate uncertainty; no automatic95percent confidence follows from an arbitrary bound."], "sourceIds": ["mag-src-gum"], "status": "approximation", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-f-inverse-witness"><data key="title">Two-dipole observation matrix and an explicit kernel</data><data key="kind">formula</data><data key="domain">magnetism</data><data key="status">conditional-result</data><data key="metadata">{"id": "mag-f-inverse-witness", "topicId": "mag-nullspace", "title": "Two-dipole observation matrix and an explicit kernel", "latex": "\\mathbf y=K\\mathbf m,\\quad K=(c\\;c),\\quad\\ker K=\\operatorname{span}\\{(1,-1)^T\\}", "plain": "A centred Bz measurement cannot distinguish two equally oriented dipoles at mirror-symmetric known positions.", "variables": [{"symbol": "y", "meaning": "observed axial flux-density samples", "unit": "T", "kind": "vector"}, {"symbol": "K", "meaning": "known dipole forward matrix for specified sensor/source geometry", "unit": "T/(A m^2)", "kind": "operator"}, {"symbol": "m", "meaning": "two unknownz-directed dipole moments", "unit": "A m^2", "kind": "state"}, {"symbol": "c", "meaning": "common knownBz coupling coefficient at a symmetry-axis observation", "unit": "T/(A m^2)", "kind": "coupling"}], "conditions": ["Two ideal point dipoles atx=±a,y=z=0 withfixedz orientation;point-dipole far-field premise;known a andsensorheight h.", "OneBz channel atx=y=0;the twounknowns are moments,notunknown positions/orientations."], "derivation": ["The vacuum dipole kernel gives c=(mu0/4pi)(2h²−a²)/(a²+h²)^(5/2), wherea,h arelengths inmetres andmu0 isvacuum permeability.", "Forc≠0 the1×2operator hasrank1andnullity1:K(1,−1)^T=0 although its onlyreturned singular value issqrt(2)|c|&gt;0."], "workedExample": {"inputs": "a=1m,h=2m;moments(2,1)A m²", "steps": ["c=1.2521980672e−8 T/(A m²);centredreadingdepends onlyonm1+m2.", "AddBz atx=0.5m,z=2m:then the2×2matrixdeterminant is1.8688737689e−16[T/(A m²)]²andthe two-moment toy becomesinvertible."], "result": "A singlemeasurement admits(2+t,1−t)for everyt;the off-axis secondmeasurementrecovers(2,1)withfloating errorbelow1e−12 inthis executedexample.", "units": "T;A m^2"}, "limitingCases": ["Repeatingcentredmeasurements atthreeheights2,3,4mstillhasrank1andnullity1becauseeachrow retains identicalcolumns.", "Choosingh=a/sqrt2makesc=0andthe singleobservationrank0;anunmentionedzero-coupling casewouldinvalidatethe rank1claim."], "pitfalls": ["Full-rank forthe restrictedtwo-moment toydoesnotprove uniquenessofanarbitrarycontinuum vector magnetization.", "Invertibility isnot goodnoiseconditioning;report sensitivity,geometryuncertaintyandnoiseafterchoosing measurementunits/scales."], "sourceIds": ["mag-src-mit-vector", "mag-src-inverse-nv"], "status": "conditional-result", "kind": "formula", "domain": "magnetism"}</data></node><node id="mag-src-nist"><data key="title">CODATA2022 vacuum magnetic permeability</data><data key="kind">source</data><data key="domain">magnetism</data><data key="status">selected-text</data><data key="metadata">{"id": "mag-src-nist", "title": "CODATA2022 vacuum magnetic permeability", "url": "https://physics.nist.gov/cgi-bin/cuu/Value?mu0", "authors": "NIST / CODATA", "year": 2022, "version": "2022 recommended values, retrieved2026-11-25", "kind": "source", "status": "selected-text", "readDepth": "Numerical value and standard/relative uncertainty read", "sectionsRead": ["Value table; uncertainty and CODATA attribution"], "claim": "mu0 is a measured constant in the revised SI, not an exact4pi*1e-7 definition.", "limitations": "A constants page does not validate any material or instrument.", "passageKind": "research-note", "note": "The tabulated value is1.25663706127(20)e-6 N/A².", "capture": "docs/field-atlas/sources/magnetism/nist-mu0.html", "sha256": "acf5245a18c0c09283ad9e5cb493554e003564bcc78ae0b1e098139e68d1898b", "retrievedAt": "2026-11-25T06:23:59.335613+00:00", "domain": "magnetism", "recordKind": "official-data", "sourceKind": "official-data"}</data></node><node id="mag-src-mit-vector"><data key="title">Vector potential and vector Poisson equation §8.1</data><data key="kind">source</data><data key="domain">magnetism</data><data key="status">selected-text</data><data key="metadata">{"id": "mag-src-mit-vector", "title": "Vector potential and vector Poisson equation §8.1", "url": "https://web.mit.edu/6.013_book/www/chapter8/8.1.html", "authors": "Hermann A. Haus and James R. Melcher", "year": 1989, "version": "Online textbook chapter captured2026-11-25", "kind": "source", "status": "selected-text", "readDepth": "Selected complete prose of the indicated section; some source equations are image-rendered, not independently OCR-transcribed", "sectionsRead": ["Opening derivation and boundary/constitutive discussion"], "claim": "Classical field representations, induction and energy accounting are conditional on the stated electromagnetic approximation.", "limitations": "Our explicit equations are explanatory reconstructions; source image equations and the full book were not exhaustively audited.", "passageKind": "research-note", "note": "The selected section separates mathematical field equations from additional constitutive or boundary information.", "capture": "docs/field-atlas/sources/magnetism/mit-ampere.html", "sha256": "c3f1c669438bdb7060b8b4345ae5fef826edfd6737473202366b4ef313910900", "retrievedAt": "2026-11-25T06:23:59.890863+00:00", "domain": "magnetism", "recordKind": "textbook", "sourceKind": "textbook"}</data></node><node id="mag-src-mit-induction"><data key="title">MQS electric fields and perfect conductors §10.1</data><data key="kind">source</data><data key="domain">magnetism</data><data key="status">selected-text</data><data key="metadata">{"id": "mag-src-mit-induction", "title": "MQS electric fields and perfect conductors §10.1", "url": "https://web.mit.edu/6.013_book/www/chapter10/10.1.html", "authors": "Hermann A. Haus and James R. Melcher", "year": 1989, "version": "Online textbook chapter captured2026-11-25", "kind": "source", "status": "selected-text", "readDepth": "Selected complete prose of the indicated section; some source equations are image-rendered, not independently OCR-transcribed", "sectionsRead": ["Opening derivation and boundary/constitutive discussion"], "claim": "Classical field representations, induction and energy accounting are conditional on the stated electromagnetic approximation.", "limitations": "Our explicit equations are explanatory reconstructions; source image equations and the full book were not exhaustively audited.", "passageKind": "research-note", "note": "The selected section separates mathematical field equations from additional constitutive or boundary information.", "capture": "docs/field-atlas/sources/magnetism/mit-induction.html", "sha256": "11afd3feb1d28f9e1a2c5ebbf0b3244b80489c31e314ab3a498e888ff835a81c", "retrievedAt": "2026-11-25T06:23:59.505349+00:00", "domain": "magnetism", "recordKind": "textbook", "sourceKind": "textbook"}</data></node><node id="mag-src-mit-energy"><data key="title">Poynting theorem §11.2</data><data key="kind">source</data><data key="domain">magnetism</data><data key="status">selected-text</data><data key="metadata">{"id": "mag-src-mit-energy", "title": "Poynting theorem §11.2", "url": "https://web.mit.edu/6.013_book/www/chapter11/11.2.html", "authors": "Hermann A. Haus and James R. Melcher", "year": 1989, "version": "Online textbook chapter captured2026-11-25", "kind": "source", "status": "selected-text", "readDepth": "Selected complete prose of the indicated section; some source equations are image-rendered, not independently OCR-transcribed", "sectionsRead": ["Opening derivation and boundary/constitutive discussion"], "claim": "Classical field representations, induction and energy accounting are conditional on the stated electromagnetic approximation.", "limitations": "Our explicit equations are explanatory reconstructions; source image equations and the full book were not exhaustively audited.", "passageKind": "research-note", "note": "The selected section separates mathematical field equations from additional constitutive or boundary information.", "capture": "docs/field-atlas/sources/magnetism/mit-poynting.html", "sha256": "c092e1c44d34ef6925e0057b2ddf401b01ecb48d765d8deed45efb3825f5b9ff", "retrievedAt": "2026-11-25T06:23:59.552264+00:00", "domain": "magnetism", "recordKind": "textbook", "sourceKind": "textbook"}</data></node><node id="mag-src-mumax"><data key="title">The design and verification of Mumax3</data><data key="kind">source</data><data key="domain">magnetism</data><data key="status">selected-text</data><data key="metadata">{"id": "mag-src-mumax", "title": "The design and verification of Mumax3", "url": "https://arxiv.org/html/1406.7635", "authors": "Arne Vansteenkiste; Jonathan Leliaert; Mykola Dvornik; Felipe Garcia-Sanchez; Bartel Van Waeyenberge", "year": 2014, "version": "arXiv:1406.7635v3", "kind": "source", "status": "selected-text", "readDepth": "Abstract, introduction, III.1/III.3/III.4 and selected standard-problem passages read", "sectionsRead": ["Abstract; I; III.1; III.3; III.4; V.1–V.2 selected paragraphs"], "claim": "Finite-difference micromagnetics can be verified against analytic and standard-problem cases.", "limitations": "No software was executed here; source notes disagreement among submitted solutions for standard problem1. Signed gamma_LL convention must be translated.", "passageKind": "research-note", "note": "The paper exposes discretization, DMI boundary conditions and benchmark limits rather than declaring every simulation physically validated.", "capture": "docs/field-atlas/sources/magnetism/mumax-paper.html", "sha256": "2c6b156b838c260a8199ac2cf7c93eb7a15f9263d22b211e506d9ce38b418c0d", "retrievedAt": "2026-11-25T06:23:59.212646+00:00", "doi": "10.48550/arXiv.1406.7635", "domain": "magnetism", "recordKind": "primary-paper", "sourceKind": "primary-paper"}</data></node><node id="mag-src-alt-theory"><data key="title">Beyond conventional ferromagnetism and antiferromagnetism: a phase with nonrelativistic spin and crystal rotation symmetry</data><data key="kind">source</data><data key="domain">magnetism</data><data key="status">abstract-only</data><data key="metadata">{"id": "mag-src-alt-theory", "title": "Beyond conventional ferromagnetism and antiferromagnetism: a phase with nonrelativistic spin and crystal rotation symmetry", "url": "https://arxiv.org/abs/2105.05820", "authors": "Libor Šmejkal and coauthors", "year": 2022, "version": "arXiv:2105.05820v2; related PRX12,031042", "kind": "source", "status": "abstract-only", "readDepth": "abstract-only; arXiv identity/version and related DOI read", "sectionsRead": ["Abstract; submission history; related DOI"], "claim": "Spin-group classification permits compensated collinear order with alternating spin-momentum splitting.", "limitations": "Abstract-only in this pass; a classification is not proof that every proposed candidate orders magnetically.", "passageKind": "research-note", "note": "The symmetry proposal separates nonrelativistic spin splitting from ordinary net-moment ferromagnetism.", "capture": "docs/field-atlas/sources/magnetism/altermagnet-theory.html", "sha256": "cec9557e2ccb928fb6ba017ff07bf3f07cf1dfc7d62660439a5b692d0f0c8342", "retrievedAt": "2026-11-25T06:23:58.921852+00:00", "doi": "10.1103/PhysRevX.12.031042", "domain": "magnetism", "recordKind": "primary-paper", "sourceKind": "primary-paper"}</data></node><node id="mag-src-mnte"><data key="title">Altermagnetic lifting of Kramers spin degeneracy</data><data key="kind">source</data><data key="domain">magnetism</data><data key="status">selected-text</data><data key="metadata">{"id": "mag-src-mnte", "title": "Altermagnetic lifting of Kramers spin degeneracy", "url": "https://arxiv.org/html/2308.10681", "authors": "J. Krempaský; L. Šmejkal; S. W. D’Souza and coauthors", "year": 2023, "version": "arXiv:2308.10681v1; later journal publication not independently recaptured", "kind": "source", "status": "selected-text", "readDepth": "Selected opening experimental claim and introductory symmetry discussion read", "sectionsRead": ["Opening research summary; introductory mechanism comparison"], "claim": "Photoemission and calculations are reported for compensated centrosymmetric MnTe.", "limitations": "Selected preprint passages, not a full raw-data/ARPES reanalysis; not transferable automatically to RuO2.", "passageKind": "research-note", "note": "The source reports two unconventional spin-degeneracy-lifting mechanisms in MnTe.", "capture": "docs/field-atlas/sources/magnetism/altermagnet-krempasky.html", "sha256": "83f20c35333a7e21750a4e56659bd8df4fa52fd6c407073859b31edef11535d7", "retrievedAt": "2026-11-25T06:23:59.169033+00:00", "doi": "10.48550/arXiv.2308.10681", "domain": "magnetism", "recordKind": "preprint", "sourceKind": "preprint"}</data></node><node id="mag-src-ruo2-null"><data key="title">A meta-GGA perpective on the altermagnetism of RuO2</data><data key="kind">source</data><data key="domain">magnetism</data><data key="status">selected-text</data><data key="metadata">{"id": "mag-src-ruo2-null", "title": "A meta-GGA perpective on the altermagnetism of RuO2", "url": "https://arxiv.org/html/2512.04995", "authors": "Markus Meinert", "year": 2025, "version": "arXiv:2512.04995v1", "kind": "source", "status": "selected-text", "readDepth": "Selected abstract/conclusion plusMethods andground-state paragraphsII–III.2 read.", "sectionsRead": ["Abstract;II Methods;III.2 ground-state paragraph;IV Conclusion"], "claim": "A higher-rung r2SCAN-L calculation retains a nonmagnetic ideal bulk state while predicting strain/doping thresholds.", "limitations": "FP-LAPW/functional and Hubbard-U-dependent results;finite Brillouin-zone sampling andfixed-spin-moment/local-sphere definition. No independentDFT rerun oruniversal experimental absence theorem.", "passageKind": "research-note", "note": "The source specifieselk/FP-LAPW,9×9×13k sampling,Liechtenstein+U withfully localized double counting andfixedJ=0.5eV. SelectedLSDA/PBE/r2SCAN-L calculations retain a nonmagnetic bulk reference;distortion/doping conclusions remain conditional.", "capture": "docs/field-atlas/sources/magnetism/ruo2-null.html", "sha256": "bb4854a63765cdda264009e1e36b8d840efa9b40122b1677e25d90c538cdea3a", "retrievedAt": "2026-11-25T06:26:11.183645+00:00", "doi": "10.48550/arXiv.2512.04995", "domain": "magnetism", "recordKind": "preprint", "sourceKind": "preprint"}</data></node><node id="mag-src-moire"><data key="title">[2406.12250] Observation of stacking engineered magnetic phase transitions within moiré supercells of twisted van der Waals magnets</data><data key="kind">source</data><data key="domain">magnetism</data><data key="status">abstract-only</data><data key="metadata">{"id": "mag-src-moire", "title": "[2406.12250] Observation of stacking engineered magnetic phase transitions within moiré supercells of twisted van der Waals magnets", "url": "https://arxiv.org/abs/2406.12250", "authors": ["Li, Senlei", "Sun, Zeliang", "McLaughlin, Nathan J.", "Sharmin, Afsana", "Agarwal, Nishkarsh", "Huang, Mengqi", "Sung, Suk Hyun", "Lu,