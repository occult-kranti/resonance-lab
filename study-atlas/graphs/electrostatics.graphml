d": "es-spec-bridge", "title": "Capacitance bridges and guarding", "parentId": "es-sub-measurement", "level": 3, "summary": "Capacitance bridges and guarding with explicit hypotheses and a distinction between model consequences and measurements.", "coverage": "reviewed", "sourceIds": ["es-gum", "es-mit-capacitance"], "prerequisites": [], "formulaIds": ["es-f10", "es-f11", "es-f13", "es-f42"], "kind": "topic", "domain": "electrostatics"}</data></node><node id="es-line-bridge"><data key="title">Fringing, leakage and traceable uncertainty</data><data key="kind">topic</data><data key="domain">electrostatics</data><data key="status">mapped</data><data key="metadata">{"id": "es-line-bridge", "title": "Fringing, leakage and traceable uncertainty", "parentId": "es-spec-bridge", "level": 4, "summary": "Research line: fringing, leakage and traceable uncertainty. Mapped scope; only separately cited papers have an actual reading record.", "coverage": "mapped", "sourceIds": [], "prerequisites": ["es-spec-bridge"], "formulaIds": [], "kind": "topic", "domain": "electrostatics"}</data></node><node id="es-spec-kpfm"><data key="title">Kelvin probe force microscopy</data><data key="kind">topic</data><data key="domain">electrostatics</data><data key="status">reviewed</data><data key="metadata">{"id": "es-spec-kpfm", "title": "Kelvin probe force microscopy", "parentId": "es-sub-measurement", "level": 3, "summary": "Kelvin probe force microscopy with explicit hypotheses and a distinction between model consequences and measurements.", "coverage": "reviewed", "sourceIds": ["es-gum", "es-kpfm-original", "es-mit-capacitance"], "prerequisites": [], "formulaIds": ["es-f34"], "kind": "topic", "domain": "electrostatics"}</data></node><node id="es-line-kpfm"><data key="title">Tip convolution and work-function interpretation</data><data key="kind">topic</data><data key="domain">electrostatics</data><data key="status">mapped</data><data key="metadata">{"id": "es-line-kpfm", "title": "Tip convolution and work-function interpretation", "parentId": "es-spec-kpfm", "level": 4, "summary": "Research line: tip convolution and work-function interpretation. Mapped scope; only separately cited papers have an actual reading record.", "coverage": "mapped", "sourceIds": [], "prerequisites": ["es-spec-kpfm"], "formulaIds": [], "kind": "topic", "domain": "electrostatics"}</data></node><node id="es-f01"><data key="title">Coulomb force with an oriented separation</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f01", "topicId": "es-spec-coulomb", "title": "Coulomb force with an oriented separation", "latex": "\\mathbf F_{1\\leftarrow2}=\\frac{q_1q_2}{4\\pi\\epsilon_0}\\frac{\\mathbf r_1-\\mathbf r_2}{|\\mathbf r_1-\\mathbf r_2|^3}", "plain": "The force on charge1 points from2 to1 for like signs.", "variables": [{"symbol": "F", "meaning": "force on charge1", "unit": "N", "kind": "vector"}, {"symbol": "q_1", "meaning": "first charge", "unit": "C", "kind": "scalar"}, {"symbol": "q_2", "meaning": "second charge", "unit": "C", "kind": "scalar"}, {"symbol": "r_1", "meaning": "first position", "unit": "m", "kind": "coordinate"}, {"symbol": "r_2", "meaning": "second position", "unit": "m", "kind": "coordinate"}, {"symbol": "epsilon_0", "meaning": "vacuum permittivity", "unit": "F/m", "kind": "constant"}], "conditions": ["Stationary point charges in vacuum, distinct positions; microscopic linear superposition."], "derivation": ["Spherical symmetry fixes a radial field.", "Gauss flux fixes its coefficient; multiply the field of2 by q1."], "workedExample": {"inputs": "q1=q2=1nC; separation0.1m", "steps": ["Compute k=1/(4πepsilon0).", "Evaluate k*1e-18/0.01."], "result": "Repulsive force8.988e-7", "units": "N"}, "limitingCases": ["Force vanishes when either charge is zero; doubles if one charge doubles."], "pitfalls": ["The r→0 singularity is not a finite-size charge or contact-force model."], "sourceIds": ["es-mit-gauss", "es-nist-epsilon"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f02"><data key="title">Electric field as a linear source map</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f02", "topicId": "es-spec-coulomb", "title": "Electric field as a linear source map", "latex": "\\mathbf E(\\mathbf r)=\\frac1{4\\pi\\epsilon_0}\\int\\rho(\\mathbf r\\prime)\\frac{\\mathbf r-\\mathbf r\\prime}{|\\mathbf r-\\mathbf r\\prime|^3}\\,d^3r\\prime", "plain": "Integrate vector contributions, not field magnitudes.", "variables": [{"symbol": "E", "meaning": "electric field", "unit": "V/m", "kind": "vector"}, {"symbol": "rho", "meaning": "volume charge density", "unit": "C/m^3", "kind": "scalar"}, {"symbol": "r", "meaning": "observation position", "unit": "m", "kind": "coordinate"}, {"symbol": "r_prime", "meaning": "source position", "unit": "m", "kind": "coordinate"}, {"symbol": "epsilon_0", "meaning": "vacuum permittivity", "unit": "F/m", "kind": "constant"}], "conditions": ["Localized integrable source in unbounded vacuum; singular sources need distributions or a prescribed principal value."], "derivation": ["Replace a charge by rho*dV.", "Add oriented Coulomb contributions and pass to the continuum integral."], "workedExample": {"inputs": "Two equal charges at±a; observe the midpoint", "steps": ["Pair each vector with its opposite."], "result": "E=0 by symmetry despite a nonzero potential.", "units": "V/m"}, "limitingCases": ["Far from a localized distribution, its net charge gives the leading field."], "pitfalls": ["Zero field at one point does not imply no charge or zero field energy."], "sourceIds": ["es-mit-gauss"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f03"><data key="title">Gauss law and what flux measures</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f03", "topicId": "es-spec-coulomb", "title": "Gauss law and what flux measures", "latex": "\\oint_{\\partial V}\\mathbf E\\cdot\\mathbf n\\,dA=Q_{\\rm enc}/\\epsilon_0", "plain": "Flux depends on enclosed total charge; solving for local field additionally needs symmetry.", "variables": [{"symbol": "E", "meaning": "electric field", "unit": "V/m", "kind": "vector"}, {"symbol": "n", "meaning": "outward unit normal", "unit": "dimensionless", "kind": "vector"}, {"symbol": "dA", "meaning": "surface area element", "unit": "m^2", "kind": "scalar"}, {"symbol": "Q_enc", "meaning": "enclosed total charge", "unit": "C", "kind": "scalar"}, {"symbol": "epsilon_0", "meaning": "vacuum permittivity", "unit": "F/m", "kind": "constant"}], "conditions": ["Closed oriented surface; microscopic vacuum form includes bound as well as free charge."], "derivation": ["Integrate the inverse-square field over solid angle.", "Use superposition or the divergence theorem to obtain divE=rho/epsilon0."], "workedExample": {"inputs": "1nC at centre of sphere radius0.2m", "steps": ["Use E constant and radial.", "Set E*4πr²=Q/epsilon0."], "result": "E≈224.7", "units": "V/m"}, "limitingCases": ["A charge outside contributes zero net flux, but generally nonzero local field."], "pitfalls": ["Replacing E by a uniform magnitude on an arbitrary Gaussian surface is unjustified."], "sourceIds": ["es-mit-gauss"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f04"><data key="title">Potential, gauge and path independence</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f04", "topicId": "es-spec-green", "title": "Potential, gauge and path independence", "latex": "\\mathbf E=-\\nabla\\phi,\\qquad \\phi(B)-\\phi(A)=-\\int_A^B\\mathbf E\\cdot d\\mathbf l", "plain": "A potential difference is work per unit positive test charge with the stated minus sign.", "variables": [{"symbol": "E", "meaning": "electric field", "unit": "V/m", "kind": "vector"}, {"symbol": "phi", "meaning": "electric potential", "unit": "V", "kind": "scalar"}, {"symbol": "A,B", "meaning": "path endpoints", "unit": "m", "kind": "coordinate"}, {"symbol": "dl", "meaning": "oriented displacement", "unit": "m", "kind": "vector"}], "conditions": ["Electrostatic curlE=0 on a simply connected domain, or a globally defined conservative field."], "derivation": ["Apply Stokes theorem to zero curl.", "Define phi relative to one reference; adding a constant leaves E unchanged."], "workedExample": {"inputs": "Uniform E=100V/m along+x; B lies0.02m aboveA in x", "steps": ["Integrate E*dx."], "result": "phiB−phiA=−2", "units": "V"}, "limitingCases": ["A closed-loop integral is zero in electrostatics."], "pitfalls": ["Time-varying magnetic flux can make the electric field nonconservative; a scalar potential alone then fails."], "sourceIds": ["es-mit-gauss"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f05"><data key="title">Heterogeneous-permittivity Poisson equation</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f05", "topicId": "es-spec-green", "title": "Heterogeneous-permittivity Poisson equation", "latex": "-\\nabla\\cdot[\\boldsymbol\\epsilon(\\mathbf r)\\nabla\\phi]=\\rho_f", "plain": "Free charge, constitutive response and boundary data determine the potential together.", "variables": [{"symbol": "epsilon", "meaning": "symmetric positive permittivity tensor", "unit": "F/m", "kind": "tensor"}, {"symbol": "phi", "meaning": "potential", "unit": "V", "kind": "scalar"}, {"symbol": "rho_f", "meaning": "free volume charge density", "unit": "C/m^3", "kind": "scalar"}, {"symbol": "r", "meaning": "position", "unit": "m", "kind": "coordinate"}], "conditions": ["Local linear dielectric; tensor bounded and coercive; suitable Dirichlet/Neumann data."], "derivation": ["Combine D=epsilonE, E=−gradphi and divD=rho_f.", "Do not move spatially varying epsilon outside the divergence."], "workedExample": {"inputs": "1D slab with constant epsilon and uniform rho; phi(0)=phi(L)=0", "steps": ["Integrate phi double derivative=−rho/epsilon."], "result": "phi(x)=rho*x*(L−x)/(2epsilon).", "units": "V"}, "limitingCases": ["For constant scalar epsilon this becomes −epsilon*Laplacian(phi)=rho_f."], "pitfalls": ["Using epsilon*Laplacian(phi) across a jump erases the interface condition."], "sourceIds": ["es-tong-matter", "es-fenics"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f06"><data key="title">Laplace uniqueness and the missing constant</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">theorem</data><data key="metadata">{"id": "es-f06", "topicId": "es-spec-green", "title": "Laplace uniqueness and the missing constant", "latex": "\\nabla^2\\phi=0,\\qquad \\int_\\Omega\\epsilon|\\nabla(\\phi_1-\\phi_2)|^2dV=0", "plain": "Two solutions with identical admissible data differ only by a gauge constant; Dirichlet data fixes it.", "variables": [{"symbol": "phi_1,phi_2", "meaning": "candidate potentials", "unit": "V", "kind": "scalar"}, {"symbol": "epsilon", "meaning": "positive scalar permittivity", "unit": "F/m", "kind": "coupling"}, {"symbol": "Omega", "meaning": "solution domain", "unit": "m^3", "kind": "coordinate"}, {"symbol": "dV", "meaning": "volume element", "unit": "m^3", "kind": "scalar"}, {"symbol": "phi", "meaning": "electrostatic potential in displayed Laplace equation", "unit": "V", "kind": "scalar"}], "conditions": ["Connected bounded Lipschitz domain; real scalar epsilon uniformly positive. The displayed Laplace equation assumes spatially constant epsilon; heterogeneous epsilon uses the divergence-form operator of es-f05.", "Compare potentials with the same sources and admissible boundary traces. A Dirichlet set of positive measure fixes the gauge; all-Neumann data require compatibility and a specified additive constant/mean. Disconnected regions need these conditions componentwise."], "derivation": ["Subtract the PDEs.", "Multiply by the difference and integrate by parts; boundary terms vanish.", "Positive epsilon forces equal gradients."], "workedExample": {"inputs": "All-Neumann zero-flux interval", "steps": ["Both phi=0 and phi=7V solve the same gradient problem."], "result": "Only the additive constant is undetermined.", "units": "V"}, "limitingCases": ["With two fixed endpoint voltages in1D, phi is their linear interpolation."], "pitfalls": ["All-Neumann solvability also needs total-charge/flux compatibility, not just a numerical gauge."], "sourceIds": ["es-fenics"], "status": "theorem", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f07"><data key="title">Electrostatic interface conditions</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f07", "topicId": "es-spec-images", "title": "Electrostatic interface conditions", "latex": "\\mathbf n\\cdot(\\mathbf D_2-\\mathbf D_1)=\\sigma_f,\\qquad\\mathbf n\\times(\\mathbf E_2-\\mathbf E_1)=0", "plain": "The normal points from medium1 to2; a free surface sheet jumps normal D, not generically normal E.", "variables": [{"symbol": "n", "meaning": "normal from medium1 to2", "unit": "dimensionless", "kind": "vector"}, {"symbol": "D_1,D_2", "meaning": "electric displacement", "unit": "C/m^2", "kind": "vector"}, {"symbol": "E_1,E_2", "meaning": "electric fields", "unit": "V/m", "kind": "vector"}, {"symbol": "sigma_f", "meaning": "free interfacial charge", "unit": "C/m^2", "kind": "scalar"}], "conditions": ["Ideal zero-thickness interface without a prescribed dipole-sheet potential jump; static fields."], "derivation": ["Shrink a Gaussian pillbox to the interface.", "Shrink a rectangular Faraday loop to obtain tangential continuity."], "workedExample": {"inputs": "No free sheet; epsilon2=2epsilon1; field normal", "steps": ["Set epsilon1*E1n=epsilon2*E2n."], "result": "E2n=E1n/2.", "units": "V/m"}, "limitingCases": ["Equal permittivities and zero sheet give continuous E."], "pitfalls": ["A conducting surface may carry induced free charge; setting sigma_f=0 there is usually wrong."], "sourceIds": ["es-tong-matter"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f08"><data key="title">Localized-source far-field expansion</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">approximation</data><data key="metadata">{"id": "es-f08", "topicId": "es-spec-multipoles", "title": "Localized-source far-field expansion", "latex": "\\phi(\\mathbf r)=\\frac1{4\\pi\\epsilon_0}\\left(\\frac Qr+\\frac{\\mathbf p\\cdot\\widehat{\\mathbf r}}{r^2}+O(r^{-3})\\right),\\quad\\mathbf p=\\int\\mathbf r\\prime\\rho\\,dV\\prime", "plain": "Net charge and dipole moment organize the leading spatial decay.", "variables": [{"symbol": "phi", "meaning": "potential", "unit": "V", "kind": "scalar"}, {"symbol": "Q", "meaning": "net charge", "unit": "C", "kind": "scalar"}, {"symbol": "r", "meaning": "distance from expansion origin", "unit": "m", "kind": "coordinate"}, {"symbol": "p", "meaning": "dipole moment", "unit": "C*m", "kind": "vector"}, {"symbol": "r_hat", "meaning": "radial unit vector", "unit": "dimensionless", "kind": "vector"}, {"symbol": "epsilon_0", "meaning": "vacuum permittivity", "unit": "F/m", "kind": "constant"}, {"symbol": "rho", "meaning": "source density", "unit": "C/m^3", "kind": "scalar"}], "conditions": ["Source support lies within radius a and r&gt;a; origin matters when Q is nonzero."], "derivation": ["Expand1/|r−rprime| in rprime/r.", "Integrate successive angular moments."], "workedExample": {"inputs": "Charges±q separated by d; r≫d on the axis", "steps": ["Q cancels and p=q*d."], "result": "phi≈q*d/(4πepsilon0*r²).", "units": "V"}, "limitingCases": ["For Q=0 the dipole may lead; if p also vanishes, higher moments control."], "pitfalls": ["A visually symmetric image is not a measured charge distribution or a justified multipole truncation."], "sourceIds": ["es-tong-electrostatics"], "status": "approximation", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f09"><data key="title">Dipole energy and a nonuniform field force</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f09", "topicId": "es-spec-multipoles", "title": "Dipole energy and a nonuniform field force", "latex": "U=-\\mathbf p\\cdot\\mathbf E,\\quad\\boldsymbol\\tau=\\mathbf p\\times\\mathbf E,\\quad\\mathbf F=\\nabla(\\mathbf p\\cdot\\mathbf E)", "plain": "Orientation energy and translation force are different consequences of an imposed field.", "variables": [{"symbol": "U", "meaning": "interaction energy", "unit": "J", "kind": "scalar"}, {"symbol": "p", "meaning": "fixed permanent dipole", "unit": "C*m", "kind": "vector"}, {"symbol": "E", "meaning": "external field", "unit": "V/m", "kind": "vector"}, {"symbol": "tau", "meaning": "torque", "unit": "N*m", "kind": "vector"}, {"symbol": "F", "meaning": "force", "unit": "N", "kind": "vector"}], "conditions": ["Small fixed dipole, field varies slowly across it; no induced-dipole factor or self-field included."], "derivation": ["Sum forces and work on the two opposite charges.", "Retain the first order in separation."], "workedExample": {"inputs": "p parallel a uniform E", "steps": ["The cross product vanishes and the gradient is zero."], "result": "U=−pE but F=0 and torque=0.", "units": "J,N,N*m"}, "limitingCases": ["A uniform field can rotate a misaligned dipole without translating it."], "pitfalls": ["For a linearly induced dipole p=alphaE, its charging energy has a factor1/2."], "sourceIds": ["es-tong-electrostatics"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f10"><data key="title">Capacitance and the parallel-plate approximation</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f10", "topicId": "es-spec-bridge", "title": "Capacitance and the parallel-plate approximation", "latex": "C=Q/\\Delta V\\simeq\\epsilon A/d", "plain": "Capacitance is a geometry/material/boundary response, not charge stored without a voltage reference.", "variables": [{"symbol": "C", "meaning": "capacitance", "unit": "F", "kind": "scalar"}, {"symbol": "Q", "meaning": "electrode charge", "unit": "C", "kind": "scalar"}, {"symbol": "DeltaV", "meaning": "electrode potential difference", "unit": "V", "kind": "scalar"}, {"symbol": "epsilon", "meaning": "uniform permittivity", "unit": "F/m", "kind": "coupling"}, {"symbol": "A", "meaning": "overlap area", "unit": "m^2", "kind": "scalar"}, {"symbol": "d", "meaning": "plate gap", "unit": "m", "kind": "coordinate"}], "conditions": ["Linear dielectric; d much smaller than lateral electrode size; opposing charges and negligible fringing."], "derivation": ["Gauss law gives E≈Q/(epsilonA).", "Integrate DeltaV≈Ed and divide Q by voltage."], "workedExample": {"inputs": "Air plates area0.01m², gap1mm", "steps": ["Use epsilon≈epsilon0."], "result": "C≈88.54", "units": "pF"}, "limitingCases": ["C doubles with area and halves with gap in this limit."], "pitfalls": ["Small or edge-dominated electrodes require a field solution; measured parasitics add capacitance."], "sourceIds": ["es-mit-capacitance"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f11"><data key="title">Maxwell capacitance matrix</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f11", "topicId": "es-spec-bridge", "title": "Maxwell capacitance matrix", "latex": "Q_i=\\sum_j C_{ij}V_j,\\qquad U=\\tfrac12\\mathbf V^T\\mathbf C\\mathbf V", "plain": "A multi-electrode system needs an explicitly grounded reference or a retained gauge mode.", "variables": [{"symbol": "Q_i", "meaning": "charge on conductor i", "unit": "C", "kind": "scalar"}, {"symbol": "V_j", "meaning": "potential relative to reference", "unit": "V", "kind": "scalar"}, {"symbol": "C_ij", "meaning": "Maxwell capacitance coefficients", "unit": "F", "kind": "tensor"}, {"symbol": "U", "meaning": "field energy", "unit": "J", "kind": "scalar"}, {"symbol": "V", "meaning": "electrode voltage vector", "unit": "V", "kind": "vector"}], "conditions": ["Linear reciprocal electrostatics with fixed conductor geometry; the full isolated matrix is gauge singular."], "derivation": ["Linearity lets each electrode basis voltage define a response column.", "Reciprocity gives symmetry; integrate charging work."], "workedExample": {"inputs": "Two isolated conductors with mutual capacitance C", "steps": ["Use matrix C*[[1,−1],[−1,1]]."], "result": "Adding the same voltage to both leaves charges unchanged.", "units": "C,J"}, "limitingCases": ["After grounding one electrode the remaining matrix is positive on allowed voltages."], "pitfalls": ["Circuit mutual capacitances and off-diagonal Maxwell coefficients differ in sign convention."], "sourceIds": ["es-mit-capacitance"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f12"><data key="title">Stored field energy and nonlinear qualification</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f12", "topicId": "es-spec-linear", "title": "Stored field energy and nonlinear qualification", "latex": "U=\\tfrac12\\int\\mathbf E\\cdot\\mathbf D\\,dV;\\qquad w(\\mathbf D)=\\int_0^{\\mathbf D}\\mathbf E(\\mathbf D\\prime)\\cdot d\\mathbf D\\prime", "plain": "The one-half expression requires a linear reversible constitutive relation; nonlinear work needs the constitutive path.", "variables": [{"symbol": "U", "meaning": "stored energy", "unit": "J", "kind": "scalar"}, {"symbol": "E", "meaning": "electric field", "unit": "V/m", "kind": "vector"}, {"symbol": "D", "meaning": "displacement", "unit": "C/m^2", "kind": "vector"}, {"symbol": "w", "meaning": "energy density", "unit": "J/m^3", "kind": "scalar"}, {"symbol": "dV", "meaning": "volume element", "unit": "m^3", "kind": "scalar"}], "conditions": ["Lossless reversible local medium; fixed mechanical state. First equality applies only to linear D(E)."], "derivation": ["Charge the system quasistatically: incremental work is E·dD.", "Integrate along the reversible constitutive curve."], "workedExample": {"inputs": "1nF capacitor at3V", "steps": ["Use U=C*V²/2."], "result": "Stored energy4.5", "units": "nJ"}, "limitingCases": ["At zero field a reference with zero remanent energy can be assigned U=0."], "pitfalls": ["Ferroelectric hysteresis, losses and electrostriction cannot be hidden inside a constant epsilon."], "sourceIds": ["es-mit-capacitance", "es-tong-matter"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f13"><data key="title">Force at fixed voltage versus fixed charge</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f13", "topicId": "es-spec-bridge", "title": "Force at fixed voltage versus fixed charge", "latex": "F_x|_V=\\tfrac12V^2\\partial_xC,\\qquad F_x|_Q=-\\partial_x[Q^2/(2C)],\\qquad\\mathcal G=U-VQ=-\\tfrac12CV^2", "plain": "The voltage source changes the appropriate thermodynamic potential; differentiating field energy at fixed V alone gives the wrong sign.", "variables": [{"symbol": "F_x", "meaning": "force along chosen x", "unit": "N", "kind": "scalar"}, {"symbol": "V", "meaning": "fixed voltage", "unit": "V", "kind": "state"}, {"symbol": "Q", "meaning": "fixed charge", "unit": "C", "kind": "state"}, {"symbol": "C", "meaning": "position-dependent capacitance", "unit": "F", "kind": "scalar"}, {"symbol": "x", "meaning": "mechanical coordinate", "unit": "m", "kind": "coordinate"}, {"symbol": "G", "meaning": "voltage-controlled electric thermodynamic potential including source work", "unit": "J", "kind": "scalar"}, {"symbol": "U", "meaning": "stored field energy Q²/(2C)=CV²/2 at the specified state", "unit": "J", "kind": "scalar"}, {"symbol": "epsilon", "meaning": "constant dielectric permittivity in the plate example", "unit": "F/m", "kind": "coupling"}, {"symbol": "A", "meaning": "overlap area in the plate example", "unit": "m^2", "kind": "scalar"}], "conditions": ["Quasistatic linear capacitor; mechanical coordinate and controlled electrical ensemble explicitly fixed."], "derivation": ["At fixed Q, force is minus the x derivative of U=Q²/(2C).", "At fixed V, source work is deltaW_source=V*deltaQ. Legendre transform G=U−VQ=−CV²/2; F=−partialG/partialx at fixed V.", "Differentiate the controlled potential, not field energy with the source omitted."], "workedExample": {"inputs": "x is plate separation and C=epsilonA/x", "steps": ["Cprime=−epsilonA/x²."], "result": "Fixed-V force=−epsilonA*V²/(2x²), attractive.", "units": "N"}, "limitingCases": ["At V=0 with no trapped charge, this ideal force vanishes."], "pitfalls": ["A power supply is an energy port; electrostatic attraction does not create energy.", "Changing the plate gap at fixed V returns or draws charge through the supply; electrical source work and external mechanical work must both appear in the energy balance."], "sourceIds": ["es-mit-capacitance"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f14"><data key="title">Maxwell stress in a simple dielectric</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f14", "topicId": "es-spec-linear", "title": "Maxwell stress in a simple dielectric", "latex": "T_{ij}=\\epsilon(E_iE_j-\\tfrac12E^2\\delta_{ij}),\\qquad\\mathbf F=\\oint\\mathbf T\\cdot\\mathbf n\\,dA", "plain": "Stress converts a solved field to a force under a declared material-mechanics model.", "variables": [{"symbol": "T_ij", "meaning": "electromagnetic stress components", "unit": "Pa", "kind": "tensor"}, {"symbol": "epsilon", "meaning": "scalar permittivity", "unit": "F/m", "kind": "coupling"}, {"symbol": "E_i", "meaning": "field components", "unit": "V/m", "kind": "vector"}, {"symbol": "delta_ij", "meaning": "Kronecker tensor", "unit": "dimensionless", "kind": "tensor"}, {"symbol": "F", "meaning": "enclosed force", "unit": "N", "kind": "vector"}, {"symbol": "n", "meaning": "outward normal", "unit": "dimensionless", "kind": "vector"}, {"symbol": "dA", "meaning": "surface element", "unit": "m^2", "kind": "scalar"}], "conditions": ["Static, homogeneous isotropic medium or vacuum integration surface; mechanical/electrostrictive terms must be handled consistently in matter."], "derivation": ["Balance momentum across a surface.", "The normal field produces pressure epsilonE²/2 on an ideal conductor."], "workedExample": {"inputs": "Vacuum E=1e5V/m normal to a conductor", "steps": ["Evaluate epsilon0*E²/2."], "result": "Pressure≈0.04427", "units": "Pa"}, "limitingCases": ["For zero field this field-only stress vanishes."], "pitfalls": ["Applying the vacuum expression inside a deformable nonlinear dielectric can omit material stresses."], "sourceIds": ["es-tong-matter"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f15"><data key="title">Polarization and electric displacement</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f15", "topicId": "es-spec-linear", "title": "Polarization and electric displacement", "latex": "\\mathbf D=\\epsilon_0\\mathbf E+\\mathbf P,\\quad\\mathbf P=\\epsilon_0\\chi_e\\mathbf E", "plain": "D packages free-charge bookkeeping; P records dipole moment per volume.", "variables": [{"symbol": "D", "meaning": "electric displacement", "unit": "C/m^2", "kind": "vector"}, {"symbol": "P", "meaning": "polarization", "unit": "C/m^2", "kind": "vector"}, {"symbol": "E", "meaning": "electric field", "unit": "V/m", "kind": "vector"}, {"symbol": "epsilon_0", "meaning": "vacuum permittivity", "unit": "F/m", "kind": "constant"}, {"symbol": "chi_e", "meaning": "electric susceptibility", "unit": "dimensionless", "kind": "coupling"}], "conditions": ["Second relation assumes local linear isotropic response without remanence; first is the standard macroscopic definition."], "derivation": ["Coarse-grain microscopic dipoles.", "Separate imposed/free charge from bound polarization charge."], "workedExample": {"inputs": "chi_e=3 under E=100V/m", "steps": ["P=3epsilon0E; D=4epsilon0E."], "result": "Relative permittivity4 in this model.", "units": "dimensionless"}, "limitingCases": ["Vacuum has P=0 and D=epsilon0E."], "pitfalls": ["D is not universally the physical microscopic field and need not be continuous normally."], "sourceIds": ["es-tong-matter"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f16"><data key="title">Bound volume and surface charge</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f16", "topicId": "es-spec-linear", "title": "Bound volume and surface charge", "latex": "\\rho_b=-\\nabla\\cdot\\mathbf P,\\qquad\\sigma_b=\\mathbf P\\cdot\\mathbf n", "plain": "A polarized body may have no volume charge and still carry opposite bound surface sheets.", "variables": [{"symbol": "rho_b", "meaning": "bound volume charge density", "unit": "C/m^3", "kind": "scalar"}, {"symbol": "P", "meaning": "polarization", "unit": "C/m^2", "kind": "vector"}, {"symbol": "sigma_b", "meaning": "bound surface charge density", "unit": "C/m^2", "kind": "scalar"}, {"symbol": "n", "meaning": "outward normal from polarized body", "unit": "dimensionless", "kind": "vector"}], "conditions": ["Macroscopic polarization with resolved boundary; discontinuities can be represented distributionally."], "derivation": ["Integrate dipole charge over a small volume.", "Apply the divergence theorem to transfer termination of P to the surface."], "workedExample": {"inputs": "Uniform P=P0*z-hat in a slab", "steps": ["divP=0 in the interior; top/bottom normals reverse."], "result": "Surface sheets+P0 and−P0; no bulk rho_b.", "units": "C/m^2"}, "limitingCases": ["A uniform polarization in an infinite periodic model has no physical outer surface."], "pitfalls": ["Do not add sigma_b twice when using an epsilon-based interface formulation."], "sourceIds": ["es-tong-matter"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f17"><data key="title">Anisotropic electrostatic energy</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f17", "topicId": "es-spec-linear", "title": "Anisotropic electrostatic energy", "latex": "D_i=\\epsilon_{ij}E_j,\\qquad w=\\tfrac12\\mathbf E^T\\boldsymbol\\epsilon\\mathbf E", "plain": "Anisotropy changes direction as well as magnitude; a stable reciprocal dielectric has positive quadratic energy.", "variables": [{"symbol": "D_i", "meaning": "displacement component", "unit": "C/m^2", "kind": "vector"}, {"symbol": "epsilon_ij", "meaning": "permittivity tensor", "unit": "F/m", "kind": "tensor"}, {"symbol": "E_j", "meaning": "electric-field component", "unit": "V/m", "kind": "vector"}, {"symbol": "w", "meaning": "energy density", "unit": "J/m^3", "kind": "scalar"}], "conditions": ["Real symmetric positive-definite tensor in a local quasistatic reciprocal model."], "derivation": ["Differentiate the quadratic energy with respect to E.", "Diagonalize the tensor along principal axes."], "workedExample": {"inputs": "epsilon=epsilon0*diag(2,4,6), E=(E0,E0,0)", "steps": ["Multiply the tensor by E."], "result": "D is not parallel to E; w=3epsilon0E0².", "units": "J/m^3"}, "limitingCases": ["Scalar epsilon is the isotropic special case."], "pitfalls": ["A frequency-dependent negative real permittivity requires dispersive energy; this static positive-energy model is not applicable."], "sourceIds": ["es-tong-matter"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f18"><data key="title">Clausius–Mossotti local-field model</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">approximation</data><data key="metadata">{"id": "es-f18", "topicId": "es-spec-localfield", "title": "Clausius–Mossotti local-field model", "latex": "\\frac{\\epsilon_r-1}{\\epsilon_r+2}=\\frac{n\\alpha_m}{3\\epsilon_0}", "plain": "A molecular polarizability becomes a bulk response only after a local-field hypothesis.", "variables": [{"symbol": "epsilon_r", "meaning": "relative permittivity", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "n", "meaning": "number density", "unit": "1/m^3", "kind": "scalar"}, {"symbol": "alpha_m", "meaning": "molecular polarizability p/E", "unit": "C*m^2/V", "kind": "coupling"}, {"symbol": "epsilon_0", "meaning": "vacuum permittivity", "unit": "F/m", "kind": "constant"}], "conditions": ["Isotropic weakly interacting polarizable units with Lorentz spherical-cavity local field; no strong correlations or permanent-dipole complications."], "derivation": ["Use E_local=E+P/(3epsilon0).", "Substitute P=n*alpha_m*E_local and solve for susceptibility."], "workedExample": {"inputs": "n*alpha_m/(3epsilon0)=0.1", "steps": ["Solve epsilon_r−1=.1(epsilon_r+2)."], "result": "epsilon_r=4/3.", "units": "dimensionless"}, "limitingCases": ["At dilute n, chi_e≈nalpha_m/epsilon0."], "pitfalls": ["The apparent denominator singularity signals model breakdown, not a universal ferroelectric transition prediction."], "sourceIds": ["es-tong-matter"], "status": "approximation", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f19"><data key="title">Planar dielectric image charge</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f19", "topicId": "es-spec-images", "title": "Planar dielectric image charge", "latex": "q\\prime=q\\frac{\\epsilon_1-\\epsilon_2}{\\epsilon_1+\\epsilon_2}", "plain": "An image is an auxiliary mathematical charge reproducing boundary data on one side.", "variables": [{"symbol": "q", "meaning": "real charge in medium1", "unit": "C", "kind": "scalar"}, {"symbol": "q_prime", "meaning": "auxiliary mirror charge", "unit": "C", "kind": "scalar"}, {"symbol": "epsilon_1,epsilon_2", "meaning": "positive scalar permittivities", "unit": "F/m", "kind": "coupling"}], "conditions": ["Infinite planar interface, linear isotropic homogeneous half-spaces, no prescribed free sheet; qprime is used for the medium1 potential."], "derivation": ["Write real+image Green functions.", "Match tangential E and normal D at the plane."], "workedExample": {"inputs": "epsilon2=3epsilon1", "steps": ["Substitute in the reflection coefficient."], "result": "qprime=−q/2.", "units": "C"}, "limitingCases": ["Equal media give no image; conductor limit epsilon2→infinity gives−q."], "pitfalls": ["The image is not a second physical source; evaluating self-force must exclude the real charge singularity."], "sourceIds": ["es-tong-matter"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f20"><data key="title">Landau differential stability</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">conditional-result</data><data key="metadata">{"id": "es-f20", "topicId": "es-spec-landau", "title": "Landau differential stability", "latex": "f(P)=aP^2/2+bP^4/4+cP^6/6-EP,\\quad E=aP+bP^3+cP^5", "plain": "A homogeneous stationary branch is not necessarily a stable state.", "variables": [{"symbol": "f", "meaning": "electric free-energy density", "unit": "J/m^3", "kind": "scalar"}, {"symbol": "P", "meaning": "scalar polarization along chosen axis", "unit": "C/m^2", "kind": "state"}, {"symbol": "a", "meaning": "quadratic coefficient", "unit": "m/F", "kind": "coupling"}, {"symbol": "b", "meaning": "quartic coefficient", "unit": "V*m^5/C^3", "kind": "coupling"}, {"symbol": "c", "meaning": "sixth-order coefficient", "unit": "V*m^9/C^5", "kind": "coupling"}, {"symbol": "E", "meaning": "applied field conjugate to P", "unit": "V/m", "kind": "scalar"}], "conditions": ["Phenomenological homogeneous mean-field expansion; stability requires second derivative positive with the controlled ensemble and any circuit/domain terms included.", "The stationary/curvature conditions are local. Global equilibrium requires comparing admissible minima and nonuniform/domain states; if treating the polynomial globally, its highest retained even-power coefficient must make it bounded below."], "derivation": ["Set derivative of f with respect to P to zero.", "Differentiate E(P): slope=a+3bP²+5cP⁴."], "workedExample": {"inputs": "a&gt;0,b=c=0", "steps": ["Solve E=aP and inspect curvature."], "result": "P=E/a is a stable linear branch.", "units": "C/m^2"}, "limitingCases": ["If a&lt;0,b&gt;0 at E=0, P=0 is unstable and nonzero minima appear."], "pitfalls": ["Domain walls, gradients, strain and switching kinetics are omitted; fitted coefficients are not universal constants."], "sourceIds": ["es-frontier-ferro"], "status": "conditional-result", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f21"><data key="title">Series stabilization and negative differential capacitance</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">conditional-result</data><data key="metadata">{"id": "es-f21", "topicId": "es-spec-negative", "title": "Series stabilization and negative differential capacitance", "latex": "C_{\\rm tot}^{-1}=C_s^{-1}+C_f^{-1}&gt;0", "plain": "A negative subsystem slope can coexist with a positive total curvature under constrained coupling.", "variables": [{"symbol": "C_tot", "meaning": "total differential capacitance", "unit": "F", "kind": "scalar"}, {"symbol": "C_s", "meaning": "positive series capacitance", "unit": "F", "kind": "coupling"}, {"symbol": "C_f", "meaning": "ferroelectric branch differential capacitance", "unit": "F", "kind": "coupling"}], "conditions": ["Same incremental charge in a series quasistatic model; total free-energy curvature positive; leakage and domain alternatives must be checked."], "derivation": ["Sum incremental voltages dV=dQ/Cs+dQ/Cf.", "Positive dV/dQ is the local total-system stability requirement."], "workedExample": {"inputs": "Cs=1nF,Cf=−2nF", "steps": ["Add inverse capacitances:1−.5 in1/nF."], "result": "Ctot=2nF; if Cf=−.5nF the total curvature is negative.", "units": "nF"}, "limitingCases": ["Cf→infinity leaves Ctot=Cs."], "pitfalls": ["A transient negative dQ/dV trace alone does not demonstrate stable equilibrium negative capacitance or energy creation."], "sourceIds": ["es-frontier-ferro"], "status": "conditional-result", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f22"><data key="title">Boltzmann ion distribution</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f22", "topicId": "es-spec-debye", "title": "Boltzmann ion distribution", "latex": "n_i(\\psi)=n_{i,b}\\exp[-z_ie\\psi/(k_BT)]", "plain": "Equilibrium ion density follows a balance of ideal mixing entropy and electrostatic energy.", "variables": [{"symbol": "n_i", "meaning": "local ion number density", "unit": "1/m^3", "kind": "scalar"}, {"symbol": "n_ib", "meaning": "reservoir number density", "unit": "1/m^3", "kind": "state"}, {"symbol": "z_i", "meaning": "signed ionic valence", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "e", "meaning": "positive elementary charge", "unit": "C", "kind": "constant"}, {"symbol": "psi", "meaning": "potential relative to reservoir", "unit": "V", "kind": "scalar"}, {"symbol": "k_B", "meaning": "Boltzmann constant", "unit": "J/K", "kind": "constant"}, {"symbol": "T", "meaning": "absolute temperature", "unit": "K", "kind": "state"}], "conditions": ["Dilute ideal ions at thermal equilibrium, uniform temperature, reservoir chemical potentials and point-ion mean field."], "derivation": ["Set mu_i=kBT*ln(n_i)+z_i*e*psi+constant equal to its reservoir value.", "Exponentiate."], "workedExample": {"inputs": "Monovalent cation, psi=kBT/e", "steps": ["Exponent is−1."], "result": "n_plus=n_b/e≈0.368n_b.", "units": "1/m^3"}, "limitingCases": ["At psi=0 the reservoir concentration is recovered."], "pitfalls": ["Divergent accumulation at a highly charged wall is a point-ion model failure."], "sourceIds": ["es-frontier-pb"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f23"><data key="title">Nonlinear Poisson–Boltzmann equation</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f23", "topicId": "es-spec-pb", "title": "Nonlinear Poisson–Boltzmann equation", "latex": "-\\epsilon\\nabla^2\\psi=\\rho_{\\rm fixed}+\\sum_i z_ie n_{i,b}e^{-z_ie\\psi/(k_BT)}", "plain": "The electrostatic field and ion distribution must be solved self-consistently.", "variables": [{"symbol": "epsilon", "meaning": "uniform solvent permittivity", "unit": "F/m", "kind": "coupling"}, {"symbol": "psi", "meaning": "reservoir-referenced potential", "unit": "V", "kind": "scalar"}, {"symbol": "rho_fixed", "meaning": "fixed charge density", "unit": "C/m^3", "kind": "scalar"}, {"symbol": "z_i", "meaning": "signed ion valence", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "e", "meaning": "elementary charge", "unit": "C", "kind": "constant"}, {"symbol": "n_ib", "meaning": "reservoir number density", "unit": "1/m^3", "kind": "state"}, {"symbol": "k_B", "meaning": "Boltzmann constant", "unit": "J/K", "kind": "constant"}, {"symbol": "T", "meaning": "temperature", "unit": "K", "kind": "state"}], "conditions": ["Mean-field point ions, local continuum dielectric, equilibrium reservoir and specified wall conditions; reservoir electroneutrality is required."], "derivation": ["Insert ideal Boltzmann densities into Poisson.", "For symmetric1:1 salt the mobile charge is−2en_b*sinh(epsi/kBT)."], "workedExample": {"inputs": "Neutral homogeneous reservoir with no fixed charge", "steps": ["Choose psi=0 and equal cation/anion densities."], "result": "Both sides vanish; psi=0 is a solution.", "units": "V"}, "limitingCases": ["Linearization gives Debye–Hückel only for small dimensionless potential."], "pitfalls": ["Mean-field PB neglects ion correlations, finite size, hydration and image self-energy unless extended."], "sourceIds": ["es-frontier-pb"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f24"><data key="title">Debye screening length</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f24", "topicId": "es-spec-debye", "title": "Debye screening length", "latex": "\\kappa^2=\\frac{e^2\\sum_i z_i^2 n_{i,b}}{\\epsilon k_BT},\\qquad\\lambda_D=\\kappa^{-1}", "plain": "Screening length depends on ionic strength, dielectric response and temperature, not charge signs alone.", "variables": [{"symbol": "kappa", "meaning": "inverse screening length", "unit": "1/m", "kind": "scalar"}, {"symbol": "lambda_D", "meaning": "Debye length", "unit": "m", "kind": "scalar"}, {"symbol": "e", "meaning": "elementary charge", "unit": "C", "kind": "constant"}, {"symbol": "z_i", "meaning": "ion valence", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "n_ib", "meaning": "number density per species", "unit": "1/m^3", "kind": "state"}, {"symbol": "epsilon", "meaning": "solvent permittivity", "unit": "F/m", "kind": "coupling"}, {"symbol": "k_B", "meaning": "Boltzmann constant", "unit": "J/K", "kind": "constant"}, {"symbol": "T", "meaning": "temperature", "unit": "K", "kind": "state"}], "conditions": ["Linearized dilute PB in a uniform bulk electrolyte; concentrations converted to number density."], "derivation": ["Expand exp(−zi*u) to first order.", "The zeroth-order charge cancels by electroneutrality; remaining coefficient is kappa²."], "workedExample": {"inputs": "Water298K,epsilon_r≈78.4,1mM1:1 salt", "steps": ["Each species density=1mol/m³*NA.", "Substitute both species."], "result": "lambdaD≈9.6", "units": "nm"}, "limitingCases": ["Increasing concentration100-fold reduces lambdaD tenfold in this model."], "pitfalls": ["Molarity is mol/L; inserting1mM as0.001mol/m³ gives a spurious factor sqrt1000."], "sourceIds": ["es-frontier-pb"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f25"><data key="title">Screened point-charge Green function</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">approximation</data><data key="metadata">{"id": "es-f25", "topicId": "es-spec-debye", "title": "Screened point-charge Green function", "latex": "\\psi(r)=\\frac{q}{4\\pi\\epsilon r}e^{-\\kappa r}", "plain": "A Yukawa form is a linear-response Green function, not the exact nonlinear field near a highly charged ion.", "variables": [{"symbol": "psi", "meaning": "potential", "unit": "V", "kind": "scalar"}, {"symbol": "q", "meaning": "small test charge", "unit": "C", "kind": "scalar"}, {"symbol": "epsilon", "meaning": "solvent permittivity", "unit": "F/m", "kind": "coupling"}, {"symbol": "r", "meaning": "distance from source", "unit": "m", "kind": "coordinate"}, {"symbol": "kappa", "meaning": "inverse Debye length", "unit": "1/m", "kind": "scalar"}], "conditions": ["Unbounded homogeneous linearized electrolyte; small perturbation away from the source core."], "derivation": ["Solve (−Laplacian+kappa²)psi=qdelta/epsilon.", "Spherical decay and the Coulomb singular flux fix the coefficient."], "workedExample": {"inputs": "Observe at r=lambdaD", "steps": ["The screening factor is exp(−1)."], "result": "Potential is0.368 of the corresponding unscreened value.", "units": "V"}, "limitingCases": ["kappa→0 restores the Coulomb potential."], "pitfalls": ["A fitted decay length in concentrated solutions need not equal the dilute Debye length."], "sourceIds": ["es-frontier-pb"], "status": "approximation", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f26"><data key="title">Planar Grahame relation</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f26", "topicId": "es-spec-pb", "title": "Planar Grahame relation", "latex": "\\sigma=\\sqrt{8\\epsilon k_BTn_b}\\sinh\\!\\left(\\frac{e\\psi_0}{2k_BT}\\right)", "plain": "For a planar symmetric monovalent diffuse layer, surface charge and potential are nonlinearly related.", "variables": [{"symbol": "sigma", "meaning": "surface charge density", "unit": "C/m^2", "kind": "scalar"}, {"symbol": "epsilon", "meaning": "uniform solvent permittivity", "unit": "F/m", "kind": "coupling"}, {"symbol": "k_B", "meaning": "Boltzmann constant", "unit": "J/K", "kind": "constant"}, {"symbol": "T", "meaning": "temperature", "unit": "K", "kind": "state"}, {"symbol": "n_b", "meaning": "bulk density of each salt species", "unit": "1/m^3", "kind": "state"}, {"symbol": "e", "meaning": "elementary charge", "unit": "C", "kind": "constant"}, {"symbol": "psi_0", "meaning": "surface potential relative to bulk", "unit": "V", "kind": "scalar"}], "conditions": ["Single infinite planar surface,1:1 PB electrolyte, no Stern layer or correlations, vanishing bulk potential/field. Positive psi0 corresponds to positive sigma."], "derivation": ["Multiply the1D PB equation by psi prime.", "Integrate once using the bulk boundary condition, then use normal Gauss law."], "workedExample": {"inputs": "Small psi0", "steps": ["sinh(epsi0/2kBT)≈epsi0/2kBT."], "result": "sigma≈epsilon*kappa*psi0; diffuse capacitance per area≈epsilon*kappa.", "units": "C/m^2"}, "limitingCases": ["At psi0=0 the charge is zero."], "pitfalls": ["Curvature, finite ion size and compact-layer voltage invalidate direct use as an electrode-total capacitance."], "sourceIds": ["es-frontier-pb"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f27"><data key="title">A lattice-gas crowding correction</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">approximation</data><data key="metadata">{"id": "es-f27", "topicId": "es-spec-steric", "title": "A lattice-gas crowding correction", "latex": "n_\\pm=\\frac{n_be^{\\mp u}}{1+2vn_b(\\cosh u-1)},\\qquad u=e\\psi/(k_BT)", "plain": "A finite site volume prevents point-ion density divergence within one explicit modified mean-field model.", "variables": [{"symbol": "n_plus,n_minus", "meaning": "local number densities", "unit": "1/m^3", "kind": "scalar"}, {"symbol": "n_b", "meaning": "reservoir density per species", "unit": "1/m^3", "kind": "state"}, {"symbol": "v", "meaning": "excluded site volume per ion", "unit": "m^3", "kind": "coupling"}, {"symbol": "u", "meaning": "dimensionless potential", "unit": "dimensionless", "kind": "state"}, {"symbol": "e", "meaning": "elementary charge", "unit": "C", "kind": "constant"}, {"symbol": "psi", "meaning": "potential", "unit": "V", "kind": "scalar"}, {"symbol": "k_B", "meaning": "Boltzmann constant", "unit": "J/K", "kind": "constant"}, {"symbol": "T", "meaning": "temperature", "unit": "K", "kind": "state"}], "conditions": ["Equal-size symmetric ions with lattice-gas entropy, bulk volume fraction2vn_b&lt;1; mean field still neglects electrostatic correlations."], "derivation": ["Include the solvent-vacancy entropy in chemical potentials.", "Solve their equilibrium ratios under site exclusion."], "workedExample": {"inputs": "Large positive u", "steps": ["Counterions dominate numerator and denominator."], "result": "n_minus approaches1/v instead of diverging.", "units": "1/m^3"}, "limitingCases": ["v→0 recovers ideal Boltzmann densities."], "pitfalls": ["A hard density cap is not a quantitative theory of hydration, asymmetric ions or oscillatory packing layers."], "sourceIds": ["es-frontier-pb"], "status": "approximation", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f28"><data key="title">Bjerrum length and planar coupling parameter</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">conditional-result</data><data key="metadata">{"id": "es-f28", "topicId": "es-spec-strong", "title": "Bjerrum length and planar coupling parameter", "latex": "\\ell_B=\\frac{e^2}{4\\pi\\epsilon k_BT},\\qquad\\Xi=2\\pi z^3\\ell_B^2|\\sigma|/e,\\qquad\\mu_{GC}=\\frac{e}{2\\pi z\\ell_B|\\sigma|},\\quad\\Xi=\\frac{z^2\\ell_B}{\\mu_{GC}}", "plain": "Thermal energy versus Coulomb energy and interfacial charge density determine whether independent-ion intuition is credible.", "variables": [{"symbol": "ell_B", "meaning": "Bjerrum length", "unit": "m", "kind": "scalar"}, {"symbol": "e", "meaning": "elementary charge", "unit": "C", "kind": "constant"}, {"symbol": "epsilon", "meaning": "solvent permittivity", "unit": "F/m", "kind": "coupling"}, {"symbol": "k_B", "meaning": "Boltzmann constant", "unit": "J/K", "kind": "constant"}, {"symbol": "T", "meaning": "temperature", "unit": "K", "kind": "state"}, {"symbol": "Xi", "meaning": "planar counterion coupling parameter", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "z", "meaning": "positive counterion valence", "unit": "dimensionless", "kind": "scalar"}, {"symbol": "sigma", "meaning": "surface charge density magnitude", "unit": "C/m^2", "kind": "scalar"}, {"symbol": "mu_GC", "meaning": "Gouy–Chapman wall length under this valence/surface-charge convention", "unit": "m", "kind": "scalar"}], "conditions": ["Xi convention is for a planar counterion-only charged wall; added salt, dielectric images and finite ion sizes require separate parameters."], "derivation": ["Define ellB by setting the unit-charge Coulomb energy at that length equal to kBT.", "For a planar wall define muGC=e/(2πz ellB |sigma|); combining z²ellB/muGC gives the displayed Xi.", "This is a declared standard-model nondimensionalization, independently reconstructed here, not a theorem attributed to the modern interface/slab papers."], "workedExample": {"inputs": "Water298K,ellB≈0.71nm; sigma/e=1nm^-2;z=1", "steps": ["Compute2π*.71²."], "result": "Xi≈3.2; z=3 gives≈86 under the same convention.", "units": "dimensionless"}, "limitingCases": ["Increasing valence changes Xi cubically in this wall model."], "pitfalls": ["A single Xi threshold does not universally certify mean-field validity for every geometry and salt mixture.", "The planar coupling parameter is a declared standard-model definition; the cited current interface/slab papers provide context, not a verified original derivation of this parameter.", "Strong coupling between two mechanical modes in the Casimir paper is a different dimensionless comparison from this counterion Xi; matching terminology is not a shared physical mechanism."], "sourceIds": ["es-frontier-pb", "es-frontier-ewald"], "status": "conditional-result", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f29"><data key="title">Compact and diffuse capacitances in series</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f29", "topicId": "es-spec-stern", "title": "Compact and diffuse capacitances in series", "latex": "c_{\\rm dl}^{-1}=c_S^{-1}+c_D^{-1},\\qquad c_S=\\epsilon_S/d_S", "plain": "Voltage partition between compact and diffuse layers must be separated before interpreting a measured differential capacitance.", "variables": [{"symbol": "c_dl", "meaning": "total differential capacitance per area", "unit": "F/m^2", "kind": "scalar"}, {"symbol": "c_S", "meaning": "compact-layer differential capacitance per area", "unit": "F/m^2", "kind": "coupling"}, {"symbol": "c_D", "meaning": "diffuse-layer differential capacitance per area", "unit": "F/m^2", "kind": "coupling"}, {"symbol": "epsilon_S", "meaning": "compact effective permittivity", "unit": "F/m", "kind": "coupling"}, {"symbol": "d_S", "meaning": "effective compact thickness", "unit": "m", "kind": "coordinate"}], "conditions": ["Uniform planar interface with same incremental charge through both idealized layers; adsorption can introduce additional coupled state variables."], "derivation": ["Write dV=dVS+dVD.", "Divide by dSigma and identify the inverse slopes."], "workedExample": {"inputs": "cS=.20F/m²,cD=.10F/m²", "steps": ["Add inverses5+10."], "result": "cdl=.0667", "units": "F/m^2"}, "limitingCases": ["The smaller positive capacitance dominates."], "pitfalls": ["A fitted Stern thickness is not necessarily a literal ion diameter or a directly measured molecular boundary."], "sourceIds": ["es-frontier-pb"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f30"><data key="title">Acid-site charge regulation</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">conditional-result</data><data key="metadata">{"id": "es-f30", "topicId": "es-spec-regulation", "title": "Acid-site charge regulation", "latex": "\\frac{\\theta}{1-\\theta}=10^{\\mathrm{pH_b}-\\mathrm{p}K_a}e^{e\\psi_0/(k_BT)},\\qquad\\sigma=-eN_s\\theta", "plain": "A surface boundary charge may be an equilibrium unknown rather than a fixed number.", "variables": [{"symbol": "theta", "meaning": "deprotonated site fraction", "unit": "dimensionless", "kind": "state"}, {"symbol": "pH_b", "meaning": "bulk acidity convention", "unit": "dimensionless", "kind": "state"}, {"symbol": "pKa", "meaning": "site equilibrium constant in pH notation", "unit": "dimensionless", "kind": "coupling"}, {"symbol": "e", "meaning": "elementary charge", "unit": "C", "kind": "constant"}, {"symbol": "psi_0", "meaning": "surface potential relative to bulk", "unit": "V", "kind": "scalar"}, {"symbol": "k_B", "meaning": "Boltzmann constant", "unit": "J/K", "kind": "constant"}, {"symbol": "T", "meaning": "temperature", "unit": "K", "kind": "state"}, {"symbol": "sigma", "meaning": "surface charge density", "unit": "C/m^2", "kind": "scalar"}, {"symbol": "N_s", "meaning": "site density", "unit": "1/m^2", "kind": "scalar"}], "conditions": ["Independent identical acid sites AH→A−+H+, ideal local proton activity and electrochemical equilibrium; no lateral cooperativity."], "derivation": ["Mass action gives theta/(1−theta)=Ka/aH(surface).", "Positive surface potential reduces local proton concentration by exp(−eψ/kBT)."], "workedExample": {"inputs": "pH_b=pKa and psi0=0", "steps": ["Site ratio is1."], "result": "theta=1/2 and sigma=−eNs/2.", "units": "C/m^2"}, "limitingCases": ["Very low bulk pH protonates the sites under these assumptions."], "pitfalls": ["pH is an activity convention, not simply number density; a sign error reverses the predicted feedback."], "sourceIds": ["es-frontier-ewald"], "status": "conditional-result", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f31"><data key="title">Quantum capacitance from compressibility</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f31", "topicId": "es-spec-dos", "title": "Quantum capacitance from compressibility", "latex": "c_Q=e^2\\frac{\\partial n}{\\partial\\mu}=e^2\\int g(E)\\left[-\\partial_E f(E-\\mu)\\right]dE", "plain": "Charging a low-density-of-states electron system changes its chemical potential as well as its electrostatic potential.", "variables": [{"symbol": "c_Q", "meaning": "quantum capacitance per area", "unit": "F/m^2", "kind": "scalar"}, {"symbol": "e", "meaning": "elementary charge", "unit": "C", "kind": "constant"}, {"symbol": "n", "meaning": "carrier number per area", "unit": "1/m^2", "kind": "state"}, {"symbol": "mu", "meaning": "chemical potential in joules", "unit": "J", "kind": "state"}, {"symbol": "g(E)", "meaning": "density of states per area per joule", "unit": "1/(J*m^2)", "kind": "scalar"}, {"symbol": "E", "meaning": "electron energy", "unit": "J", "kind": "coordinate"}, {"symbol": "f", "meaning": "Fermi occupation", "unit": "dimensionless", "kind": "state"}], "conditions": ["Equilibrium electronic compressibility; integral form assumes an independently specified DOS and no additional self-consistent interaction correction."], "derivation": ["An electrical voltage increment shifts electron electrochemical energy by e*dV.", "Differentiate charge density e*n with respect to that increment."], "workedExample": {"inputs": "Constant DOS g0", "steps": ["Integrating the normalized Fermi derivative gives1."], "result": "cQ=e²g0, independent of temperature in a broad constant-DOS band.", "units": "F/m^2"}, "limitingCases": ["At zero temperature cQ probes DOS at the chemical potential."], "pitfalls": ["A capacitance fitted from a circuit may also include ions, traps, geometry, kinetics and contacts."], "sourceIds": ["es-frontier-quantum"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f32"><data key="title">Ideal graphene quantum capacitance</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">approximation</data><data key="metadata">{"id": "es-f32", "topicId": "es-spec-dos", "title": "Ideal graphene quantum capacitance", "latex": "c_Q=\\frac{2e^2|\\mu|}{\\pi\\hbar^2v_F^2}", "plain": "The clean zero-temperature Dirac model predicts a chemical-potential-dependent electronic capacitance.", "variables": [{"symbol": "c_Q", "meaning": "quantum capacitance per area", "unit": "F/m^2", "kind": "scalar"}, {"symbol": "e", "meaning": "elementary charge", "unit": "C", "kind": "constant"}, {"symbol": "mu", "meaning": "chemical potential measured from Dirac point", "unit": "J", "kind": "state"}, {"symbol": "hbar", "meaning": "reduced Planck constant", "unit": "J*s", "kind": "constant"}, {"symbol": "v_F", "meaning": "Dirac velocity", "unit": "m/s", "kind": "coupling"}], "conditions": ["Ideal monolayer graphene with spin/valley degeneracy4, linear dispersion and T=0; disorder/interactions neglected."], "derivation": ["Count2D Dirac states to obtain n=sgn(mu)*mu²/(πhbar²vF²).", "Differentiate n with respect to mu and multiply by e²."], "workedExample": {"inputs": "mu=.1eV converted to joules;vF=1e6m/s", "steps": ["Substitute e,hbar and velocity."], "result": "cQ≈0.0235F/m²≈2.35μF/cm².", "units": "F/m^2"}, "limitingCases": ["At ideal T=0 neutrality the formula tends to zero."], "pitfalls": ["Finite temperature and charge puddles smooth the Dirac-point minimum; a real material need not have zero measured capacitance."], "sourceIds": ["es-frontier-quantum"], "status": "approximation", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f33"><data key="title">Geometric and electronic voltage partition</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f33", "topicId": "es-spec-series", "title": "Geometric and electronic voltage partition", "latex": "c_\\mu^{-1}=c_g^{-1}+c_Q^{-1}", "plain": "Electrochemical charging distributes voltage between the electrostatic gap and electronic compressibility.", "variables": [{"symbol": "c_mu", "meaning": "measured electrochemical capacitance per area", "unit": "F/m^2", "kind": "scalar"}, {"symbol": "c_g", "meaning": "geometric capacitance per area", "unit": "F/m^2", "kind": "coupling"}, {"symbol": "c_Q", "meaning": "electronic quantum capacitance per area", "unit": "F/m^2", "kind": "coupling"}], "conditions": ["Same incremental areal charge, equilibrium linear response and no unmodeled trap or ionic branch; all areas consistently normalized."], "derivation": ["Total electrochemical voltage is geometric voltage plus chemical-potential change/e.", "Differentiate with respect to charge per area."], "workedExample": {"inputs": "cg=.02F/m²,cQ=.02F/m²", "steps": ["Inverse slopes add."], "result": "cmu=.01", "units": "F/m^2"}, "limitingCases": ["cQ≫cg recovers the geometric limit."], "pitfalls": ["Negative compressibility can enhance capacitance, but stable total curvature and correct ensemble must still be verified."], "sourceIds": ["es-frontier-quantum"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f34"><data key="title">Kelvin-probe first-harmonic null</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f34", "topicId": "es-spec-kpfm", "title": "Kelvin-probe first-harmonic null", "latex": "F_\\omega=C\\prime(z)(V_{\\rm dc}-V_{\\rm CPD})V_{\\rm ac}\\cos\\omega t", "plain": "A force harmonic null estimates a capacitance-weighted contact potential under an instrument model.", "variables": [{"symbol": "F_omega", "meaning": "first-harmonic force", "unit": "N", "kind": "scalar"}, {"symbol": "Cprime(z)", "meaning": "capacitance gradient with separation z", "unit": "F/m", "kind": "scalar"}, {"symbol": "z", "meaning": "tip separation coordinate", "unit": "m", "kind": "coordinate"}, {"symbol": "V_dc", "meaning": "applied bias", "unit": "V", "kind": "state"}, {"symbol": "V_CPD", "meaning": "contact-potential difference with declared polarity", "unit": "V", "kind": "scalar"}, {"symbol": "V_ac", "meaning": "peak AC bias", "unit": "V", "kind": "state"}, {"symbol": "omega", "meaning": "angular modulation frequency", "unit": "rad/s", "kind": "scalar"}, {"symbol": "t", "meaning": "time", "unit": "s", "kind": "coordinate"}], "conditions": ["Expand Fz=.5Cprime(z)[Vdc−VCPD+Vac*cos(omega*t)]²; quasistatic capacitive force, fixed tip geometry and uniform effective sample potential.", "Coordinate z increases tip–sample separation. With Fz=+Cprime(z)Vgap²/2, Cprime is normally negative for attraction; an opposite coordinate flips force signs but not the null."], "derivation": ["The cross term in squared voltage supplies the omega harmonic.", "Its null gives Vdc=VCPD when additional charge forces are absent."], "workedExample": {"inputs": "Vdc=VCPD with finiteVac", "steps": ["Cross term vanishes."], "result": "First harmonic is zero even though DC and2omega forces may remain.", "units": "N"}, "limitingCases": ["If Vac=0 there is no lock-in harmonic with which to locate the null."], "pitfalls": ["Tip convolution, trapped charge, surface dipoles and feedback dynamics prevent an automatic absolute work-function interpretation.", "This first-harmonic identity is derived here from the capacitive-force model; a complete contemporary KPFM instrument review was not performed.", "The1991 paper was inspected only through metadata/deposited abstract; do not label this force identity as a checked transcription of that original article."], "sourceIds": ["es-mit-capacitance", "es-gum", "es-kpfm-original"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f35"><data key="title">Thermal charge fluctuations at fixed voltage</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">conditional-result</data><data key="metadata">{"id": "es-f35", "topicId": "es-spec-ensemble", "title": "Thermal charge fluctuations at fixed voltage", "latex": "\\langle(\\delta Q)^2\\rangle=k_BT C_{\\rm diff}", "plain": "Response and equilibrium noise are linked only within a specified stable ensemble.", "variables": [{"symbol": "deltaQ", "meaning": "charge fluctuation about its mean", "unit": "C", "kind": "state"}, {"symbol": "k_B", "meaning": "Boltzmann constant", "unit": "J/K", "kind": "constant"}, {"symbol": "T", "meaning": "temperature", "unit": "K", "kind": "state"}, {"symbol": "C_diff", "meaning": "positive differential capacitance at fixed control conditions", "unit": "F", "kind": "scalar"}], "conditions": ["Classical equilibrium, voltage-controlled conjugate ensemble, local convex free energy; low-frequency thermodynamic fluctuations not a full detector noise spectrum."], "derivation": ["Differentiate the voltage-ensemble partition function.", "The response derivative equals beta times charge variance."], "workedExample": {"inputs": "Cdiff=1pF,T=300K", "steps": ["Variance=kBT*C.", "Take its square root."], "result": "Charge standard deviation≈6.44e-17C≈402 elementary charges.", "units": "C"}, "limitingCases": ["At strictly fixed total Q that constrained charge has zero ensemble variance."], "pitfalls": ["A negative variance cannot be inferred by substituting an unstable isolated negative capacitance branch."], "sourceIds": ["es-frontier-casimir"], "status": "conditional-result", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f36"><data key="title">Electrostatic zero-frequency interaction sector</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">conditional-result</data><data key="metadata">{"id": "es-f36", "topicId": "es-spec-zeromode", "title": "Electrostatic zero-frequency interaction sector", "latex": "\\frac{\\mathcal F_0}{A}=\\frac{k_BT}{4\\pi}\\int_0^\\infty k\\,dk\\,\\ln(1-r_1r_2e^{-2ka})", "plain": "This is one classical electrostatic sector of planar fluctuation theory, not the whole retarded quantum Casimir force.", "variables": [{"symbol": "F_0", "meaning": "zero-frequency electrostatic free energy", "unit": "J", "kind": "scalar"}, {"symbol": "A", "meaning": "plate area", "unit": "m^2", "kind": "scalar"}, {"symbol": "k_B", "meaning": "Boltzmann constant", "unit": "J/K", "kind": "constant"}, {"symbol": "T", "meaning": "temperature", "unit": "K", "kind": "state"}, {"symbol": "k", "meaning": "transverse wave-number magnitude", "unit": "1/m", "kind": "coordinate"}, {"symbol": "r_1,r_2", "meaning": "static electric reflection coefficients", "unit": "dimensionless", "kind": "coupling"}, {"symbol": "a", "meaning": "surface separation", "unit": "m", "kind": "coordinate"}, {"symbol": "u", "meaning": "dimensionless substitution2ka used in the derivation", "unit": "dimensionless", "kind": "coordinate"}, {"symbol": "zeta(3)", "meaning": "Riemann zeta value sum of reciprocal positive cubes", "unit": "dimensionless", "kind": "constant"}], "conditions": ["Planar local media with static electric response, equilibrium and specified intervening medium; screening and boundary prescriptions can change the zero mode."], "derivation": ["At zero Matsubara frequency, retain only the static electric/TM sector of the declared planar model. The half-weight zero term times the2D mode measure gives kBT/(4π) times integral k*dk.", "Set u=2ka, so k*dk=u*du/(4a²). Expand log(1−exp(−u))=−sum exp(−n*u)/n.", "Termwise integration gives integral u*log(1−exp(−u))du=−sum1/n³=−zeta(3); hence one ideal electric sector yields−zeta(3)kBT/(16πa²)."], "workedExample": {"inputs": "Ideal static electric reflectors r1*r2=1", "steps": ["Expand log(1−x) and integrate each exponential term."], "result": "F0/A=−zeta(3)*kBT/(16πa²).", "units": "J/m^2"}, "limitingCases": ["If one electric reflection coefficient is zero this sector vanishes."], "pitfalls": ["Adding this term to a full Lifshitz calculation that already includes n=0 double counts it; quantum/retarded sectors are not derived here.", "Adding an ideal TE zero mode doubles this term; that is a different magnetic/material boundary prescription, not the single electrostatic sector stated here."], "sourceIds": ["es-frontier-casimir"], "status": "conditional-result", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f37"><data key="title">Weak Poisson form with explicit flux sign</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">theorem</data><data key="metadata">{"id": "es-f37", "topicId": "es-spec-fem", "title": "Weak Poisson form with explicit flux sign", "latex": "\\int_\\Omega\\epsilon\\nabla\\phi\\cdot\\nabla v\\,dV=\\int_\\Omega\\rho_fv\\,dV+\\int_{\\Gamma_N}gv\\,dA,\\quad g=\\epsilon\\partial_n\\phi", "plain": "The Neumann variable g is minus the outward displacement flux because E=−gradphi.", "variables": [{"symbol": "epsilon", "meaning": "positive scalar or tensor permittivity", "unit": "F/m", "kind": "coupling"}, {"symbol": "phi", "meaning": "potential", "unit": "V", "kind": "scalar"}, {"symbol": "v", "meaning": "test function", "unit": "dimensionless", "kind": "state"}, {"symbol": "rho_f", "meaning": "free charge density", "unit": "C/m^3", "kind": "scalar"}, {"symbol": "g", "meaning": "epsilon times outward potential derivative", "unit": "C/m^2", "kind": "scalar"}, {"symbol": "Omega", "meaning": "domain", "unit": "m^3", "kind": "coordinate"}, {"symbol": "Gamma_N", "meaning": "Neumann boundary", "unit": "m^2", "kind": "coordinate"}, {"symbol": "Gamma_D", "meaning": "Dirichlet portion where test functions vanish", "unit": "m^2", "kind": "coordinate"}], "conditions": ["Trial potential has specified Dirichlet trace; test functions vanish there; coercivity and integrable sources required.", "For the pure-Neumann problem on each connected component, integral rho_f dV + integral g dA=0. Fix the mean or a reference; incompatible data must be rejected rather than hidden by pinning one mesh node."], "derivation": ["Multiply −div(epsilon*gradphi)=rho by v.", "Integrate by parts and move the boundary derivative to the right."], "workedExample": {"inputs": "Pure Neumann domain with v=1", "steps": ["Gradient term vanishes."], "result": "Compatibility:integral(rho)dV+integral(g)dA=0.", "units": "C"}, "limitingCases": ["For homogeneous Dirichlet data the boundary integral disappears."], "pitfalls": ["Assigning g=D·n reverses the physical sign unless the weak-form convention is changed."], "sourceIds": ["es-fenics"], "status": "theorem", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f38"><data key="title">Variational Poisson functional</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">theorem</data><data key="metadata">{"id": "es-f38", "topicId": "es-spec-fem", "title": "Variational Poisson functional", "latex": "J[\\phi]=\\tfrac12\\int\\epsilon|\\nabla\\phi|^2dV-\\int\\rho_f\\phi\\,dV-\\int_{\\Gamma_N}g\\phi\\,dA", "plain": "Stationarity yields the weak PDE under fixed admissible boundary traces.", "variables": [{"symbol": "J", "meaning": "Poisson variational functional", "unit": "J", "kind": "scalar"}, {"symbol": "phi", "meaning": "trial potential", "unit": "V", "kind": "state"}, {"symbol": "epsilon", "meaning": "positive permittivity", "unit": "F/m", "kind": "coupling"}, {"symbol": "rho_f", "meaning": "given free charge density", "unit": "C/m^3", "kind": "scalar"}, {"symbol": "g", "meaning": "specified epsilon*normal potential derivative", "unit": "C/m^2", "kind": "scalar"}, {"symbol": "dV", "meaning": "volume element", "unit": "m^3", "kind": "scalar"}, {"symbol": "dA", "meaning": "boundary area element", "unit": "m^2", "kind": "scalar"}], "conditions": ["Linear coercive dielectric and fixed sources/boundary controls; gauge fixed for all-Neumann cases."], "derivation": ["Vary phi by a test function.", "Set first variation to zero; positivity gives the minimizing solution."], "workedExample": {"inputs": "Finite-element approximation phi=sum(u_i*N_i)", "steps": ["Differentiate J with respect to each coefficient."], "result": "The symmetric stiffness system K*u=f is obtained.", "units": "V"}, "limitingCases": ["Mesh refinement of a conforming space reduces the functional toward its exact minimum."], "pitfalls": ["This source-loaded PDE functional is not automatically the complete thermodynamic energy of a voltage-controlled mechanical apparatus."], "sourceIds": ["es-fenics"], "status": "theorem", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f39"><data key="title">Green boundary representation</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">conditional-result</data><data key="metadata">{"id": "es-f39", "topicId": "es-spec-bem", "title": "Green boundary representation", "latex": "\\phi(x)=\\int_\\Omega G\\rho/\\epsilon\\,dV+\\oint_{\\partial\\Omega}[G\\partial_n\\phi-\\phi\\partial_nG]dA,\\quad G=1/(4\\pi|x-y|)", "plain": "Boundary data can replace a volume discretization in homogeneous regions.", "variables": [{"symbol": "phi", "meaning": "potential", "unit": "V", "kind": "scalar"}, {"symbol": "G", "meaning": "free-space negative-Laplacian Green kernel", "unit": "1/m", "kind": "operator"}, {"symbol": "rho", "meaning": "volume charge", "unit": "C/m^3", "kind": "scalar"}, {"symbol": "epsilon", "meaning": "uniform permittivity", "unit": "F/m", "kind": "coupling"}, {"symbol": "x,y", "meaning": "observation and source points", "unit": "m", "kind": "coordinate"}, {"symbol": "n", "meaning": "outward source-boundary normal", "unit": "dimensionless", "kind": "vector"}, {"symbol": "dV", "meaning": "volume element", "unit": "m^3", "kind": "scalar"}, {"symbol": "dA", "meaning": "surface element", "unit": "m^2", "kind": "scalar"}], "conditions": ["x strictly inside a smooth bounded homogeneous region; boundary limits require jump terms; kernel solves−LaplacianG=delta."], "derivation": ["Apply Green second identity to phi and G.", "Use Poisson and the delta property of G with consistent signs."], "workedExample": {"inputs": "Harmonic constant potential V0 inside a sphere", "steps": ["Volume term vanishes; the double-layer integral reproduces the constant."], "result": "Interior phi=V0; evaluating directly on the boundary requires its jump convention.", "units": "V"}, "limitingCases": ["For a source-free region only boundary terms remain."], "pitfalls": ["Dropping the boundary jump coefficient or using a homogeneous kernel across heterogeneous bulk epsilon gives a wrong integral equation."], "sourceIds": ["es-tong-electrostatics"], "status": "conditional-result", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f40"><data key="title">Ewald screening split</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">established-model</data><data key="metadata">{"id": "es-f40", "topicId": "es-spec-ewald", "title": "Ewald screening split", "latex": "\\frac1r=\\frac{\\operatorname{erfc}(\\eta r)}r+\\frac{\\operatorname{erf}(\\eta r)}r", "plain": "An exact algebraic split organizes a long-range periodic sum; it is not by itself the complete periodic energy.", "variables": [{"symbol": "r", "meaning": "pair separation", "unit": "m", "kind": "coordinate"}, {"symbol": "eta", "meaning": "arbitrary inverse splitting length", "unit": "1/m", "kind": "coupling"}, {"symbol": "erf,erfc", "meaning": "error and complementary error functions", "unit": "dimensionless", "kind": "operator"}], "conditions": ["Identity holds for r&gt;0; full Ewald algorithms additionally require reciprocal terms, self correction, net-charge treatment and a zero-mode/boundary convention."], "derivation": ["Insert erf+erfc=1.", "Choose eta so both real and reciprocal representations converge efficiently."], "workedExample": {"inputs": "eta*r=1", "steps": ["erf(1)≈.842701;erfc(1)≈.157299."], "result": "The two terms add to1/r.", "units": "1/m"}, "limitingCases": ["Exact total results must be independent of eta after convergence."], "pitfalls": ["Slab and3D periodic boundaries are different problems; omitting the self term or neutralizing-background convention changes the result."], "sourceIds": ["es-frontier-ewald"], "status": "established-model", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f41"><data key="title">Tikhonov inverse and a kernel witness</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">conditional-result</data><data key="metadata">{"id": "es-f41", "topicId": "es-spec-regularization", "title": "Tikhonov inverse and a kernel witness", "latex": "(A^TWA+\\lambda L^TL)x_\\lambda=A^TWb", "plain": "A regularizer selects a stable estimate under a declared prior; it does not manufacture missing information.", "variables": [{"symbol": "A", "meaning": "nondimensional observation matrix", "unit": "dimensionless", "kind": "operator"}, {"symbol": "W", "meaning": "noise weight matrix after whitening", "unit": "dimensionless", "kind": "tensor"}, {"symbol": "L", "meaning": "regularization operator", "unit": "dimensionless", "kind": "operator"}, {"symbol": "lambda", "meaning": "regularization strength in declared scaled coordinates", "unit": "dimensionless", "kind": "coupling"}, {"symbol": "x_lambda", "meaning": "scaled unknown estimate", "unit": "dimensionless", "kind": "state"}, {"symbol": "b", "meaning": "scaled data", "unit": "dimensionless", "kind": "vector"}], "conditions": ["Finite linearized inverse model with consistent nondimensionalization; W positive; combined operator invertible on constrained unknowns."], "derivation": ["Minimize weighted data residual squared plus lambda times penalty squared.", "Set its derivative to zero to obtain normal equations."], "workedExample": {"inputs": "A=[1,1],b=1,L=identity", "steps": ["A*(1,−1)=0 proves a one-dimensional kernel.", "Minimum-norm solution chooses equal entries."], "result": "x=(1/2,1/2) is a prior-selected representative, not unique recovery from data.", "units": "dimensionless"}, "limitingCases": ["As lambda→0 a unique well-conditioned full-rank inverse is recovered when it exists."], "pitfalls": ["A small residual, positive returned singular values of a rectangular matrix, or a plausible image does not remove an unobserved kernel."], "sourceIds": ["es-fenics"], "status": "conditional-result", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-f42"><data key="title">Covariance-aware uncertainty propagation</data><data key="kind">formula</data><data key="domain">electrostatics</data><data key="status">approximation</data><data key="metadata">{"id": "es-f42", "topicId": "es-spec-bridge", "title": "Covariance-aware uncertainty propagation", "latex": "u_c^2(y)=J\\Sigma J^T,\\qquad J_i=\\partial g/\\partial x_i", "plain": "A derived result inherits covariance as well as individual input uncertainties.", "variables": [{"symbol": "y", "meaning": "scalar measurand g(x)", "unit": "declared output SI unit", "kind": "scalar"}, {"symbol": "x_i", "meaning": "input quantities with separately stated units", "unit": "declared input SI units", "kind": "state"}, {"symbol": "J", "meaning": "local sensitivity row", "unit": "output-unit/input-unit", "kind": "operator"}, {"symbol": "Sigma", "meaning": "input covariance matrix", "unit": "input-unit products", "kind": "tensor"}, {"symbol": "u_c", "meaning": "combined standard uncertainty", "unit": "output SI unit", "kind": "scalar"}], "conditions": ["Differentiable local measurement model and small enough uncertainties for first-order propagation; coverage probabilities require additional distributional/effective-DOF assumptions."], "derivation": ["Linearize delta y≈sum(Ji*delta xi).", "Take its variance, retaining cross terms."], "workedExample": {"inputs": "C=Q/V;Q,V have equal1% relative standard uncertainty", "steps": ["For independent errors, add squared sensitivities.", "For perfectly common fractional calibration error the correlated terms cancel."], "result": "Independent relative uC≈1.414%; common multiplicative error can cancel exactly in the ratio.", "units": "F or relative dimensionless"}, "limitingCases": ["A zero sensitivity suppresses the corresponding first-order contribution, not necessarily higher-order error."], "pitfalls": ["Multiplying by k=2 is not automatically a valid95% interval, and a nonsignificant difference is not equivalence."], "sourceIds": ["es-gum"], "status": "approximation", "kind": "formula", "domain": "electrostatics"}</data></node><node id="es-tong-electrostatics"><data key="title">Electromagnetism: electrostatic fields, potential and boundary problems</data><data key="kind">source</data><data key="domain">electrostatics</data><data key="status">selected-text-read</data><data key="metadata">{"id": "es-tong-electrostatics", "title": "Electromagnetism: electrostatic fields, potential and boundary problems", "url": "https://davidtong.org/pdfs/teaching/electromagnetism/electro1.pdf", "authors": "David Tong", "year": 2015, "version": "Captured2026-11-25; source edition stated in reading record", "kind": "source", "status": "selected-text-read", "readDepth": "Selected extracted passages: Gauss/Coulomb, potential/energy, boundary uniqueness and conductors. Not every exercise or chapter read.", "sectionsRead": ["Electrostatic potential", "Electrostatic energy", "Boundary conditions and uniqueness", "Conductors"], "claim": "A conservative field plus constitutive law and boundary data defines a well-posed electrostatic problem.", "limitations": "This foundation does not validate new materials, strong-coupling electrolyte models or a real apparatus.", "passageKind": "research-note", "note": "A conservative field plus constitutive law and boundary data defines a well-posed electrostatic problem.", "capture": "docs/field-atlas/sources/electrostatics/foundations/es-tong-electrostatics.pdf", "sha256": "fee1fe4c5637501030c0e6d2a76ab86d7cd66abf85e327ecc587579cc52799e1", "retrievedAt": "2026-11-25T06:28:44.059605+00:00", "domain": "electrostatics", "recordKind": "textbook", "sourceKind": "textbook"}</data></node><node id="es-tong-matter"><data key="title">Electromagnetism in Matter</data><data key="kind">source</data><data key="domain">electrostatics</data><data key="status">selected-text-read</data><data key="metadata">{"id": "es-tong-matter", "title": "Electromagnetism in Matter", "url": "https://davidtong.org/pdfs/teaching/electromagnetism/electro6.pdf", "authors": "David Tong", "year": 2015, "version": "Captured2026-11-25; source edition stated in reading record", "kind": "source", "status": "selected-text-read", "readDepth": "Selected extracted passages on polarization, electric displacement, simple local-field response and dielectric boundary matching.", "sectionsRead": ["7.1 Electric fields in matter", "Dielectric boundary conditions", "Conductors revisited"], "claim": "Free/bound charge separation and constitutive assumptions determine how macroscopic fields are interpreted.", "limitations": "Local linear models and ideal material boundaries are explicit approximations.", "passageKind": "research-note", "note": "Free/bound charge separation and constitutive assumptions determine how macroscopic fields are interpreted.", "capture": "docs/field-atlas/sources/electrostatics/foundations/es-tong-matter.pdf", "sha256": "bd0202e04d991c3bbba624956e32f39ee9cd707753b0938531064cef62d9ef09", "retrievedAt": "2026-11-25T06:28:44.876053+00:00", "domain": "electrostatics", "recordKind": "textbook", "sourceKind": "textbook"}</data></node><node id="es-mit-gauss"><data key="title">8.02 TEAL Course Notes, Chapter4: Gauss’s Law</data><data key="kind">source</data><data key="domain">electrostatics</data><data key="status">selected-text-read</data><data key="metadata">{"id": "es-mit-gauss", "title": "8.02 TEAL Course Notes, Chapter4: Gauss’s Law", "url": "https://web.mit.edu/8.02t/www/802TEAL3D/visualizations/coursenotes/modules/guide04.pdf", "authors": "MIT Physics8.02 instructional team", "year": null, "version": "Captured2026-11-25; source edition stated in reading record", "kind": "source", "status": "selected-text-read", "readDepth": "Selected chapter sections on flux, planar/spherical examples and conductor boundaries.", "sectionsRead": ["4.1 Electric flux", "4.2 Gauss law", "4.3 Conductors"], "claim": "Flux determines enclosed charge; symmetry is an extra premise when obtaining a local field.", "limitations": "Ideal geometries do not provide calibration of finite electrodes.", "passageKind": "research-note", "note": "Flux determines enclosed charge; symmetry is an extra premise when obtaining a local field.", "capture": "docs/field-atlas/sources/electrostatics/foundations/es-mit-gauss.pdf", "sha256": "46399a38fc3afe0fb21dee2e1708094579b16dfcaa2260bd1e3794083302b0e4", "retrievedAt": "2026-11-25T06:24:15.854106+00:00", "domain": "electrostatics", "recordKind": "textbook", "sourceKind": "textbook"}</data></node><node id="es-mit-capacitance"><data key="title">8.02 TEAL Course Notes, Chapter5: Capacitance and Dielectrics</data><data key="kind">source</data><data key="domain">electrostatics</data><data key="status">selected-text-read</data><data key="metadata">{"id": "es-mit-capacitance", "title": "8.02 TEAL Course Notes, Chapter5: Capacitance and Dielectrics", "url": "https://web.mit.edu/8.02t/www/802TEAL3D/visualizations/coursenotes/modules/guide05.pdf", "authors": "MIT Physics8.02 instructional team", "year": null, "version": "Captured2026-11-25; source edition stated in reading record", "kind": "source", "status": "selected-text-read", "readDepth": "Selected parallel/cylindrical/spherical capacitance, energy and dielectric discussion.", "sectionsRead": ["5.2 Calculation of capacitance", "5.4 Energy stored", "Dielectrics"], "claim": "Capacitance follows from geometry and voltage difference; dielectric response and source work matter.", "limitations": "The chapter is foundational, not a source for current negative-capacitance device performance.", "passageKind": "research-note", "note": "Capacitance follows from geometry and voltage difference; dielectric response and source work matter.", "capture": "docs/field-atlas/sources/electrostatics/foundations/es-mit-potential.pdf", "sha256": "90376155722c0c41bb81428de7363bd110802a1e4d08fb169669849a7559d9e1", "retrievedAt": "2026-11-25T06:24:15.853620+00:00", "domain": "electrostatics", "recordKind": "textbook", "sourceKind": "textbook"}</data></node><node id="es-nist-epsilon"><data key="title">2022 CODATA recommended vacuum electric permittivity</data><data key="kind">source</data><data key="domain">electrostatics</data><data key="status">selected-text-read</data><data key="metadata">{"id": "es-nist-epsilon", "title": "2022 CODATA recommended vacuum electric permittivity", "url": "https://physics.nist.gov/cgi-bin/cuu/Value?ep0", "authors": "NIST / CODATA", "year": 2022, "version": "Captured2026-11-25; source edition stated in reading record", "kind": "source", "status": "selected-text-read", "readDepth": "Entire small value/uncertainty record read.", "sectionsRead": ["Numerical value", "Standard and relative uncertainty", "2022 CODATA source"], "claim": "epsilon0=8.8541878188(14)e-12F/m in the retrieved recommendation.", "limitations": "epsilon0 is no longer an exact independently fixed SI constant; rounded examples are illustrative.", "passageKind": "research-note", "note": "epsilon0=8.8541878188(14)e-12F/m in the retrieved recommendation.", "capture": "docs/field-atlas/sources/electrostatics/foundations/es-nist-epsilon.html", "sha256": "f62a8e03ce393ef6130b6d2b7d3160158d9c1b79cf581ff13dbc92f290949f27", "retrievedAt": "2026-11-25T06:24:15.854534+00:00", "domain": "electrostatics", "recordKind": "official-data", "sourceKind": "official-data"}</data></node><node id="es-fenics"><data key="title">The FEniCSx tutorial: Fundamentals and the Poisson equation</data><data key="kind">source</data><data key="domain">electrostatics</data><data key="status">selected-text-read</data><data key="metadata">{"id": "es-fenics", "title": "The FEniCSx tutorial: Fundamentals and the Poisson equation", "url": "https://jsdokken.com/dolfinx-tutorial/stable/chapter1/fundamentals.html", "authors": "Jørgen S. Dokken", "year": null, "version": "Captured2026-11-25; source edition stated in reading record", "kind": "source", "status": "selected-text-read", "readDepth": "Selected problem formulation, variational form and finite-element boundary implementation.", "sectionsRead": ["Poisson problem", "Variational formulation", "Boundary conditions"], "claim": "Weak forms and boundary constraints can be implemented as a symmetric elliptic system under coercive assumptions.", "limitations": "A converged discretization is not proof that a chosen material or physical boundary model is correct.", "passageKind": "research-note", "note": "Weak forms and boundary constraints can be implemented as a symmetric elliptic system under coercive assumptions.", "capture": "docs/field-atlas/sources/electrostatics/foundations/es-fenics-stable.html", "sha256": "c5ab81df7f4630fa3e84c1d1ced153e0ff5e70ba1b990eb56b87109a023a339d", "retrievedAt": "2026-11-25T06:26:26.141779+00:00", "domain": "electrostatics", "recordKind": "textbook", "sourceKind": "textbook"}</data></node><node id="es-gum"><data key="title">JCGM100:2008 Guide to the expression of uncertainty in measurement</data><data key="kind">source</data><data key="domain">electrostatics</data><data key="status">selected-text-read</data><data key="metadata">{"id": "es-gum", "title": "JCGM100:2008 Guide to the expression of uncertainty in measurement", "url": "https://www.bipm.org/documents/20126/2071204/JCGM_100_2008_E.pdf", "authors": "JCGM / BIPM", "year": 2008, "version": "Captured2026-11-25; source edition stated in reading record", "kind": "source", "status": "selected-text-read", "readDepth": "Selected covariance and coverage discussion; no claim to have read the entire guide.", "sectionsRead": ["5.2 Correlated input quantities", "6 Expanded uncertainty"], "claim": "Significant covariance cannot be omitted; coverage factors need assumptions.", "limitations": "No uncertainty budget for an actual electrostatic measurement was experimentally assessed.", "passageKind": "research-note", "note": "Significant covariance cannot be omitted; coverage factors need assumptions.", "capture": "docs/field-atlas/sources/electrostatics/foundations/es-gum.pdf", "sha256": "41bbf068fbc0d7986c98691b2d1af6680cb3044f6a1a89b3560933ed9ef9626c", "retrievedAt": "2026-11-25T06:24:15.856251+00:00", "domain": "electrostatics", "recordKind": "official-data", "sourceKind": "official-data"}</data></node><node id="es-frontier-ferro"><data key="title">The cylindrical devices with tunable positive, infinite, and negative capacitance for dynamic random access memory.</data><data key="kind">source</data><data key="domain">electrostatics</data><data key="status">selected-text-read</data><data key="metadata">{"id": "es-frontier-ferro", "title": "The cylindrical devices with tunable positive, infinite, and negative capacitance for dynamic random access memory.", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC13254098/", "doi": "10.1038/s41467-026-71823-z", "authors": "Park HW, Koo WT, Suh DI, Seo J, Sriboriboon P, Kim Y, Byun S, Kim Y, Kim JY, Ryu SW, Jeon H, Im KV, Lee G, Youn T, Lee S, Yi J, Cha SY, Hwang CS.", "year": 2026, "version": "2026-04-14 published article; PMC HTML capture", "kind": "source", "status": "selected-text-read", "readDepth": "Abstract/introduction plus complete inspected curvature-driven Results subsection, Fig2 caption and opening Methods structural-characterization subsection; supplements and complete electrical-extraction methods not read.", "sectionsRead": ["Abstract", "Introduction", "Results:Curvature-driven enhancement of NC in cylindrical FE/DE stack", "Fig2 caption", "Methods:sample/structural-characterization opening subsection"], "claim": "Cylindrical ferroelectric/dielectric stacks exhibit geometry-,domain- and charge-compensation-dependent capacitance states in the authors’ experiments and phase-field model.", "limitations": "Specific HfZrO/Al2O3 stacks; this is not a universal homogeneous Landau branch or proof that all negative slopes are stable equilibrium. The examined model predicts the opposite curvature trend when the FE/DE ordering is inverted; this geometry-specific counterexample prevents a universal curvature-enhances-NC claim.", "passageKind": "research-note", "note": "Cylindrical ferroelectric/dielectric stacks exhibit geometry-,domain- and charge-compensation-dependent capacitance states in the authors’ experiments and phase-field model.", "capture": "docs/field-atlas/sources/electrostatics/frontier/es-frontier-ferro.html", "sha256": "a916660c28e64d367f51384f4afbbeea531668f1bf3450775bd7edbd7bb353e9", "retrievedAt": "2026-11-25T06:34:13.292218+00:00", "domain": "electrostatics", "recordKind": "primary-paper", "sourceKind": "primary-paper"}</data></node><node id="es-frontier-pb"><data key="title">Benchmarking Orbital-Free Density-Potential Functional Theory of Electrified Metal-Solution Interfaces.</data><data key="kind">source</data><data key="domain">electrostatics</data><data key="status">selected-text-read</data><data key="metadata">{"id": "es-frontier-pb", "title": "Benchmarking Orbital-Free Density-Potential Functional Theory of Electrified Metal-Solution Interfaces.", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12980745/", "doi": "10.1021/acs.jctc.5c02180", "authors": "Li C, Wang X, Eikerling M, Huang J.", "year": 2026, "version": "2026-02-16 published article; PMC HTML capture", "kind": "source", "status": "selected-text-read", "readDepth": "Abstract/introduction, Results and Discussion:A Glance at the KS–PB Model/convergence discussion, and complete Conclusions text read; not every functional derivation or supporting calculation.", "sectionsRead": ["Abstract", "Introduction", "Results:A Glance at the Kohn–Sham–Poisson–Boltzmann Model", "Conclusions"], "claim": "A constant-potential Kohn–Sham–Poisson–Boltzmann benchmark compares orbital-free kinetic-energy functionals and double-layer capacitance, finding model-dependent interface accuracy.", "limitations": "A particular electronic/solution model; finite-ion extensions and exchange-correlation choices do not exhaust molecular interface effects. The benchmark is a laterally uniform1D planar metal/solution model with chosen exchange-correlation and solution approximations; Kohn–Sham kinetic treatment does not make it an exact theory of a molecular interface.", "passageKind": "research-note", "note": "A constant-potential Kohn–Sham–Poisson–Boltzmann benchmark compares orbital-free kinetic-energy functionals and double-layer capacitance, finding model-dependent interface accuracy.", "capture": "docs/field-atlas/sources/electrostatics/frontier/es-frontier-pb.html", "sha256": "62bc5af49eed66424354b17a7a4afc80d1160859324425592c252e7abc263c41", "retrievedAt": "2026-11-25T06:34:13.306904+00:00", "domain": "electrostatics", "recordKind": "primary-paper", "sourceKind": "primary-paper"}</data></node><node id="es-frontier-quantum"><data key="title">Unveiling the ternary synergistic mechanism of B-N-Al coordinated graphene for enhanced quantum capacitance &amp;lt;i&amp;gt;via&amp;lt;/i&amp;gt; first-principles calculations.</data><data key="kind">source</data><data key="domain">electrostatics</data><data key="status">selected-text-read</data><data ke